diff --git a/drivers/mfd/motorola-cpcap.c b/drivers/mfd/motorola-cpcap.c
index d8a71af9..cdedce31 100644
--- a/drivers/mfd/motorola-cpcap.c
+++ b/drivers/mfd/motorola-cpcap.c
@@ -22,6 +22,7 @@
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 #include <linux/sysfs.h>
+#include <linux/mutex.h>
 
 #include <linux/mfd/motorola-cpcap.h>
 #include <linux/spi/spi.h>
@@ -45,6 +46,11 @@ struct cpcap_ddata {
 	int pwrkey_irq;
 	unsigned int pwrkey_irq_count, pwrkey_irq_errors;
 	bool pwrkey_irq_test;
+#ifdef CONFIG_MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
+	struct mutex wake_arm_lock;
+	bool wake_arm_owned;
+	int wake_arm_error, wake_arm_cleanup_error;
+#endif
 };
 
 static int cpcap_sense_irq(struct regmap *regmap, int irq)
@@ -344,6 +350,153 @@ static void cpcap_wingray_wakeup_disable(void *data)
 	device_init_wakeup(data, false);
 }
 
+#ifdef CONFIG_MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
+/* Read-only checks: regmap-irq remains the sole owner of ON masks/ACK. */
+static int cpcap_wingray_wake_idle(struct cpcap_ddata *cpcap)
+{
+	unsigned int mask, sense, status;
+	int ret;
+
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INTM2, &mask);
+	if (ret)
+		return ret;
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INTS2, &sense);
+	if (ret)
+		return ret;
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INT2, &status);
+	if (ret)
+		return ret;
+	if (mask & CPCAP_BIT_ON_I)
+		return -EIO;
+	if ((sense & CPCAP_BIT_ON_S) || (status & CPCAP_BIT_ON_I))
+		return -EBUSY;
+	return 0;
+}
+
+/* Caller holds wake_arm_lock. Own exactly one direct parent reference.
+ * In this donor nested regmap wake propagation discards parent errors, so
+ * it cannot provide a checked result. Do not use it as a second path.
+ */
+static int cpcap_wingray_set_wake_arm(struct cpcap_ddata *cpcap, bool arm)
+{
+	struct irq_data *parent = irq_get_irq_data(cpcap->spi->irq);
+	struct irq_data *on = irq_get_irq_data(cpcap->pwrkey_irq);
+	int ret, cleanup;
+
+	cpcap->wake_arm_error = 0;
+	cpcap->wake_arm_cleanup_error = 0;
+	if (!arm) {
+		if (!cpcap->wake_arm_owned)
+			return 0;
+		ret = disable_irq_wake(cpcap->spi->irq);
+		if (!ret)
+			cpcap->wake_arm_owned = false;
+		else
+			cpcap->wake_arm_error = ret;
+		return ret;
+	}
+	if (!cpcap->pwrkey_irq_test || !device_may_wakeup(&cpcap->spi->dev) ||
+	    !parent || !parent->chip || strcmp(parent->chip->name, "LIC") ||
+	    parent->hwirq != 86 || !on || on->hwirq != CPCAP_WINGRAY_ON_IRQ) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	if (cpcap->wake_arm_owned) {
+		if (irqd_is_wakeup_set(parent))
+			return 0;
+		ret = -EIO;
+		goto fail;
+	}
+	/* Refuse a pre-existing wake owner; never try to clear its reference. */
+	if (irqd_is_wakeup_set(parent)) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	ret = cpcap_wingray_wake_idle(cpcap);
+	if (ret)
+		goto fail;
+	ret = enable_irq_wake(cpcap->spi->irq);
+	if (ret)
+		goto fail;
+	cpcap->wake_arm_owned = true;
+	ret = irqd_is_wakeup_set(parent) ? cpcap_wingray_wake_idle(cpcap) : -EIO;
+	if (!ret)
+		return 0;
+	/* Preserve ownership on failed rollback so a later disarm can retry. */
+	cleanup = disable_irq_wake(cpcap->spi->irq);
+	cpcap->wake_arm_cleanup_error = cleanup;
+	if (!cleanup)
+		cpcap->wake_arm_owned = false;
+	cpcap->wake_arm_error = ret;
+	return cleanup ? cleanup : ret;
+fail:
+	cpcap->wake_arm_error = ret;
+	return ret;
+}
+
+static ssize_t wingray_wake_arm_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct cpcap_ddata *cpcap = dev_get_drvdata(dev);
+	struct irq_data *parent = irq_get_irq_data(cpcap->spi->irq);
+	int ret;
+
+	mutex_lock(&cpcap->wake_arm_lock);
+	ret = scnprintf(buf, PAGE_SIZE,
+		"owned=%u parent_wake=%u last_error=%d cleanup_error=%d hardware_wake_validated=0 soc_suspend=blocked\n",
+		cpcap->wake_arm_owned, parent ? !!irqd_is_wakeup_set(parent) : 0,
+		cpcap->wake_arm_error, cpcap->wake_arm_cleanup_error);
+	mutex_unlock(&cpcap->wake_arm_lock);
+	return ret;
+}
+
+static ssize_t wingray_wake_arm_store(struct device *dev,
+			struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct cpcap_ddata *cpcap = dev_get_drvdata(dev);
+	bool arm;
+	int ret = kstrtobool(buf, &arm);
+
+	if (ret)
+		return ret;
+	mutex_lock(&cpcap->wake_arm_lock);
+	ret = cpcap_wingray_set_wake_arm(cpcap, arm);
+	mutex_unlock(&cpcap->wake_arm_lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static DEVICE_ATTR(wingray_wake_arm, 0600, wingray_wake_arm_show,
+		   wingray_wake_arm_store);
+
+static void cpcap_wingray_wake_arm_remove(void *data)
+{
+	struct cpcap_ddata *cpcap = data;
+	int ret;
+
+	device_remove_file(&cpcap->spi->dev, &dev_attr_wingray_wake_arm);
+	mutex_lock(&cpcap->wake_arm_lock);
+	ret = cpcap_wingray_set_wake_arm(cpcap, false);
+	mutex_unlock(&cpcap->wake_arm_lock);
+	if (ret)
+		dev_err(&cpcap->spi->dev, "Wingray wake-reference cleanup failed: %d\n", ret);
+}
+
+static int cpcap_wingray_wake_arm_init(struct cpcap_ddata *cpcap)
+{
+	int ret;
+
+	mutex_init(&cpcap->wake_arm_lock);
+	ret = device_create_file(&cpcap->spi->dev, &dev_attr_wingray_wake_arm);
+	if (ret)
+		return ret;
+	ret = devm_add_action(&cpcap->spi->dev, cpcap_wingray_wake_arm_remove, cpcap);
+	if (ret)
+		cpcap_wingray_wake_arm_remove(cpcap);
+	return ret;
+}
+#endif
+
 static int cpcap_register_irq_pwrkey(struct cpcap_ddata *cpcap)
 {
 	struct device *dev = &cpcap->spi->dev;
@@ -413,6 +566,11 @@ static int cpcap_register_irq_pwrkey(struct cpcap_ddata *cpcap)
 		device_remove_file(dev, &dev_attr_wingray_irq_status);
 		return ret;
 	}
+#ifdef CONFIG_MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
+	ret = cpcap_wingray_wake_arm_init(cpcap);
+	if (ret)
+		return ret;
+#endif
 	dev_info(dev, "Wingray ON IRQ-only registered: parent=%d virq=%d index=23; no polling, suspend disabled\n",
 		 cpcap->spi->irq, cpcap->pwrkey_irq);
 	return 0;
-- 
