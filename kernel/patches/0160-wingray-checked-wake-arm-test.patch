diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 5114c4dc..7f3f8c40 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1547,6 +1547,15 @@ config MFD_CPCAP_WINGRAY_IRQ_TEST
 	  Opt-in IRQ-driven power-key test, with no polling fallback. Requires
 	  the dedicated wakeirq DT/profile. Does not enable SoC suspend.
 
+config MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
+	bool "Wingray checked parent wake arming (awake test only)"
+	depends on MFD_CPCAP_WINGRAY_IRQ_TEST && MOTOROLA_WINGRAY_PM_PREPARE
+	default n
+	help
+	  Add a root-only manual parent IRQ wake-reference test. System sleep
+	  remains blocked by the PM preparation profile. Nothing arms at boot.
+	  Does not establish physical wake or add platform suspend parameters.
+
