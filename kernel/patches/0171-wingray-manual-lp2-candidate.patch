diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-lp2.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-lp2.dts
new file mode 100644
index 00000000..5edbea47
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-lp2.dts
@@ -0,0 +1,20 @@
+/* Isolated Motorola LP2 hardware-suspend candidate.
+ * LP2 only: core rail and DRAM stay up; no LP1/LP0 vector.
+ */
+#include "tegra20-motorola-wingray-android44-wakeirqecc.dts"
+
+/ {
+	pmc@7000e400 {
+		/* Original Motorola board used CPU 1500us/1us and core
+		 * 0x7e7e/0x0f with active-high COREREQ/SYSCLKREQ.  LP2 needs
+		 * only the CPU/complex request path, but the same verified
+		 * request polarity and timers are retained. */
+		nvidia,suspend-mode = <2>;
+		nvidia,cpu-pwr-good-time = <1500>;
+		nvidia,cpu-pwr-off-time = <1>;
+		nvidia,core-pwr-good-time = <0x7e7e 0>;
+		nvidia,core-pwr-off-time = <0x0f>;
+		nvidia,core-power-req-active-high;
+		nvidia,sys-clock-req-active-high;
+	};
+};
