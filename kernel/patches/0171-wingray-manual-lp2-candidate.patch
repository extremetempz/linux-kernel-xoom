--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -121,6 +121,19 @@ config MOTOROLA_WINGRAY_CPU1_TEST
 	  a fixed shell helper using the standard CPU hotplug sysfs interface;
 	  this option adds no alternate power-gating implementation.
 
+config MOTOROLA_WINGRAY_LP2_TEST
+	bool "Wingray manual LP2 hardware-suspend candidate"
+	depends on MACH_MOTOROLA_WINGRAY && SUSPEND
+	depends on MOTOROLA_WINGRAY_PM_PREPARE
+	depends on MOTOROLA_WINGRAY_DEVICEPM_TEST
+	depends on HOTPLUG_CPU
+	default n
+	help
+	  Replace the preparation-only sleep block with the real Tegra suspend
+	  ops for a single root-only manual LP2 request.  Android automatic
+	  suspend stays disabled and ordinary pm_suspend() remains rejected
+	  unless the manual LP2 gate is active.  LP1/LP0 are not enabled.
+
 config MOTOROLA_XOOM_GPU_STARTUP_TRACE
 	bool "Wingray retained GPU startup checkpoints (no rendering test)"
 	depends on TEGRA_GRHOST_WINGRAY_GPU_TEST && SMP && !THUMB2_KERNEL
