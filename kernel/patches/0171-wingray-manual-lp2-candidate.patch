index edbccc55..db5fbfe3 100644
--- a/arch/arm/mach-tegra/pm.c
+++ b/arch/arm/mach-tegra/pm.c
@@ -169,6 +169,7 @@ static int tegra_sleep_cpu(unsigned long v2p)
 	 * sequence.  CPU1 must already be offline and DMA must be quiescent.
 	 */
 	flush_cache_all();
+	outer_flush_all();
 	outer_disable();
 	setup_mm_for_reboot();
 	tegra_sleep_cpu_finish(v2p);
@@ -343,14 +344,14 @@ static int tegra_suspend_enter(suspend_state_t state)
 					  !tegra_sleep_core_finish))
 		return -EINVAL;
 
-	if (mode == TEGRA_SUSPEND_LP1)
-		pr_info("Entering suspend state %s\n", lp_state[mode]);
-	else
-		pr_info("Entering suspend state %s\n", lp_state[mode]);
+	pr_info("WG_LP2_PLATFORM_ENTER mode=%s online=%d\n",
+		lp_state[mode], num_online_cpus());
 
 	tegra_pm_set(mode);
 
 	local_fiq_disable();
+	cpu_pm_enter();
+	cpu_cluster_pm_enter();
 
 	suspend_cpu_complex();
 	switch (mode) {
@@ -377,11 +378,15 @@ static int tegra_suspend_enter(suspend_state_t state)
 		break;
 	}
 	restore_cpu_complex();
+	cpu_cluster_pm_exit();
+	cpu_pm_exit();
 
 	local_fiq_enable();
 
 	if (ret)
 		pr_err("Tegra suspend entry failed: %d\n", ret);
+	else
+		pr_info("WG_LP2_CPU_RESUMED\n");
 	return ret;
 }
 
@@ -390,11 +395,29 @@ static const struct platform_suspend_ops tegra_suspend_ops = {
 	.enter		= tegra_suspend_enter,
 };
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_DPM_TEST
+/* TEST_CORE must reach syscore_suspend() before stopping.  PM_SUSPEND_MEM
+ * requires a platform enter callback, but TEST_CORE checks before invoking it;
+ * this dummy is never called.  Ordinary pm_suspend() remains blocked. */
+static int wingray_test_suspend_enter(suspend_state_t state)
+{
+	return -EINVAL;
+}
+
+static const struct platform_suspend_ops wingray_test_suspend_ops = {
+	.valid = suspend_valid_only_mem,
+	.enter = wingray_test_suspend_enter,
+};
+#endif
+
 void __init tegra_init_suspend(void)
 {
 	enum tegra_suspend_mode mode = tegra_pmc_get_suspend_mode();
 
 	if (wingray_pm_prepare_only()) {
+#ifdef CONFIG_MOTOROLA_WINGRAY_DPM_TEST
+		suspend_set_ops(&wingray_test_suspend_ops);
+#endif
 		pr_info("Wingray PM preparation: system sleep entry blocked\n");
 		return;
 	}
