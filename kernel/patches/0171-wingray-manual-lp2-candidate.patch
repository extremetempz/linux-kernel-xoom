diff --git a/drivers/soc/tegra/pmc.c b/drivers/soc/tegra/pmc.c
index 6679172f..d2e5507e 100644
--- a/drivers/soc/tegra/pmc.c
+++ b/drivers/soc/tegra/pmc.c
@@ -41,6 +41,8 @@
 #include <soc/tegra/pmc.h>
 
 #define PMC_CNTRL			0x0
+#define  PMC_CNTRL_PWRREQ_POLARITY	(1 << 8)   /* core pwr req polarity */
+#define  PMC_CNTRL_PWRREQ_OE		(1 << 9)   /* core pwr req enable */
 #define  PMC_CNTRL_SYSCLK_POLARITY	(1 << 10)  /* sys clk polarity */
 #define  PMC_CNTRL_SYSCLK_OE		(1 << 11)  /* system clock enable */
 #define  PMC_CNTRL_SIDE_EFFECT_LP0	(1 << 14)  /* LP0 when CPU pwr gated */
@@ -67,6 +69,9 @@
 					 PMC_SCRATCH0_MODE_BOOTLOADER | \
 					 PMC_SCRATCH0_MODE_RCM)
 
+#define PMC_COREPWRGOOD_TIMER		0x3c
+#define PMC_COREPWROFF_TIMER		PMC_WAKE_DELAY
+#define PMC_WAKE_DELAY			0xe0
 #define PMC_CPUPWRGOOD_TIMER		0xc8
 #define PMC_CPUPWROFF_TIMER		0xcc
 
@@ -634,8 +639,9 @@ void tegra_pmc_enter_suspend_mode(enum tegra_suspend_mode mode)
 
 	value = tegra_pmc_readl(PMC_CNTRL);
 	value &= ~PMC_CNTRL_SIDE_EFFECT_LP0;
-	value |= PMC_CNTRL_CPU_PWRREQ_OE;
+	value |= PMC_CNTRL_CPU_PWRREQ_OE | PMC_CNTRL_PWRREQ_OE;
 	tegra_pmc_writel(value, PMC_CNTRL);
+	udelay(130);
 }
 #endif
 
@@ -686,20 +692,22 @@ static int tegra_pmc_parse_dt(struct tegra_pmc *pmc, struct device_node *np)
 		return 0;
 	}
 
-	/* LP2 keeps the core rail up; core timers are LP1/LP0 requirements. */
-	if (pmc->suspend_mode >= TEGRA_SUSPEND_LP1) {
-		core_ok = !of_property_read_u32_array(np,
-				"nvidia,core-pwr-good-time", values,
-				ARRAY_SIZE(values)) &&
-			  !of_property_read_u32(np, "nvidia,core-pwr-off-time",
-						&pmc->core_off_time);
-		if (!core_ok) {
-			pr_warn("Tegra PMC: LP1/LP0 disabled, core timer missing\n");
-			pmc->suspend_mode = TEGRA_SUSPEND_NONE;
-			return 0;
-		}
+	/* The original Motorola board programmed core request timers even
+	 * though its default mode was LP0.  Read them when supplied for any
+	 * mode; they are mandatory only for LP1/LP0. */
+	core_ok = !of_property_read_u32_array(np,
+			"nvidia,core-pwr-good-time", values,
+			ARRAY_SIZE(values));
+	if (of_property_read_u32(np, "nvidia,core-pwr-off-time",
+				 &pmc->core_off_time))
+		core_ok = false;
+	if (core_ok) {
 		pmc->core_osc_time = values[0];
 		pmc->core_pmu_time = values[1];
+	} else if (pmc->suspend_mode >= TEGRA_SUSPEND_LP1) {
+		pr_warn("Tegra PMC: LP1/LP0 disabled, core timer missing\n");
+		pmc->suspend_mode = TEGRA_SUSPEND_NONE;
+		return 0;
 	}
 
 	if (pmc->suspend_mode == TEGRA_SUSPEND_LP0) {
@@ -730,24 +738,36 @@ static void tegra_pmc_init(struct tegra_pmc *pmc)
 {
 	u32 value;
 
-	/* Always enable CPU power request */
+	/* Always enable CPU power request; only normal polarity is supported
+	 * by the original Motorola/Tegra setup. */
 	value = tegra_pmc_readl(PMC_CNTRL);
+	value &= ~PMC_CNTRL_CPU_PWRREQ_POLARITY;
 	value |= PMC_CNTRL_CPU_PWRREQ_OE;
 	tegra_pmc_writel(value, PMC_CNTRL);
 
+	/* Core request polarity is configured while the output is disabled,
+	 * then the output and SYSCLK request are enabled.  The core timers are
+	 * programmed even for LP2 when DT supplies them, matching the original
+	 * Motorola initialization sequence. */
 	value = tegra_pmc_readl(PMC_CNTRL);
-
+	if (pmc->corereq_high)
+		value &= ~PMC_CNTRL_PWRREQ_POLARITY;
+	else
+		value |= PMC_CNTRL_PWRREQ_POLARITY;
 	if (pmc->sysclkreq_high)
 		value &= ~PMC_CNTRL_SYSCLK_POLARITY;
 	else
 		value |= PMC_CNTRL_SYSCLK_POLARITY;
-
-	/* configure the output polarity while the request is tristated */
 	tegra_pmc_writel(value, PMC_CNTRL);
 
-	/* now enable the request */
+	if (pmc->core_osc_time) {
+		tegra_pmc_writel(pmc->core_osc_time, PMC_COREPWRGOOD_TIMER);
+		tegra_pmc_writel(pmc->core_off_time, PMC_COREPWROFF_TIMER);
+	}
+	udelay(130);
+
 	value = tegra_pmc_readl(PMC_CNTRL);
-	value |= PMC_CNTRL_SYSCLK_OE;
+	value |= PMC_CNTRL_PWRREQ_OE | PMC_CNTRL_SYSCLK_OE;
 	tegra_pmc_writel(value, PMC_CNTRL);
 }
 
