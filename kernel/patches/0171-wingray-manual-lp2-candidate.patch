+
+static ssize_t wingray_lp2_store(struct kobject *kobj,
+				 struct kobj_attribute *attr,
+				 const char *buf, size_t count)
+{
+	int ret;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (tegra_pmc_get_suspend_mode() != TEGRA_SUSPEND_LP2)
+		return -EOPNOTSUPP;
+#ifdef CONFIG_PM_DEBUG
+	if (pm_test_level != TEST_NONE)
+		return -EINVAL;
+#endif
+	if (!mutex_trylock(&wingray_lp2_lock))
+		return -EBUSY;
+	if (wingray_pm_lp2_test_active()) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	wingray_pm_lp2_test_set_active(true);
+	ret = pm_suspend(PM_SUSPEND_MEM);
+	wingray_pm_lp2_test_set_active(false);
+	wingray_lp2_result = ret;
+	if (!ret)
+		wingray_lp2_count++;
+unlock:
+	mutex_unlock(&wingray_lp2_lock);
+	return ret ? ret : count;
+}
