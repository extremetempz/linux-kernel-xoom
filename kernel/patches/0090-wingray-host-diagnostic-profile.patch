diff --git a/drivers/staging/tegra/video/host/host1x/host1x.c b/drivers/staging/tegra/video/host/host1x/host1x.c
index 0af1728d..df0291c8 100644
--- a/drivers/staging/tegra/video/host/host1x/host1x.c
+++ b/drivers/staging/tegra/video/host/host1x/host1x.c
@@ -24,6 +24,7 @@
 #include <linux/uaccess.h>
 #include <linux/file.h>
 #include <linux/clk.h>
+#include <linux/reset.h>
 
 #include "dev.h"
 #include "bus.h"
@@ -516,6 +517,18 @@ static int nvhost_probe(struct nvhost_device *dev,
 	if (err)
 		goto fail;
 	clocks_on = true;
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST
+	/* Deassert only host reset, with its clock enabled; no reset pulse. */
+	dev->rst = devm_reset_control_get(&dev->dev, "host1x");
+	if (IS_ERR(dev->rst)) {
+		err = PTR_ERR(dev->rst);
+		dev->rst = NULL;
+		goto fail;
+	}
+	err = reset_control_deassert(dev->rst);
+	if (err)
+		goto fail;
+#endif
 	err = nvhost_syncpt_init(dev, &host->syncpt);
 	if (err)
 		goto fail;
diff --git a/drivers/staging/tegra/video/host/nvhost_acm.c b/drivers/staging/tegra/video/host/nvhost_acm.c
index 2cc00de1..ad351189 100644
--- a/drivers/staging/tegra/video/host/nvhost_acm.c
+++ b/drivers/staging/tegra/video/host/nvhost_acm.c
@@ -620,13 +620,26 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 		dev->clk[i] = c;
 		dev->num_clks++;
 		previous[i] = clk_get_rate(c);
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST
+		/* Diagnostic is host-only: retain the firmware clock/voltage point. */
+		if (dev->index != 10 || i != 0 || strcmp(dev->clocks[i].name, "host1x")) {
+			err = -EINVAL;
+			goto fail;
+		}
+		rates[i] = previous[i];
+#else
 		rates[i] = clk_round_rate(c, dev->clocks[i].default_rate);
+#endif
 		if (rates[i] <= 0 || !previous[i]) {
 			err = rates[i] < 0 ? (int)rates[i] : -EINVAL;
 			goto fail;
 		}
 	}
 	for (i = 0; i < dev->num_clks; i++) {
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST
+		/* Runtime activation tests the enable path, never changes its rate. */
+		continue;
+#endif
 		err = clk_prepare_enable(dev->clk[i]);
 		if (err)
 			goto fail;
diff --git a/drivers/staging/tegra/video/host/wingray_host_test.c b/drivers/staging/tegra/video/host/wingray_host_test.c
new file mode 100644
index 00000000..784fe507
--- /dev/null
+++ b/drivers/staging/tegra/video/host/wingray_host_test.c
@@ -0,0 +1,55 @@
+/* GPL-2.0: fixed host-only exercise. No command buffers or engine accesses. */
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/clk.h>
+#include <linux/nvhost.h>
+#include "dev.h"
+#include "nvhost_acm.h"
+
+static int __init wingray_host_test_init(void)
+{
+	struct nvhost_device *dev;
+	unsigned long rate;
+	int cycle, err;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return -ENODEV;
+	if (!nvhost) {
+		pr_err("XOOM_HOST_TEST_FAIL host_missing\n");
+		return -ENODEV;
+	}
+	dev = nvhost->dev;
+	if (dev->dev.parent || dev->num_clks != 1 || dev->is_emc_client) {
+		pr_err("XOOM_HOST_TEST_FAIL unexpected_resources\n");
+		return -EINVAL;
+	}
+	rate = clk_get_rate(dev->clk[0]);
+	if (!rate)
+		return -EINVAL;
+	pr_info("XOOM_HOST_TEST_BEGIN rate=%lu\n", rate);
+	for (cycle = 0; cycle < 3; cycle++) {
+		err = nvhost_module_busy_checked(dev);
+		if (err)
+			goto fail;
+		if (clk_get_rate(dev->clk[0]) != rate || !nvhost->intr.started) {
+			nvhost_module_idle(dev);
+			err = -EIO;
+			goto fail;
+		}
+		nvhost_module_idle(dev);
+		err = nvhost_module_suspend(dev);
+		if (err)
+			goto fail;
+		if (dev->refcount || nvhost->intr.started) {
+			err = -EIO;
+			goto fail;
+		}
+		pr_info("XOOM_HOST_TEST_CYCLE %d PASS\n", cycle);
+	}
+	pr_info("XOOM_HOST_TEST_PASS cycles=3 rate=%lu\n", rate);
+	return 0;
+fail:
+	pr_err("XOOM_HOST_TEST_FAIL cycle=%d error=%d\n", cycle, err);
+	return err;
+}
+late_initcall(wingray_host_test_init);
-- 
