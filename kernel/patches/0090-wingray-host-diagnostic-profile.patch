index 0ace2cf4..204a01ff 100644
--- a/drivers/staging/tegra/clk.c
+++ b/drivers/staging/tegra/clk.c
@@ -181,7 +181,8 @@ static int register_shared_emc_clks(void)
 {
 	/* The carveout-only Wingray experiment must not replace even the USB
