diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-host-test.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-host-test.dts
new file mode 100644
index 00000000..7496862a
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-host-test.dts
@@ -0,0 +1,10 @@
+/* Host clock/IRQ diagnostic only; preserve the tested resource-only wiring. */
+#include "tegra20-motorola-wingray-legacy-resources.dts"
+/ {
+	model = "Motorola Xoom P3 host-only diagnostic";
+	host1x@50000000 {
+		compatible = "nvidia,tegra20-host1x", "nvhost-bus";
+		clock-names = "host1x";
+		status = "okay";
+	};
+};
