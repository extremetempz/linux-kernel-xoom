From 0bfb8acafedb810a4da0134c6c7be2026d36326f Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Tue, 3 Nov 2026 14:00:25 +1100
Subject: [PATCH] Wingray: isolate original WDI poweroff without restart or
 CPCAP register changes

---
 ...-wingray-android44-persistent-shutdown.dts |  12 +
 ...ay_android44_persistent_shutdown_defconfig | 252 ++++++++++++++++++
 drivers/power/reset/wingray-power.c           |  30 ++-
 3 files changed, 285 insertions(+), 9 deletions(-)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-shutdown.dts
 create mode 100644 arch/arm/configs/wingray_android44_persistent_shutdown_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-shutdown.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-shutdown.dts
new file mode 100644
index 00000000..7c9df053
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-shutdown.dts
@@ -0,0 +1,12 @@
+/* GPL-2.0: opt-in original Motorola WDI/UC reset lines after clean shutdown. */
+#include "tegra20-motorola-wingray-android44-persistent.dts"
+/ {
+ model = "Motorola Xoom P3 persistent data clean shutdown candidate";
+};
+&cpcap {
+ power-controller {
+  compatible = "motorola,wingray-power";
+  motorola,poweroff-only;
+  poweroff-gpios = <&gpio TEGRA_GPIO(V, 7) GPIO_ACTIVE_LOW>;
+ };
+};
diff --git a/arch/arm/configs/wingray_android44_persistent_shutdown_defconfig b/arch/arm/configs/wingray_android44_persistent_shutdown_defconfig
new file mode 100644
index 00000000..19172d1b
--- /dev/null
+++ b/arch/arm/configs/wingray_android44_persistent_shutdown_defconfig
@@ -0,0 +1,252 @@
