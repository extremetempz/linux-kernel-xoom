+CONFIG_MACH_MOTOROLA_WINGRAY=y
+# CONFIG_MACH_SAMSUNG_VARIATION_TEGRA is not set
+# CONFIG_MACH_SAMSUNG_P4WIFI is not set
+CONFIG_SMP=y
+CONFIG_SMP_ON_UP=y
+CONFIG_NR_CPUS=2
+CONFIG_HOTPLUG_CPU=y
+CONFIG_CACHE_L2X0=y
+CONFIG_HIGHMEM=y
+CONFIG_AEABI=y
+CONFIG_SWP_EMULATE=y
+CONFIG_VFP=y
+# CONFIG_NEON is not set
+# CONFIG_CPU_FREQ is not set
+# CONFIG_CPU_IDLE is not set
+CONFIG_SUSPEND=y
+CONFIG_ARM_APPENDED_DTB=y
+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE_NAMES="tegra20-motorola-wingray-android44-wakeirqecc"
+CONFIG_CMDLINE="console=ttyS0,115200n8 ignore_loglevel loglevel=8 initcall_debug clk_ignore_unused regulator_ignore_unused ro panic=0 maxcpus=2"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_PROC_FS=y
+CONFIG_SYSFS=y
+CONFIG_TMPFS=y
+CONFIG_BLOCK=y
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_EFI_PARTITION=y
+CONFIG_MOTOROLA_XOOM_BIGPART=y
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_BLOCK_MINORS=32
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SDHCI_TEGRA=y
+CONFIG_EXT4_FS=y
+CONFIG_USB=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_CHIPIDEA=y
+CONFIG_USB_CHIPIDEA_UDC=y
+CONFIG_USB_TEGRA_PHY=y
+CONFIG_USB_G_SERIAL=y
+CONFIG_NET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_IPV6=y
+CONFIG_WIRELESS=y
+# Only the factory-preserving P3 maXTouch input path is added.
+CONFIG_INPUT=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_INPUT_TOUCHSCREEN=y
+CONFIG_TOUCHSCREEN_ATMEL_MXT=y
+# CONFIG_TOUCHSCREEN_MXT1386 is not set
+# CONFIG_SAMSUNG_INPUT is not set
+# CONFIG_INPUT_LEDS is not set
+# CONFIG_INPUT_MOUSEDEV is not set
+# CONFIG_INPUT_JOYDEV is not set
+CONFIG_INPUT_KEYBOARD=y
+CONFIG_KEYBOARD_GPIO=y
+# CONFIG_INPUT_MOUSE is not set
+# CONFIG_INPUT_JOYSTICK is not set
+# CONFIG_INPUT_TABLET is not set
+# CONFIG_INPUT_MISC is not set
+# CONFIG_SERIO is not set
+# CONFIG_GAMEPORT is not set
+# CONFIG_HID is not set
+# CONFIG_USB_HID is not set
+# CONFIG_VT is not set
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_8250_NR_UARTS=5
+CONFIG_SERIAL_8250_RUNTIME_UARTS=5
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_FS=y
+# CONFIG_DEBUG_LL is not set
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_I2C=y
+CONFIG_I2C_TEGRA=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_BACKLIGHT_LP855X=y
+
+# CONFIG_DRM is not set
+# CONFIG_DRM_TEGRA is not set
+# CONFIG_DRM_TEGRA_FBDEV is not set
+# CONFIG_DRM_PANEL_SIMPLE is not set
+CONFIG_BACKLIGHT_LCD_SUPPORT=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_PWM=y
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=16
+
+# Installed Android 4.4 userspace ABI; separate from the future Oreo ABI.
+CONFIG_ANDROID=y
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDER_DEVICES="binder"
+CONFIG_ANDROID_BINDER_IPC_32BIT=y
+CONFIG_STAGING=y
+CONFIG_ASHMEM=y
+CONFIG_ANDROID_LOGGER=y
+# CONFIG_ANDROID_TIMED_OUTPUT is not set
+CONFIG_ANDROID_LOW_MEMORY_KILLER=y
+CONFIG_SYNC=y
+# CONFIG_SW_SYNC is not set
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_FUSE_FS=y
+CONFIG_INOTIFY_USER=y
+# CONFIG_MOTOROLA_XOOM_BOOT_TRACE is not set
+
+# Isolated Decatf nvmap backing-ownership experiment; no engine or DC access.
+CONFIG_MEMORY=y
+# CONFIG_TEGRA20_MC is not set
+# CONFIG_TEGRA_HOST1X is not set
+# CONFIG_IOMMU_SUPPORT is not set
+# CONFIG_IOMMU_API is not set
+# CONFIG_TEGRA_IOMMU_GART is not set
+CONFIG_TEGRA_DOWNSTREAM=y
+CONFIG_TEGRA_NVMAP=y
+# CONFIG_TEGRA_NVMAP_WINGRAY_RESOURCES is not set
+# CONFIG_TEGRA_RPC is not set
+# CONFIG_TEGRA_AVP is not set
+# CONFIG_TEGRA_AVP_KERNEL_ON_MMU is not set
+# CONFIG_TEGRA_MEDIASERVER is not set
+# CONFIG_TEGRA_IOVMM_GART is not set
+# CONFIG_TEGRA_IOVMM is not set
+CONFIG_TEGRA_GRHOST=y
+# CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST is not set
+CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST=y
+CONFIG_TEGRA_GRHOST_WINGRAY_LEGACY_SUBMIT=y
+CONFIG_TEGRA_SEMA_STANDALONE=y
+CONFIG_FB=y
+CONFIG_TEGRA_DC=y
+CONFIG_FB_TEGRA=y
+# CONFIG_TEGRA_DC_EXTENSIONS is not set
+# CONFIG_TEGRA_OVERLAY is not set
+CONFIG_FB_TEGRA_WINGRAY_LEGACY=y
+# CONFIG_FB_TEGRA_CMC623 is not set
+# CONFIG_NVMAP_ALLOW_SYSMEM is not set
+# CONFIG_NVMAP_RECLAIM_UNPINNED_VM is not set
+# CONFIG_NVMAP_HIGHMEM_ONLY is not set
+# CONFIG_NVMAP_CONVERT_CARVEOUT_TO_IOVMM is not set
+# CONFIG_NVMAP_CARVEOUT_KILLER is not set
+# CONFIG_NVMAP_CARVEOUT_COMPACTOR is not set
+# CONFIG_NVMAP_PAGE_POOLS is not set
+
+# Reserved-RAM startup localization only; no userspace GPU submission.
+CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE=0x584d0060
+
+# Bypass the externally loaded large initrd; RAM runtime stays private.
+CONFIG_INITRAMFS_SOURCE="usr/wingray-android-runtime.cpio"
+
+# Motorola CPCAP PMIC transport and IRQ core; power key only.
+CONFIG_SPI=y
+CONFIG_SPI_TEGRA20_SLINK=y
+CONFIG_DMADEVICES=y
+CONFIG_TEGRA20_APB_DMA=y
+CONFIG_MFD_CPCAP=y
+
+# BCM4329 Wi-Fi bring-up: SDIO fullmac plus legacy WEXT for Android.
+CONFIG_NETDEVICES=y
+CONFIG_WLAN=y
+CONFIG_CFG80211=y
+CONFIG_CFG80211_WEXT=y
+CONFIG_RFKILL=y
+
+
+
+# Xoom bcmdhd 4329 module, loaded after /system is available.
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+
+# Native 4.4 bcmdhd, loaded after /system is available.
+CONFIG_BROADCOM_WIFI=y
+CONFIG_BCMDHD_FW_PATH="/system/vendor/firmware/fw_bcmdhd.bin"
+CONFIG_BCMDHD_NVRAM_PATH="/system/etc/wifi/bcm4329.cal"
+
+# Android Bluedroid owns HCI over ttyHS2, not Linux HCI line discipline.
+CONFIG_SERIAL_TEGRA=y
+CONFIG_RFKILL_WINGRAY_BT=y
+# CONFIG_BT is not set
+
+# Opt-in P3 input-only battery monitor; preserve all fixed-clock controls.
+CONFIG_POWER_SUPPLY=y
+CONFIG_W1=y
+CONFIG_W1_MASTER_TEGRA_WINGRAY=y
+CONFIG_W1_SLAVE_DS2781=y
+# CONFIG_W1_CON is not set
+# CONFIG_BATTERY_DS2781 is not set
+CONFIG_BATTERY_WINGRAY_MONITOR=y
+
+CONFIG_FB_TEGRA_WINGRAY_DISPLAY_PM=y
+CONFIG_PM=y
+
+
+CONFIG_MFD_CPCAP_WINGRAY_IRQ_TEST=y
+
+# PM compilation/inspection only. All system sleep entry is blocked.
+CONFIG_MOTOROLA_WINGRAY_PM_PREPARE=y
+CONFIG_PM_DEBUG=y
+CONFIG_PM_ADVANCED_DEBUG=y
+# CONFIG_PM_AUTOSLEEP is not set
+# CONFIG_PM_WAKELOCKS is not set
+# CONFIG_PM_TEST_SUSPEND is not set
+# CONFIG_HIBERNATION is not set
+# CONFIG_DPM_WATCHDOG is not set
+# CONFIG_CPU_IDLE is not set
diff --git a/arch/arm/mach-tegra/Kconfig b/arch/arm/mach-tegra/Kconfig
index 69e1220a..6d259ea9 100644
--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -70,6 +70,17 @@ config MACH_MOTOROLA_WINGRAY
 	  Experimental device-tree support for the Wi-Fi Xoom. Power,
 	  display and suspend support still require hardware validation.
 
+config MOTOROLA_WINGRAY_PM_PREPARE
+	bool "Wingray PM framework preparation (sleep entry blocked)"
+	depends on MACH_MOTOROLA_WINGRAY && SUSPEND
+	default n
+	help
+	  Compile PM, CPU hotplug and driver sleep callbacks for bring-up.
+	  On Wingray, reject all system sleep requests before freezing tasks
+	  or suspending devices, and do not register Tegra suspend ops.
+	  This is a build/inspection profile, not suspend or deep sleep.
+	  No command-line or sysfs switch can release this build-time block.
+
 config MOTOROLA_XOOM_GPU_STARTUP_TRACE
 	bool "Wingray retained GPU startup checkpoints (no rendering test)"
 	depends on TEGRA_GRHOST_WINGRAY_GPU_TEST && SMP && !THUMB2_KERNEL
diff --git a/arch/arm/mach-tegra/pm.c b/arch/arm/mach-tegra/pm.c
index b0f48a39..682f33bf 100644
--- a/arch/arm/mach-tegra/pm.c
+++ b/arch/arm/mach-tegra/pm.c
@@ -26,6 +26,7 @@
 #include <linux/slab.h>
 #include <linux/spinlock.h>
 #include <linux/suspend.h>
+#include <linux/wingray_pm_prepare.h>
 
 #include <soc/tegra/fuse.h>
 #include <soc/tegra/pm.h>
@@ -368,6 +369,11 @@ void __init tegra_init_suspend(void)
 {
 	enum tegra_suspend_mode mode = tegra_pmc_get_suspend_mode();
 
+	if (wingray_pm_prepare_only()) {
+		pr_info("Wingray PM preparation: system sleep entry blocked\n");
+		return;
+	}
+
 	if (mode == TEGRA_SUSPEND_NONE)
 		return;
 
diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 751ce205..5114c4dc 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1540,7 +1540,8 @@ endif
 
 config MFD_CPCAP_WINGRAY_IRQ_TEST
 	bool "Wingray CPCAP ON interrupt ownership test"
-	depends on MACH_MOTOROLA_WINGRAY && MFD_CPCAP=y && !SUSPEND
+	depends on MACH_MOTOROLA_WINGRAY && MFD_CPCAP=y
+	depends on !SUSPEND || MOTOROLA_WINGRAY_PM_PREPARE
 	default n
 	help
 	  Opt-in IRQ-driven power-key test, with no polling fallback. Requires
diff --git a/include/linux/wingray_pm_prepare.h b/include/linux/wingray_pm_prepare.h
new file mode 100644
index 00000000..9b4dbafb
--- /dev/null
+++ b/include/linux/wingray_pm_prepare.h
@@ -0,0 +1,11 @@
+/* Wingray PM compilation profile: no system sleep entry. */
+#ifndef _LINUX_WINGRAY_PM_PREPARE_H
+#define _LINUX_WINGRAY_PM_PREPARE_H
+#include <linux/kconfig.h>
+#include <linux/of.h>
+static inline bool wingray_pm_prepare_only(void)
+{
+	return IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_PM_PREPARE) &&
+		of_machine_is_compatible("motorola,wingray");
+}
+#endif
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index 58209d8b..b1d20c42 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -32,6 +32,8 @@
 #include <linux/moduleparam.h>
 #include <linux/wakeup_reason.h>
 
+#include <linux/wingray_pm_prepare.h>
+
 #include "power.h"
 
 const char *pm_labels[] = { "mem", "standby", "freeze", NULL };
@@ -423,6 +425,9 @@ int suspend_devices_and_enter(suspend_state_t state)
 	int error;
 	bool wakeup = false;
 
+	if (wingray_pm_prepare_only())
+		return -EOPNOTSUPP;
+
 	if (!sleep_state_supported(state))
 		return -ENOSYS;
 
@@ -563,6 +568,10 @@ int pm_suspend(suspend_state_t state)
 	if (state <= PM_SUSPEND_ON || state >= PM_SUSPEND_MAX)
 		return -EINVAL;
 
+	/* Refuse even freeze/pm_test before tasks, devices or CPUs change. */
+	if (wingray_pm_prepare_only())
+		return -EOPNOTSUPP;
+
 	pm_suspend_marker("entry");
 	error = enter_state(state);
 	if (error) {
-- 
2.43.0

