From 344ec9af6360071ccdbaaddf0044c7859923b812 Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Wed, 28 Oct 2026 18:39:30 +1100
Subject: [PATCH] ARM: Wingray compile PM framework with system sleep entry
 blocked

---
 .../wingray_android44_pmprep_defconfig        | 236 ++++++++++++++++++
 arch/arm/mach-tegra/Kconfig                   |  11 +
 arch/arm/mach-tegra/pm.c                      |   6 +
 drivers/mfd/Kconfig                           |   3 +-
 include/linux/wingray_pm_prepare.h            |  11 +
 kernel/power/suspend.c                        |   9 +
 6 files changed, 275 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/configs/wingray_android44_pmprep_defconfig
 create mode 100644 include/linux/wingray_pm_prepare.h

diff --git a/arch/arm/configs/wingray_android44_pmprep_defconfig b/arch/arm/configs/wingray_android44_pmprep_defconfig
new file mode 100644
index 00000000..292ee4cb
--- /dev/null
+++ b/arch/arm/configs/wingray_android44_pmprep_defconfig
@@ -0,0 +1,236 @@
