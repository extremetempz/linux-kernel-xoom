diff --git a/drivers/mfd/motorola-cpcap.c b/drivers/mfd/motorola-cpcap.c
index ebe3ffed..06ecc15a 100644
--- a/drivers/mfd/motorola-cpcap.c
+++ b/drivers/mfd/motorola-cpcap.c
@@ -874,12 +874,18 @@ static int cpcap_wingray_pm_suspend(struct device *dev)
 
 	if ((!wingray_pm_prepare_only() && !wingray_pm_lp2_test_active()) ||
 	    (!cpcap->pm_test_active && !wingray_pm_dpm_test_active() &&
-	     !wingray_pm_lp2_test_active()))
+	     !wingray_pm_lp2_test_active())) {
+		dev_info(dev, "WG_PM95_CPCAP_SUSPEND_REJECT reason=owner\n");
 		return -EOPNOTSUPP;
-	if (!mutex_trylock(&cpcap->wake_arm_lock))
+	}
+	if (!mutex_trylock(&cpcap->wake_arm_lock)) {
+		dev_info(dev, "WG_PM95_CPCAP_SUSPEND_REJECT reason=lock\n");
 		return -EBUSY;
+	}
 	/* Never borrow or release an awake manual test's wake reference. */
 	if (cpcap->wake_arm_owned || cpcap->pm_cycle_owned) {
+		dev_info(dev, "WG_PM95_CPCAP_SUSPEND_REJECT reason=owned wake=%u cycle=%u\n",
+			 cpcap->wake_arm_owned, cpcap->pm_cycle_owned);
 		ret = -EBUSY;
 		goto out;
 	}
diff --git a/kernel/power/main.c b/kernel/power/main.c
index ae78700b..1d8647a1 100644
--- a/kernel/power/main.c
+++ b/kernel/power/main.c
@@ -873,6 +873,7 @@ static ssize_t wingray_lp2_store(struct kobject *kobj,
 	ret = pm_suspend(PM_SUSPEND_MEM);
 	wingray_pm_lp2_test_set_active(false);
 	wingray_lp2_result = ret;
+	pr_info("WG_LP2_STORE result=%d\n", ret);
 	if (!ret)
 		wingray_lp2_count++;
 unlock:
