From a977c4731565ab0a64b0e006249fcc1fd76f88aa Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Wed, 28 Oct 2026 19:43:49 +1100
Subject: [PATCH] PM: Wingray add manual freezer-only test before device or CPU
 sleep

---
 .../wingray_android44_freezertest_defconfig   | 242 ++++++++++++++++++
 arch/arm/mach-tegra/Kconfig                   |   9 +
 include/linux/wingray_pm_prepare.h            |   3 +
 kernel/power/main.c                           |  52 ++++
 kernel/power/suspend.c                        |  37 ++-
 5 files changed, 341 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm/configs/wingray_android44_freezertest_defconfig

diff --git a/arch/arm/configs/wingray_android44_freezertest_defconfig b/arch/arm/configs/wingray_android44_freezertest_defconfig
new file mode 100644
index 00000000..9bfdf056
--- /dev/null
+++ b/arch/arm/configs/wingray_android44_freezertest_defconfig
@@ -0,0 +1,242 @@
