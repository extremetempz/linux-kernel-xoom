+CONFIG_INPUT_KEYBOARD=y
+CONFIG_KEYBOARD_GPIO=y
+# CONFIG_INPUT_MOUSE is not set
+# CONFIG_INPUT_JOYSTICK is not set
+# CONFIG_INPUT_TABLET is not set
+# CONFIG_INPUT_MISC is not set
+# CONFIG_SERIO is not set
+# CONFIG_GAMEPORT is not set
+# CONFIG_HID is not set
+# CONFIG_USB_HID is not set
+# CONFIG_VT is not set
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_8250_NR_UARTS=5
+CONFIG_SERIAL_8250_RUNTIME_UARTS=5
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_FS=y
+# CONFIG_DEBUG_LL is not set
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_I2C=y
+CONFIG_I2C_TEGRA=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_BACKLIGHT_LP855X=y
+
+# CONFIG_DRM is not set
+# CONFIG_DRM_TEGRA is not set
+# CONFIG_DRM_TEGRA_FBDEV is not set
+# CONFIG_DRM_PANEL_SIMPLE is not set
+CONFIG_BACKLIGHT_LCD_SUPPORT=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_PWM=y
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=16
+
+# Installed Android 4.4 userspace ABI; separate from the future Oreo ABI.
+CONFIG_ANDROID=y
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDER_DEVICES="binder"
+CONFIG_ANDROID_BINDER_IPC_32BIT=y
+CONFIG_STAGING=y
+CONFIG_ASHMEM=y
+CONFIG_ANDROID_LOGGER=y
+# CONFIG_ANDROID_TIMED_OUTPUT is not set
+CONFIG_ANDROID_LOW_MEMORY_KILLER=y
+CONFIG_SYNC=y
+# CONFIG_SW_SYNC is not set
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_FUSE_FS=y
+CONFIG_INOTIFY_USER=y
+# CONFIG_MOTOROLA_XOOM_BOOT_TRACE is not set
+
+# Isolated Decatf nvmap backing-ownership experiment; no engine or DC access.
+CONFIG_MEMORY=y
+# CONFIG_TEGRA20_MC is not set
+# CONFIG_TEGRA_HOST1X is not set
+# CONFIG_IOMMU_SUPPORT is not set
+# CONFIG_IOMMU_API is not set
+# CONFIG_TEGRA_IOMMU_GART is not set
+CONFIG_TEGRA_DOWNSTREAM=y
+CONFIG_TEGRA_NVMAP=y
+# CONFIG_TEGRA_NVMAP_WINGRAY_RESOURCES is not set
+# CONFIG_TEGRA_RPC is not set
+# CONFIG_TEGRA_AVP is not set
+# CONFIG_TEGRA_AVP_KERNEL_ON_MMU is not set
+# CONFIG_TEGRA_MEDIASERVER is not set
+# CONFIG_TEGRA_IOVMM_GART is not set
+# CONFIG_TEGRA_IOVMM is not set
+CONFIG_TEGRA_GRHOST=y
+# CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST is not set
+CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST=y
+CONFIG_TEGRA_GRHOST_WINGRAY_LEGACY_SUBMIT=y
+CONFIG_TEGRA_SEMA_STANDALONE=y
+CONFIG_FB=y
+CONFIG_TEGRA_DC=y
+CONFIG_FB_TEGRA=y
+# CONFIG_TEGRA_DC_EXTENSIONS is not set
+# CONFIG_TEGRA_OVERLAY is not set
+CONFIG_FB_TEGRA_WINGRAY_LEGACY=y
+# CONFIG_FB_TEGRA_CMC623 is not set
+# CONFIG_NVMAP_ALLOW_SYSMEM is not set
+# CONFIG_NVMAP_RECLAIM_UNPINNED_VM is not set
+# CONFIG_NVMAP_HIGHMEM_ONLY is not set
+# CONFIG_NVMAP_CONVERT_CARVEOUT_TO_IOVMM is not set
+# CONFIG_NVMAP_CARVEOUT_KILLER is not set
+# CONFIG_NVMAP_CARVEOUT_COMPACTOR is not set
+# CONFIG_NVMAP_PAGE_POOLS is not set
+
+# Reserved-RAM startup localization only; no userspace GPU submission.
+CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE=0x584d0060
+
+# Bypass the externally loaded large initrd; RAM runtime stays private.
+CONFIG_INITRAMFS_SOURCE="usr/wingray-android-runtime.cpio"
+
+# Motorola CPCAP PMIC transport and IRQ core; power key only.
+CONFIG_SPI=y
+CONFIG_SPI_TEGRA20_SLINK=y
+CONFIG_DMADEVICES=y
+CONFIG_TEGRA20_APB_DMA=y
+CONFIG_MFD_CPCAP=y
+
+# BCM4329 Wi-Fi bring-up: SDIO fullmac plus legacy WEXT for Android.
+CONFIG_NETDEVICES=y
+CONFIG_WLAN=y
+CONFIG_CFG80211=y
+CONFIG_CFG80211_WEXT=y
+CONFIG_RFKILL=y
+
+
+
+# Xoom bcmdhd 4329 module, loaded after /system is available.
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+
+# Native 4.4 bcmdhd, loaded after /system is available.
+CONFIG_BROADCOM_WIFI=y
+CONFIG_BCMDHD_FW_PATH="/system/vendor/firmware/fw_bcmdhd.bin"
+CONFIG_BCMDHD_NVRAM_PATH="/system/etc/wifi/bcm4329.cal"
+
+# Android Bluedroid owns HCI over ttyHS2, not Linux HCI line discipline.
+CONFIG_SERIAL_TEGRA=y
+CONFIG_RFKILL_WINGRAY_BT=y
+# CONFIG_BT is not set
+
+# Opt-in P3 input-only battery monitor; preserve all fixed-clock controls.
+CONFIG_POWER_SUPPLY=y
+CONFIG_W1=y
+CONFIG_W1_MASTER_TEGRA_WINGRAY=y
+CONFIG_W1_SLAVE_DS2781=y
+# CONFIG_W1_CON is not set
+# CONFIG_BATTERY_DS2781 is not set
+CONFIG_BATTERY_WINGRAY_MONITOR=y
+
+CONFIG_FB_TEGRA_WINGRAY_DISPLAY_PM=y
+CONFIG_PM=y
+
+
+CONFIG_MFD_CPCAP_WINGRAY_IRQ_TEST=y
+
+# PM compilation/inspection only. All system sleep entry is blocked.
+CONFIG_MOTOROLA_WINGRAY_PM_PREPARE=y
+CONFIG_PM_DEBUG=y
+CONFIG_PM_ADVANCED_DEBUG=y
+# CONFIG_PM_AUTOSLEEP is not set
+# CONFIG_PM_WAKELOCKS is not set
+# CONFIG_PM_TEST_SUSPEND is not set
+# CONFIG_HIBERNATION is not set
+# CONFIG_DPM_WATCHDOG is not set
+# CONFIG_CPU_IDLE is not set
+
+# Manual checked parent wake-reference test; no sleep entry.
+CONFIG_MFD_CPCAP_WINGRAY_WAKE_ARM_TEST=y
+
+# Root-only freezer test; no device/CPU sleep.
+CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST=y
diff --git a/arch/arm/mach-tegra/Kconfig b/arch/arm/mach-tegra/Kconfig
index 6d259ea9..1159598c 100644
--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -81,6 +81,15 @@ config MOTOROLA_WINGRAY_PM_PREPARE
 	  This is a build/inspection profile, not suspend or deep sleep.
 	  No command-line or sysfs switch can release this build-time block.
 
+config MOTOROLA_WINGRAY_FREEZER_TEST
+	bool "Wingray manual task-freezer test (no device or CPU suspend)"
+	depends on MOTOROLA_WINGRAY_PM_PREPARE && PM_DEBUG
+	default n
+	help
+	  Add a root-only manual task-freezing test. Uses normal suspend
+	  preparation/notifiers and thawing, stops before device callbacks,
+	  and never enters CPU/platform sleep. Ordinary suspend stays blocked.
+
 config MOTOROLA_XOOM_GPU_STARTUP_TRACE
 	bool "Wingray retained GPU startup checkpoints (no rendering test)"
 	depends on TEGRA_GRHOST_WINGRAY_GPU_TEST && SMP && !THUMB2_KERNEL
diff --git a/include/linux/wingray_pm_prepare.h b/include/linux/wingray_pm_prepare.h
index 9b4dbafb..cf92de05 100644
--- a/include/linux/wingray_pm_prepare.h
+++ b/include/linux/wingray_pm_prepare.h
@@ -8,4 +8,7 @@ static inline bool wingray_pm_prepare_only(void)
 	return IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_PM_PREPARE) &&
 		of_machine_is_compatible("motorola,wingray");
 }
+#ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
+int wingray_pm_freezer_test(void);
+#endif
 #endif
diff --git a/kernel/power/main.c b/kernel/power/main.c
index 68c0eaae..23744a51 100644
--- a/kernel/power/main.c
+++ b/kernel/power/main.c
@@ -15,6 +15,7 @@
 #include <linux/workqueue.h>
 #include <linux/debugfs.h>
 #include <linux/seq_file.h>
+#include <linux/wingray_pm_prepare.h>
 
 #include "power.h"
 
@@ -606,7 +607,58 @@ power_attr(pm_freeze_timeout);
 
 #endif	/* CONFIG_FREEZER*/
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
+static DEFINE_MUTEX(wingray_freezer_lock);
+static unsigned int wingray_freezer_completed;
+static int wingray_freezer_result;
+
+static ssize_t wingray_freezer_test_show(struct kobject *kobj,
+				struct kobj_attribute *attr, char *buf)
+{
+	int ret;
+
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	/* Readers must not block behind the test while tasks are freezing. */
+	if (!mutex_trylock(&wingray_freezer_lock))
+		return -EBUSY;
+	ret = scnprintf(buf, PAGE_SIZE,
+		"completed=%u last_result=%d device_suspend=0 cpu_sleep=0 ordinary_sleep=blocked\n",
+		wingray_freezer_completed, wingray_freezer_result);
+	mutex_unlock(&wingray_freezer_lock);
+	return ret;
+}
+
+static ssize_t wingray_freezer_test_store(struct kobject *kobj,
+		struct kobj_attribute *attr, const char *buf, size_t count)
+{
+	int ret;
+
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	/* Do not queue competing tests or hold another task across freeze. */
+	if (!mutex_trylock(&wingray_freezer_lock))
+		return -EBUSY;
+	ret = wingray_pm_freezer_test();
+	wingray_freezer_result = ret;
+	if (!ret)
+		wingray_freezer_completed++;
+	mutex_unlock(&wingray_freezer_lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static struct kobj_attribute wingray_freezer_test_attr =
+	__ATTR(wingray_freezer_test, 0600, wingray_freezer_test_show,
+	       wingray_freezer_test_store);
+#endif
+
 static struct attribute * g[] = {
+#ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
+	&wingray_freezer_test_attr.attr,
+#endif
 	&state_attr.attr,
 #ifdef CONFIG_PM_TRACE
 	&pm_trace_attr.attr,
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index b1d20c42..46dc89aa 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -489,10 +489,15 @@ static void suspend_finish(void)
  * Fail if that's not the case.  Otherwise, prepare for system suspend, make the
  * system enter the given sleep state and clean up after wakeup.
  */
-static int enter_state(suspend_state_t state)
+static int enter_state(suspend_state_t state, bool freezer_only)
 {
 	int error;
 
+	if (freezer_only &&
+	    (!IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST) ||
+	     !wingray_pm_prepare_only() || state != PM_SUSPEND_FREEZE))
+		return -EOPNOTSUPP;
+
 	trace_suspend_resume(TPS("suspend_enter"), state, true);
 	if (state == PM_SUSPEND_FREEZE) {
 #ifdef CONFIG_PM_DEBUG
@@ -508,6 +513,14 @@ static int enter_state(suspend_state_t state)
 	if (!mutex_trylock(&pm_mutex))
 		return -EBUSY;
 
+#ifdef CONFIG_PM_DEBUG
+	/* Serialized with pm_test_store; do not alter the global test mode. */
+	if (freezer_only && pm_test_level != TEST_NONE) {
+		error = -EBUSY;
+		goto Unlock;
+	}
+#endif
+
 	if (state == PM_SUSPEND_FREEZE)
 		freeze_begin();
 
@@ -525,6 +538,17 @@ static int enter_state(suspend_state_t state)
 	if (error)
 		goto Unlock;
 
+	if (freezer_only) {
+		pr_info("WG_FREEZER89 tasks frozen; devices and CPUs stay powered\n");
+		msleep(500);
+		goto Finish;
+	}
+	/* Defense in depth: no device test/low-level entry in preparation. */
+	if (wingray_pm_prepare_only()) {
+		error = -EOPNOTSUPP;
+		goto Finish;
+	}
+
 	if (suspend_test(TEST_FREEZER))
 		goto Finish;
 
@@ -537,11 +561,20 @@ static int enter_state(suspend_state_t state)
  Finish:
 	pr_debug("PM: Finishing wakeup.\n");
 	suspend_finish();
+	if (freezer_only)
+		pr_info("WG_FREEZER89 tasks thawed result=%d\n", error);
  Unlock:
 	mutex_unlock(&pm_mutex);
 	return error;
 }
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
+int wingray_pm_freezer_test(void)
+{
+	return enter_state(PM_SUSPEND_FREEZE, true);
+}
+#endif
+
 static void pm_suspend_marker(char *annotation)
 {
 	struct timespec ts;
@@ -573,7 +606,7 @@ int pm_suspend(suspend_state_t state)
 		return -EOPNOTSUPP;
 
 	pm_suspend_marker("entry");
-	error = enter_state(state);
+	error = enter_state(state, false);
 	if (error) {
 		suspend_stats.fail++;
 		dpm_save_failed_errno(error);
-- 
2.43.0

