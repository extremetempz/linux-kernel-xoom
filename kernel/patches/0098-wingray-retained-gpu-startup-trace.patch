--- a/drivers/usb/gadget/legacy/serial.c
+++ b/drivers/usb/gadget/legacy/serial.c
@@ -10,6 +10,7 @@
  * either version 2 of that License or (at your option) any later version.
  */
 
+#include <soc/tegra/wingray-gputrace.h>
 #include <linux/kernel.h>
 #include <linux/device.h>
 #include <linux/module.h>
@@ -165,6 +166,7 @@ static int gs_bind(struct usb_composite_dev *cdev)
 {
 	int			status;
 
+	wingray_gputrace_mark(WG_USB, 3);
 	wingray_boottrace_usb_mark(WINGRAY_TRACE_USB_BIND, 3);
 	/* Allocate string descriptor numbers ... note that string
 	 * contents can be overridden by the composite_dev glue.
@@ -196,6 +198,7 @@ static int gs_bind(struct usb_composite_dev *cdev)
 	}
 
