new file mode 100644
index 00000000..7327af16
--- /dev/null
+++ b/include/soc/tegra/wingray-gputrace.h
@@ -0,0 +1,44 @@
+/* Diagnostic only; offsets share the existing 128-byte SMP record. GPL-2.0 */
+#ifndef __SOC_TEGRA_WINGRAY_GPUTRACE_H
+#define __SOC_TEGRA_WINGRAY_GPUTRACE_H
+#define WG_INIT_FN 0x2c
+#define WG_INIT_RET 0x30
+#define WG_INIT_STATE 0x34
+#define WG_HOST 0x38
+#define WG_HOST_RET 0x3c
+#define WG_GR2D 0x40
+#define WG_GR2D_RET 0x44
+#define WG_GR3D 0x48
+#define WG_GR3D_RET 0x4c
+#define WG_KERNEL 0x50
+#define WG_EXEC_RET 0x54
+#define WG_REPORTER 0x58
+#define WG_USER 0x5c
+#define WG_USB 0x60
+#define WG_USB_RET 0x64
+#define WG_PANIC 0x68
+#ifdef CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE
+#include <soc/tegra/wingray-smptrace.h>
+#define wingray_gputrace_mark(o,v) wingray_smptrace_mark(o,v)
+static inline void wingray_gputrace_engine(unsigned int index,
+		unsigned int stage, int result)
+{
+	unsigned int offset;
+	if (index == 10)
+		offset = WG_HOST;
+	else if (index == 2)
+		offset = WG_GR2D;
+	else if (index == 1)
+		offset = WG_GR3D;
+	else
+		return;
+	/* A reset between stores leaves stage zero, not a mismatched pair. */
+	wingray_gputrace_mark(offset, 0);
+	wingray_gputrace_mark(offset + 4, result);
+	wingray_gputrace_mark(offset, stage);
+}
+#else
+#define wingray_gputrace_mark(o,v) do { } while (0)
+#define wingray_gputrace_engine(i,s,r) do { } while (0)
+#endif
+#endif
