diff --git a/arch/arm/mach-tegra/wingray-gputrace.c b/arch/arm/mach-tegra/wingray-gputrace.c
new file mode 100644
index 00000000..45172f23
--- /dev/null
+++ b/arch/arm/mach-tegra/wingray-gputrace.c
@@ -0,0 +1,76 @@
+/* Retained startup diagnostics only; GPL-2.0. No arbitrary memory interface. */
+#include <linux/capability.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/uaccess.h>
+#include <soc/tegra/wingray-gputrace.h>
+
+static ssize_t wingray_trace_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *pos)
+{
+	char code[2];
+	unsigned int offset, value;
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (count != 2)
+		return -EINVAL;
+	if (copy_from_user(code, buf, 2))
+		return -EFAULT;
+	if (code[1] != '\n')
+		return -EINVAL;
+	/* Digits belong only to the sequential bootstrap/service stream;
+	 * letters belong only to the sequential reporter/server stream. */
+	if (code[0] >= '1' && code[0] <= '5') {
+		offset = WG_USER;
+		value = code[0] - '0';
+	} else if (code[0] >= 'A' && code[0] <= 'C') {
+		offset = WG_REPORTER;
+		value = code[0] - 'A' + 1;
+	} else {
+		return -EINVAL;
+	}
+	if (!wingray_smptrace_ready)
+		return -ENODEV;
+	wingray_gputrace_mark(offset, value);
+	return count;
+}
+
+static const struct file_operations wingray_trace_fops = {
+	.owner = THIS_MODULE,
+	.write = wingray_trace_write,
+	.llseek = no_llseek,
+};
+static struct miscdevice wingray_trace_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "xoom-startup-trace",
+	.fops = &wingray_trace_fops,
+	.mode = 0200,
+};
+static int wingray_trace_panic(struct notifier_block *nb,
+		unsigned long event, void *data)
+{
+	wingray_gputrace_mark(WG_PANIC, 1);
+	return NOTIFY_DONE;
+}
+static struct notifier_block wingray_trace_notifier = {
+	.notifier_call = wingray_trace_panic,
+};
+static int __init wingray_trace_early(void)
+{
+	if (!wingray_smptrace_ready)
+		return -ENODEV;
+	return atomic_notifier_chain_register(&panic_notifier_list,
+			&wingray_trace_notifier);
+}
+early_initcall(wingray_trace_early);
+static int __init wingray_trace_device_init(void)
+{
+	if (!wingray_smptrace_ready)
+		return -ENODEV;
+	return misc_register(&wingray_trace_device);
+}
+device_initcall(wingray_trace_device_init);
diff --git a/drivers/staging/tegra/video/host/bus_client.c b/drivers/staging/tegra/video/host/bus_client.c
index 493604e8..3c1dc963 100644
--- a/drivers/staging/tegra/video/host/bus_client.c
+++ b/drivers/staging/tegra/video/host/bus_client.c
@@ -18,6 +18,7 @@
  * along with this program.  If not, see <http://www.gnu.org/licenses/>.
  */
 
+#include <soc/tegra/wingray-gputrace.h>
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/fs.h>
@@ -616,12 +617,16 @@ int nvhost_client_device_init(struct nvhost_device *dev)
 	struct nvhost_master *nvhost_master = nvhost_get_host(dev);
 	struct nvhost_channel *ch;
 
+	wingray_gputrace_engine(dev->index, 10, 0);
 	/* Engine drivers can bind before deferred host/nvmap bring-up. */
-	if (!nvhost_master || !nvhost_master->memmgr || !nvhost_master->nvhost_class)
+	if (!nvhost_master || !nvhost_master->memmgr || !nvhost_master->nvhost_class) {
+		wingray_gputrace_engine(dev->index, 11, -EPROBE_DEFER);
 		return -EPROBE_DEFER;
+	}
 
 	dev_info(&dev->dev, "initialize...\n");
 
+	wingray_gputrace_engine(dev->index, 20, 0);
 	ch = nvhost_alloc_channel(dev);
 	if (ch == NULL)
 		return -ENODEV;
@@ -629,27 +634,36 @@ int nvhost_client_device_init(struct nvhost_device *dev)
 	/* store the pointer to this device for channel */
 	ch->dev = dev;
 
+	wingray_gputrace_engine(dev->index, 30, 0);
 	err = nvhost_channel_init(ch, nvhost_master, dev->index);
+	wingray_gputrace_engine(dev->index, 31, err);
 	if (err)
 		goto fail;
 
+	wingray_gputrace_engine(dev->index, 40, 0);
 	err = nvhost_module_init(dev);
+	wingray_gputrace_engine(dev->index, 41, err);
 	if (err)
 		goto fail_channel;
 
 #ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
 	/* Checked reset while clocked, before any userspace open is possible. */
+	wingray_gputrace_engine(dev->index, 50, 0);
 	err = nvhost_module_prepare_client(dev);
+	wingray_gputrace_engine(dev->index, 51, err);
 	if (err)
 		goto fail_module;
 #endif
 	/* An open must never observe uninitialized module power/clock state. */
+	wingray_gputrace_engine(dev->index, 60, 0);
 	err = nvhost_client_user_init(dev);
+	wingray_gputrace_engine(dev->index, 61, err);
 	if (err)
 		goto fail_module;
 
 	dev_info(&dev->dev, "initialized\n");
 
+	wingray_gputrace_engine(dev->index, 61, 0);
 	return 0;
 
 fail_module:
diff --git a/drivers/staging/tegra/video/host/host1x/host1x.c b/drivers/staging/tegra/video/host/host1x/host1x.c
index df0291c8..3a5fe036 100644
--- a/drivers/staging/tegra/video/host/host1x/host1x.c
+++ b/drivers/staging/tegra/video/host/host1x/host1x.c
@@ -18,6 +18,7 @@
  * along with this program.  If not, see <http://www.gnu.org/licenses/>.
  */
 
+#include <soc/tegra/wingray-gputrace.h>
 #include <linux/slab.h>
 #include <linux/fs.h>
 #include <linux/cdev.h>
@@ -475,6 +476,7 @@ static int nvhost_probe(struct nvhost_device *dev,
 	bool intr_ready = false, clocks_on = false, user_ready = false;
 	int err;
 
+	wingray_gputrace_engine(10, 10, 0);
 	regs = nvhost_get_resource(dev, IORESOURCE_MEM, 0);
 	intr0 = nvhost_get_resource(dev, IORESOURCE_IRQ, 0);
 	intr1 = nvhost_get_resource(dev, IORESOURCE_IRQ, 1);
@@ -505,6 +507,7 @@ static int nvhost_probe(struct nvhost_device *dev,
 		goto fail;
 	}
 	nvhost_set_drvdata(dev, host);
+	wingray_gputrace_engine(10, 40, 0);
 	err = nvhost_module_init(dev);
 	if (err)
 		goto fail;
@@ -513,6 +516,7 @@ static int nvhost_probe(struct nvhost_device *dev,
 		err = -ENODEV;
 		goto fail;
 	}
+	wingray_gputrace_engine(10, 50, 0);
 	err = nvhost_probe_enable_clocks(dev);
 	if (err)
 		goto fail;
@@ -546,6 +550,7 @@ static int nvhost_probe(struct nvhost_device *dev,
 	nvhost_probe_disable_clocks(dev);
 	clocks_on = false;
 	/* Publish userspace/global references only after successful bring-up. */
+	wingray_gputrace_engine(10, 60, 0);
 	err = nvhost_user_init(host);
 	if (err)
 		goto fail;
@@ -555,6 +560,7 @@ static int nvhost_probe(struct nvhost_device *dev,
 		goto fail;
 	nvhost_debug_init(host);
 	dev_info(&dev->dev, "initialized\n");
+	wingray_gputrace_engine(10, 61, 0);
 	return 0;
 fail:
 	if (user_ready)
@@ -576,6 +582,7 @@ fail:
 	if (host->reg_mem)
 		release_mem_region(regs->start, resource_size(regs));
 	kfree(host);
+	wingray_gputrace_engine(10, 0xff, err);
 	return err;
 }
 
diff --git a/drivers/staging/tegra/video/host/nvhost_acm.c b/drivers/staging/tegra/video/host/nvhost_acm.c
index 3a787dd4..b2a913d6 100644
--- a/drivers/staging/tegra/video/host/nvhost_acm.c
+++ b/drivers/staging/tegra/video/host/nvhost_acm.c
@@ -20,6 +20,7 @@
 
 #include "nvhost_acm.h"
 #include "dev.h"
+#include <soc/tegra/wingray-gputrace.h>
 #include <linux/slab.h>
 #include <linux/string.h>
 #include <linux/sched.h>
@@ -320,18 +321,26 @@ int nvhost_module_prepare_client(struct nvhost_device *dev)
 	if ((dev->index != 1 && dev->index != 2) || !dev->rst ||
 	    drv->prepare_clockoff || dev->can_powergate)
 		return -EINVAL;
+	wingray_gputrace_engine(dev->index, 51, 0);
 	err = nvhost_module_busy_checked(dev);
+	wingray_gputrace_engine(dev->index, 52, err);
 	if (err)
 		return err;
 	mutex_lock_nested(&dev->lock, dev->index == 10);
+	wingray_gputrace_engine(dev->index, 53, 0);
 	err = reset_control_assert(dev->rst);
+	wingray_gputrace_engine(dev->index, 54, err);
 	if (!err) {
 		usleep_range(1000, 2000);
+		wingray_gputrace_engine(dev->index, 55, 0);
 		err = reset_control_deassert(dev->rst);
+		wingray_gputrace_engine(dev->index, 56, err);
 	}
 	/* There can be no other client: the character device is unpublished. */
 	dev->refcount--;
+	wingray_gputrace_engine(dev->index, 57, 0);
 	gate_err = to_state_clockgated_locked(dev);
+	wingray_gputrace_engine(dev->index, 58, gate_err);
 	mutex_unlock(&dev->lock);
 	wake_up(&dev->idle_wq);
 	if (drv->idle)
@@ -771,7 +780,9 @@ int nvhost_module_init(struct nvhost_device *dev)
 	struct kobj_attribute *attr = NULL;
 
 	INIT_LIST_HEAD(&dev->client_list);
+	wingray_gputrace_engine(dev->index, 41, 0);
 	err = nvhost_module_init_clocks(dev);
+	wingray_gputrace_engine(dev->index, 42, err);
 	if (err)
 		return err;
 
@@ -782,17 +793,22 @@ int nvhost_module_init(struct nvhost_device *dev)
 	dev->poweron_pending = false;
 	/* power gate units that we can power gate */
 	if (dev->can_powergate) {
+		wingray_gputrace_engine(dev->index, 43, 0);
 		err = do_powergate_locked(dev);
+		wingray_gputrace_engine(dev->index, 44, err);
 		if (err)
 			goto fail_clocks;
 		dev->powerstate = NVHOST_POWER_STATE_POWERGATED;
 	} else {
+		wingray_gputrace_engine(dev->index, 43, 0);
 		err = do_unpowergate_locked(dev);
+		wingray_gputrace_engine(dev->index, 44, err);
 		if (err)
 			goto fail_clocks;
 		dev->powerstate = NVHOST_POWER_STATE_CLOCKGATED;
 	}
 
+	wingray_gputrace_engine(dev->index, 45, 0);
 	/* Init the power sysfs attributes for this device */
 	dev->power_attrib = kzalloc(sizeof(struct nvhost_device_power_attr),
 		GFP_KERNEL);
diff --git a/drivers/usb/gadget/legacy/serial.c b/drivers/usb/gadget/legacy/serial.c
