From b3393c36a62a0d21d79f8ac597f9ae2abdf1ef09 Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Wed, 28 Oct 2026 16:35:21 +1100
Subject: [PATCH] dts: isolate ECC-protected Wingray retained-console test

---
 ...-motorola-wingray-android44-wakeirqecc.dts |  15 ++
 .../wingray_android44_wakeirqecc_defconfig    | 225 ++++++++++++++++++
 2 files changed, 240 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirqecc.dts
 create mode 100644 arch/arm/configs/wingray_android44_wakeirqecc_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirqecc.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirqecc.dts
new file mode 100644
index 00000000..7476e634
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirqecc.dts
@@ -0,0 +1,15 @@
+/* Isolated retained-console integrity experiment; DC and SoC sleep stay off. */
+#include "tegra20-motorola-wingray-android44-wakeirqtrace.dts"
+
+/ {
+	motorola,wingray-pstore-ecc-test;
+
+	ramoops@1ff00000 {
+		/* Existing donor RS(8) implementation: 16 parity bytes per
+		 * 128-byte block, including protected ring headers. ecc-size
+		 * is u32 here (unlike this donor's u64 log-size properties).
+		 * Consumes space INSIDE each existing zone; no RAM is added.
+		 * Not format-compatible with the no-ECC trace83 payload. */
+		ecc-size = <16>;
+	};
+};
diff --git a/arch/arm/configs/wingray_android44_wakeirqecc_defconfig b/arch/arm/configs/wingray_android44_wakeirqecc_defconfig
new file mode 100644
index 00000000..e55cbd06
--- /dev/null
