Date: Tue, 27 Oct 2026 16:57:44 +1100
Subject: [PATCH] mfd: add isolated Wingray ON IRQ ownership and LIC routing
 diagnostic

---
 ...a20-motorola-wingray-android44-wakeirq.dts |  11 +
 .../wingray_android44_wakeirq_defconfig       | 226 ++++++++++++++++++
 drivers/mfd/Kconfig                           |   8 +
 drivers/mfd/motorola-cpcap.c                  | 176 +++++++++++++-
 4 files changed, 419 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirq.dts
 create mode 100644 arch/arm/configs/wingray_android44_wakeirq_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirq.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirq.dts
new file mode 100644
index 00000000..79d76540
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-wakeirq.dts
@@ -0,0 +1,11 @@
+/* Awake ON-IRQ ownership diagnostic, not a suspend-capable DT.
+ * Preserve native SPI transport and every regulator/pinmux/timing property.
+ */
+#include "tegra20-motorola-wingray-android44-displaypm.dts"
+&cpcap {
+	/* Route the SAME PMU hardware interrupt through Tegra's LIC so a
+	 * later PM profile can maintain its wake mask. No IRQ/polarity change.
+	 */
+	interrupt-parent = <&lic>;
+	motorola,wingray-on-irq-test;
+};
