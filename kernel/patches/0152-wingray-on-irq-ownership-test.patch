diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 215a94d9..751ce205 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1538,6 +1538,14 @@ config MFD_VEXPRESS_SYSREG
 endmenu
 endif
 
+config MFD_CPCAP_WINGRAY_IRQ_TEST
+	bool "Wingray CPCAP ON interrupt ownership test"
+	depends on MACH_MOTOROLA_WINGRAY && MFD_CPCAP=y && !SUSPEND
+	default n
+	help
+	  Opt-in IRQ-driven power-key test, with no polling fallback. Requires
+	  the dedicated wakeirq DT/profile. Does not enable SoC suspend.
+
 config MFD_CPCAP
 	tristate "Motorola CPCAP PMIC"
 	depends on SPI && OF
diff --git a/drivers/mfd/motorola-cpcap.c b/drivers/mfd/motorola-cpcap.c
index 994a5ddb..d8a71af9 100644
--- a/drivers/mfd/motorola-cpcap.c
+++ b/drivers/mfd/motorola-cpcap.c
@@ -18,6 +18,7 @@
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
+#include <linux/pm_wakeup.h>
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 #include <linux/sysfs.h>
@@ -41,6 +42,9 @@ struct cpcap_ddata {
 	bool pwrkey_state;
 	unsigned int pwrkey_sense[4];
 	unsigned int pwrkey_int[4];
+	int pwrkey_irq;
+	unsigned int pwrkey_irq_count, pwrkey_irq_errors;
+	bool pwrkey_irq_test;
 };
 
 static int cpcap_sense_irq(struct regmap *regmap, int irq)
@@ -251,11 +255,169 @@ static int cpcap_init_irq(struct cpcap_ddata *cpcap)
 	if (ret)
 		return ret;
 
-	enable_irq_wake(cpcap->spi->irq);
+	/* The opt-in IRQ test does not pretend an unchecked parent wake call
+	 * proves a wake-capable path. Actual PM arming is a later gated stage. */
+	if (!cpcap->pwrkey_irq_test)
+		enable_irq_wake(cpcap->spi->irq);
 
 	return 0;
 }
 
+/* INT1-4 domain is irqdata[2], relative INT2 bit 7 = 16 + 7. The private
+ * macro domains irqdata[0/1] must never own the normal ON key interrupt. */
+#define CPCAP_WINGRAY_ON_IRQ (16 + 7)
+
+static irqreturn_t cpcap_wingray_on_thread(int irq, void *data)
+{
+	struct cpcap_ddata *cpcap = data;
+	unsigned int sense;
+	bool pressed;
+	int ret;
+
+	cpcap->pwrkey_irq_count++;
+	pm_wakeup_event(&cpcap->spi->dev, 500);
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INTS2, &sense);
+	if (ret) {
+		cpcap->pwrkey_irq_errors++;
+		dev_err_ratelimited(&cpcap->spi->dev,
+			"Wingray ON sense read failed: %d\n", ret);
+		return IRQ_HANDLED;
+	}
+	pressed = !!(sense & CPCAP_BIT_ON_S);
+	if (pressed != cpcap->pwrkey_state) {
+		input_report_key(cpcap->pwrkey, KEY_POWER, pressed);
+		input_sync(cpcap->pwrkey);
+	} else if (!pressed) {
+		/* Original Motorola IRQ handler preserves a quick press/release
+		 * that completed before the threaded sense read. */
+		input_report_key(cpcap->pwrkey, KEY_POWER, 1);
+		input_sync(cpcap->pwrkey);
+		input_report_key(cpcap->pwrkey, KEY_POWER, 0);
+		input_sync(cpcap->pwrkey);
+	}
+	cpcap->pwrkey_state = pressed;
+	dev_info_ratelimited(&cpcap->spi->dev,
+		"Wingray ON IRQ: count=%u sense=%04x pressed=%d\n",
+		cpcap->pwrkey_irq_count, sense, pressed);
+	/* regmap-irq owns ACK and masks. Never clear/unmask it behind its
+	 * software cache and never disable the shared parent to hide a storm. */
+	return IRQ_HANDLED;
+}
+
+static ssize_t wingray_irq_status_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct cpcap_ddata *cpcap = dev_get_drvdata(dev);
+	struct irq_data *parent = irq_get_irq_data(cpcap->spi->irq);
+	unsigned int status, mask, sense;
+	int i, a, b, c, len;
+
+	len = scnprintf(buf, PAGE_SIZE,
+		"mode=irq-only polling=0 parent=%d chip=%s hwirq=%lu on_virq=%d on_domain_index=23 events=%u errors=%u state=%d soc_suspend=disabled\n",
+		cpcap->spi->irq, parent && parent->chip ? parent->chip->name : "none",
+		parent ? parent->hwirq : 0, cpcap->pwrkey_irq,
+		READ_ONCE(cpcap->pwrkey_irq_count),
+		READ_ONCE(cpcap->pwrkey_irq_errors), READ_ONCE(cpcap->pwrkey_state));
+	for (i = 0; i < 4; i++) {
+		a = regmap_read(cpcap->regmap, CPCAP_REG_INT1 + i * 4, &status);
+		b = regmap_read(cpcap->regmap, CPCAP_REG_INTM1 + i * 4, &mask);
+		c = regmap_read(cpcap->regmap, CPCAP_REG_INTS1 + i * 4, &sense);
+		if (a || b || c)
+			len += scnprintf(buf + len, PAGE_SIZE - len,
+				"bank=%d read_errors=%d,%d,%d\n", i + 1, a, b, c);
+		else
+			len += scnprintf(buf + len, PAGE_SIZE - len,
+				"bank=%d status=%04x mask=%04x sense=%04x unmasked_pending=%04x\n",
+				i + 1, status, mask, sense, status & ~mask & 0xffff);
+	}
+	return len;
+}
+static DEVICE_ATTR_RO(wingray_irq_status);
+
+static void cpcap_wingray_irq_status_remove(void *data)
+{
+	device_remove_file(data, &dev_attr_wingray_irq_status);
+}
+
+static void cpcap_wingray_wakeup_disable(void *data)
+{
+	device_init_wakeup(data, false);
+}
+
+static int cpcap_register_irq_pwrkey(struct cpcap_ddata *cpcap)
+{
+	struct device *dev = &cpcap->spi->dev;
+	struct irq_data *parent = irq_get_irq_data(cpcap->spi->irq);
+	struct input_dev *input;
+	unsigned int sense;
+	int ret;
+
+	if (!parent || !parent->chip || strcmp(parent->chip->name, "LIC")) {
+		dev_err(dev, "Wingray ON IRQ test requires Tegra LIC routing\n");
+		return -EINVAL;
+	}
+	if (!cpcap->irqdata[2])
+		return -ENODEV;
+	cpcap->pwrkey_irq = regmap_irq_get_virq(cpcap->irqdata[2],
+					       CPCAP_WINGRAY_ON_IRQ);
+	if (cpcap->pwrkey_irq <= 0)
+		return cpcap->pwrkey_irq ? cpcap->pwrkey_irq : -EINVAL;
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INTS2, &sense);
+	if (ret)
+		return ret;
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return -ENOMEM;
+	input->name = "cpcap-pwrkey";
+	input->phys = "cpcap-pwrkey/input0";
+	input->dev.parent = dev;
+	input_set_capability(input, EV_KEY, KEY_POWER);
+	ret = input_register_device(input);
+	if (ret)
+		return ret;
+	cpcap->pwrkey = input;
+	cpcap->pwrkey_state = !!(sense & CPCAP_BIT_ON_S);
+	input_report_key(input, KEY_POWER, cpcap->pwrkey_state);
+	input_sync(input);
+	ret = device_init_wakeup(dev, true);
+	if (ret)
+		return ret;
+	ret = devm_add_action(dev, cpcap_wingray_wakeup_disable, dev);
+	if (ret) {
+		device_init_wakeup(dev, false);
+		return ret;
+	}
+	/* IRQ registration unmasks only ON through regmap's own mask cache.
+	 * Clear the single stale ON latch before installing the consumer,
+	 * matching Motorola's write-one-to-clear interrupt convention. */
+	ret = regmap_write(cpcap->regmap, CPCAP_REG_INT2, CPCAP_BIT_ON_I);
+	if (ret)
+		return ret;
+	ret = devm_request_threaded_irq(dev, cpcap->pwrkey_irq, NULL,
+				      cpcap_wingray_on_thread, IRQF_ONESHOT,
+				      "wingray-cpcap-on", cpcap);
+	if (ret)
+		return ret;
+	ret = regmap_read(cpcap->regmap, CPCAP_REG_INTM2, &sense);
+	if (ret)
+		return ret;
+	if (sense & CPCAP_BIT_ON_I) {
+		dev_err(dev, "Wingray ON IRQ remained masked: INTM2=%04x\n", sense);
+		return -EIO;
+	}
+	ret = device_create_file(dev, &dev_attr_wingray_irq_status);
+	if (ret)
+		return ret;
+	ret = devm_add_action(dev, cpcap_wingray_irq_status_remove, dev);
+	if (ret) {
+		device_remove_file(dev, &dev_attr_wingray_irq_status);
+		return ret;
+	}
+	dev_info(dev, "Wingray ON IRQ-only registered: parent=%d virq=%d index=23; no polling, suspend disabled\n",
+		 cpcap->spi->irq, cpcap->pwrkey_irq);
+	return 0;
+}
+
 static void cpcap_pwrkey_work(struct work_struct *work)
 {
 	struct cpcap_ddata *cpcap =
@@ -483,6 +645,13 @@ static int cpcap_probe(struct spi_device *spi)
 
 	cpcap->spi = spi;
 	spi_set_drvdata(spi, cpcap);
+	cpcap->pwrkey_irq_test =
+		IS_ENABLED(CONFIG_MFD_CPCAP_WINGRAY_IRQ_TEST) &&
+		of_machine_is_compatible("motorola,wingray") &&
+		of_property_read_bool(spi->dev.of_node, "motorola,wingray-on-irq-test");
+	if (IS_ENABLED(CONFIG_MFD_CPCAP_WINGRAY_IRQ_TEST) &&
+	    of_machine_is_compatible("motorola,wingray") && !cpcap->pwrkey_irq_test)
+		return -EINVAL;
 
 	ret = cpcap_setup_transport(spi);
 	if (ret)
@@ -510,7 +679,10 @@ static int cpcap_probe(struct spi_device *spi)
 		return ret;
 
 	if (of_machine_is_compatible("motorola,wingray")) {
-		ret = cpcap_register_pwrkey(cpcap);
+		ret = cpcap->pwrkey_irq_test ? cpcap_register_irq_pwrkey(cpcap) :
+			cpcap_register_pwrkey(cpcap);
+		if (ret && cpcap->pwrkey_irq_test)
+			return ret; /* No quiet fallback that can masquerade as IRQ wake. */
 		if (ret)
 			dev_warn(&spi->dev, "CPCAP power key unavailable: %d\n", ret);
 	}
-- 
2.43.0

