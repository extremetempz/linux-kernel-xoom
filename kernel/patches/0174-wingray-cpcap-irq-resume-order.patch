diff --git a/arch/arm/mach-tegra/pm.c b/arch/arm/mach-tegra/pm.c
index db5fbfe3..77b01d87 100644
--- a/arch/arm/mach-tegra/pm.c
+++ b/arch/arm/mach-tegra/pm.c
@@ -17,6 +17,7 @@
  */
 
 #include <linux/clk/tegra.h>
+#include <linux/console.h>
 #include <linux/cpumask.h>
 #include <linux/cpu_pm.h>
 #include <linux/delay.h>
@@ -422,6 +423,13 @@ void __init tegra_init_suspend(void)
 		return;
 	}
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_LP2_TEST
+	/* The original Motorola board kept the console alive across suspend;
+	 * otherwise pstore stops before the LP2 and teardown markers. */
+	console_suspend_enabled = false;
+	pr_info("Wingray LP2: console suspend disabled for evidence\n");
+#endif
+
 	if (mode == TEGRA_SUSPEND_NONE)
 		return;
 
diff --git a/drivers/mfd/motorola-cpcap.c b/drivers/mfd/motorola-cpcap.c
index 443bdff9..ebe3ffed 100644
--- a/drivers/mfd/motorola-cpcap.c
+++ b/drivers/mfd/motorola-cpcap.c
@@ -53,6 +53,7 @@ struct cpcap_ddata {
 	bool wake_arm_owned;
 #ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
 	bool pm_test_active, pm_cycle_owned;
+	bool irq_masked;
 #endif
 	int wake_arm_error, wake_arm_cleanup_error;
 #endif
@@ -885,8 +886,15 @@ static int cpcap_wingray_pm_suspend(struct device *dev)
 	ret = cpcap_wingray_set_wake_arm(cpcap, true);
 	/* Also track a reference retained after a failed arm rollback. */
 	cpcap->pm_cycle_owned = cpcap->wake_arm_owned;
-	dev_info(dev, "WG_PM90_CPCAP_SUSPEND result=%d owned=%u\n",
-		 ret, cpcap->pm_cycle_owned);
+	/* The parent SPI controller is suspended after this child callback.
+	 * Keep the LIC wake mask armed but stop the regmap-irq parent handler
+	 * from issuing SPI reads until .resume, after the SPI parent is back. */
+	if (!ret && !cpcap->irq_masked) {
+		disable_irq(cpcap->spi->irq);
+		cpcap->irq_masked = true;
+	}
+	dev_info(dev, "WG_PM94_CPCAP_SUSPEND result=%d owned=%u irq_masked=%u\n",
+		 ret, cpcap->pm_cycle_owned, cpcap->irq_masked);
 out:
 	mutex_unlock(&cpcap->wake_arm_lock);
 	return ret;
@@ -903,13 +911,17 @@ static int cpcap_wingray_pm_resume(struct device *dev)
 		return -EOPNOTSUPP;
 	if (!mutex_trylock(&cpcap->wake_arm_lock))
 		return -EBUSY;
+	if (cpcap->irq_masked) {
+		enable_irq(cpcap->spi->irq);
+		cpcap->irq_masked = false;
+	}
 	if (cpcap->pm_cycle_owned) {
 		ret = cpcap_wingray_set_wake_arm(cpcap, false);
 		if (!ret)
 			cpcap->pm_cycle_owned = false;
 	}
-	dev_info(dev, "WG_PM90_CPCAP_RESUME result=%d owned=%u\n",
-		 ret, cpcap->pm_cycle_owned);
+	dev_info(dev, "WG_PM94_CPCAP_RESUME result=%d owned=%u irq_masked=%u\n",
+		 ret, cpcap->pm_cycle_owned, cpcap->irq_masked);
 	mutex_unlock(&cpcap->wake_arm_lock);
 	return ret;
 }
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index d0da54c2..94b7a1f6 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -343,6 +343,8 @@ static int suspend_enter(suspend_state_t state, bool *wakeup)
 	char suspend_abort[MAX_SUSPEND_ABORT_LEN];
 	int error, last_dev;
 
+	pr_info("WG_LP2_SUSPEND_ENTER state=%d pm_test=%d\n", state, pm_test_level);
+
 	error = platform_suspend_prepare(state);
 	if (error)
 		goto Platform_finish;
