--- /dev/null
+++ b/Documentation/devicetree/bindings/net/motorola,wingray-bcm4329-bt.txt
@@ -0,0 +1,19 @@
+Motorola Wingray BCM4329 awake-only Bluetooth power adapter
+
+compatible: "motorola,wingray-bcm4329-bt" (motorola,wingray machine only)
+vdd-supply: shared WLAN/BT PU4 fixed regulator; never a second GPIO owner
+reset-gpios: PU0, active high (logical 1 releases reset)
+shutdown-gpios: PI7, active high; kept low in both power states per Motorola
+ device sequence (do not use generic rfkill shutdown polarity semantics)
+device-wake-gpios: PU1, active high; held high for entire unblocked interval
+host-wake-gpios: PU6, active high; input only in this first profile
+
+All properties are mandatory. The rfkill starts software-blocked. Android's
+existing Broadcom vendor HAL owns firmware download and HCI over UARTC,
+exposed by serial-tegra as ttyHS2 using serial2 = &uartc. Do not attach a
+kernel HCI line discipline simultaneously. No host-wake IRQ or UART LPM /
+system suspend support is provided. This is an experimental awake-only
+profile, not evidence of Bluetooth pairing, audio or Wi-Fi coexistence.
+
+Original GPL reference: board-stingray-bluetooth.c and
+change_power_brcm_4329() in board-stingray.c, Motorola/Google 2.6.39.
diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-bluetooth.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-bluetooth.dts
new file mode 100644
index 00000000..a11bd19b
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-bluetooth.dts
@@ -0,0 +1,31 @@
+/* GPL-2.0: opt-in Bluetooth on top of the unchanged 73k GPU/Wi-Fi DT.
+ * Wiring and UARTC pulls match Motorola board-stingray sources.
+ * No Samsung board data; no Wi-Fi reset or regulator ownership change.
+ */
+#include "tegra20-motorola-wingray-android44-gpu-fbmap.dts"
+/ {
+ model = "Motorola Xoom 73k plus awake-only Bluetooth experiment";
+ aliases { serial2 = &uartc; };
+ bluetooth-power {
+  compatible = "motorola,wingray-bcm4329-bt";
+  vdd-supply = <&wlan_power>;
+  reset-gpios = <&gpio TEGRA_GPIO(U, 0) GPIO_ACTIVE_HIGH>;
+  shutdown-gpios = <&gpio TEGRA_GPIO(I, 7) GPIO_ACTIVE_HIGH>;
+  device-wake-gpios = <&gpio TEGRA_GPIO(U, 1) GPIO_ACTIVE_HIGH>;
+  host-wake-gpios = <&gpio TEGRA_GPIO(U, 6) GPIO_ACTIVE_HIGH>;
+ };
+ pinmux@70000014 {
+  wingray_bt_uart: bluetooth-uart-pins {
+   uca { nvidia,pins = "uca"; nvidia,function = "uartc";
+         nvidia,tristate = <0>; nvidia,pull = <2>; };
+   ucb { nvidia,pins = "ucb"; nvidia,function = "uartc";
+         nvidia,tristate = <0>; nvidia,pull = <2>; };
+  };
+ };
+};
+&uartc {
+ compatible = "nvidia,tegra20-hsuart";
+ status = "okay";
+ pinctrl-names = "default";
+ pinctrl-0 = <&wingray_bt_uart>;
+};
