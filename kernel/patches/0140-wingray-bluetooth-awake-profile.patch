diff --git a/net/rfkill/rfkill-wingray-bt.c b/net/rfkill/rfkill-wingray-bt.c
new file mode 100644
index 00000000..f9e6bc7b
--- /dev/null
+++ b/net/rfkill/rfkill-wingray-bt.c
@@ -0,0 +1,130 @@
+/*
+ * Motorola Wingray BCM4329 power adapter for Linux 4.4.
+ * GPIO sequence adapted from Google's/Motorola's board-stingray-bluetooth.c
+ * Copyright (C) 2010 Google, Inc.  Licensed under GPL version 2.
+ * Existing serial-tegra and Android Broadcom vendor HAL own HCI/firmware.
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/rfkill.h>
+#include <linux/slab.h>
+
+struct wingray_bt {
+	struct gpio_desc *reset, *shutdown, *wake, *host_wake;
+	struct regulator *vdd;
+	struct rfkill *rfkill;
+	bool rail_enabled;
+};
+
+/* rfkill serializes callbacks. Keep PI7 low in BOTH states, as Motorola did.
+ * Do not drive PU4 directly: Wi-Fi and Bluetooth share that physical rail. */
+static int wingray_bt_set_block(void *data, bool blocked)
+{
+	struct wingray_bt *bt = data;
+	int ret;
+
+	if (!blocked) {
+		if (!bt->rail_enabled) {
+			ret = regulator_enable(bt->vdd);
+			if (ret)
+				return ret;
+			bt->rail_enabled = true;
+		}
+		gpiod_set_value_cansleep(bt->shutdown, 0);
+		/* No UART low-power callbacks in this first profile. */
+		gpiod_set_value_cansleep(bt->wake, 1);
+		gpiod_set_value_cansleep(bt->reset, 1);
+		return 0;
+	}
+	gpiod_set_value_cansleep(bt->reset, 0);
+	gpiod_set_value_cansleep(bt->wake, 0);
+	gpiod_set_value_cansleep(bt->shutdown, 0);
+	if (!bt->rail_enabled)
+		return 0;
+	ret = regulator_disable(bt->vdd);
+	if (ret)
+		return ret;
+	bt->rail_enabled = false;
+	return 0;
+}
+
+static const struct rfkill_ops wingray_bt_ops = {
+	.set_block = wingray_bt_set_block,
+};
+
+static int wingray_bt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct wingray_bt *bt;
+	int ret;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return -ENODEV;
+	bt = devm_kzalloc(dev, sizeof(*bt), GFP_KERNEL);
+	if (!bt)
+		return -ENOMEM;
+	if (!of_find_property(dev->of_node, "vdd-supply", NULL))
+		return -EINVAL;
+	bt->vdd = devm_regulator_get(dev, "vdd");
+	if (IS_ERR(bt->vdd))
+		return PTR_ERR(bt->vdd);
+	bt->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(bt->reset))
+		return PTR_ERR(bt->reset);
+	bt->shutdown = devm_gpiod_get(dev, "shutdown", GPIOD_OUT_LOW);
+	if (IS_ERR(bt->shutdown))
+		return PTR_ERR(bt->shutdown);
+	bt->wake = devm_gpiod_get(dev, "device-wake", GPIOD_OUT_LOW);
+	if (IS_ERR(bt->wake))
+		return PTR_ERR(bt->wake);
+	/* Input only. Do not enable a floating host-wake IRQ while blocked. */
+	bt->host_wake = devm_gpiod_get(dev, "host-wake", GPIOD_IN);
+	if (IS_ERR(bt->host_wake))
+		return PTR_ERR(bt->host_wake);
+	bt->rfkill = rfkill_alloc("bcm4329 Bluetooth", dev,
+			RFKILL_TYPE_BLUETOOTH, &wingray_bt_ops, bt);
+	if (!bt->rfkill)
+		return -ENOMEM;
+	rfkill_init_sw_state(bt->rfkill, true);
+	ret = rfkill_register(bt->rfkill);
+	if (ret) {
+		rfkill_destroy(bt->rfkill);
+		return ret;
+	}
+	platform_set_drvdata(pdev, bt);
+	dev_info(dev, "BCM4329 blocked; awake-only UARTC test profile\n");
+	return 0;
+}
+
+static int wingray_bt_remove(struct platform_device *pdev)
+{
+	struct wingray_bt *bt = platform_get_drvdata(pdev);
+	int ret;
+
+	rfkill_unregister(bt->rfkill);
+	ret = wingray_bt_set_block(bt, true);
+	if (ret)
+		dev_warn(&pdev->dev, "shared rail release failed: %d\n", ret);
+	rfkill_destroy(bt->rfkill);
+	return 0;
+}
+
+static const struct of_device_id wingray_bt_match[] = {
+	{ .compatible = "motorola,wingray-bcm4329-bt" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, wingray_bt_match);
+static struct platform_driver wingray_bt_driver = {
+	.probe = wingray_bt_probe,
+	.remove = wingray_bt_remove,
+	.driver = {
+		.name = "wingray-bcm4329-bt",
+		.of_match_table = wingray_bt_match,
+	},
+};
+module_platform_driver(wingray_bt_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Motorola Wingray awake-only BCM4329 Bluetooth power");
-- 
