diff --git a/arch/arm/kernel/smp.c b/arch/arm/kernel/smp.c
index b2636135..67a0098b 100644
--- a/arch/arm/kernel/smp.c
+++ b/arch/arm/kernel/smp.c
@@ -27,6 +27,7 @@
 #include <linux/completion.h>
 #include <linux/cpufreq.h>
 #include <linux/irq_work.h>
+#include <soc/tegra/wingray-smptrace.h>
 
 #include <linux/atomic.h>
 #include <asm/smp.h>
@@ -120,7 +121,9 @@ int __cpu_up(unsigned int cpu, struct task_struct *idle)
 	/*
 	 * Now bring the CPU into our world.
 	 */
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 6);
 	ret = smp_ops.smp_boot_secondary(cpu, idle);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 16);
 	if (ret == 0) {
 		/*
 		 * CPU was successfully started, wait for it
@@ -138,6 +141,9 @@ int __cpu_up(unsigned int cpu, struct task_struct *idle)
 	}
 
 
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_RESULT, ret);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_ONLINE, cpu_online(cpu));
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 17);
 	memset(&secondary_data, 0, sizeof(secondary_data));
 	return ret;
 }
@@ -358,6 +364,7 @@ asmlinkage void secondary_start_kernel(void)
 	 * switch away from it before attempting any exclusive accesses.
 	 */
 	cpu_switch_mm(mm->pgd, mm);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU1, 1);
 	local_flush_bp_all();
 	enter_lazy_tlb(mm, current);
 	local_flush_tlb_all();
@@ -384,10 +391,13 @@ asmlinkage void secondary_start_kernel(void)
 	if (smp_ops.smp_secondary_init)
 		smp_ops.smp_secondary_init(cpu);
 
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU1, 2);
 	notify_cpu_starting(cpu);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU1, 3);
 
 	calibrate_delay();
 
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU1, 4);
 	smp_store_cpu_info(cpu);
 
 	/*
@@ -397,6 +407,7 @@ asmlinkage void secondary_start_kernel(void)
 	 */
 	set_cpu_online(cpu, true);
 	complete(&cpu_running);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU1, 5);
 
 	local_irq_enable();
 	local_fiq_enable();
diff --git a/arch/arm/mach-tegra/Kconfig b/arch/arm/mach-tegra/Kconfig
index d9bbf38b..280d37a0 100644
--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -70,6 +70,23 @@ config MACH_MOTOROLA_WINGRAY
 	  Experimental device-tree support for the Wi-Fi Xoom. Power,
 	  display and suspend support still require hardware validation.
 
+config MOTOROLA_XOOM_SMP_TRACE
+	bool "Experimental Wingray SMP-only RAM checkpoints"
+	depends on MACH_MOTOROLA_WINGRAY && SMP && !THUMB2_KERNEL
+	depends on !ARM_LPAE && VMSPLIT_3G && !CPU_BIG_ENDIAN
+	default n
+	help
+	  Separate diagnostic for secondary CPU startup, not the UP boot tracer.
+	  Uses 128 bytes in the Wingray DT's reserved no-map console region.
+	  CPU0, CPU1 reset assembly and CPU1 C use distinct single-writer words.
+	  Changes timing; never use for ordinary ROM builds. Readback must be
+	  guarded by a matching build cookie and original memory-map preflight.
+
+config MOTOROLA_XOOM_SMP_TRACE_COOKIE
+	hex "Wingray SMP trace build identifier"
+	depends on MOTOROLA_XOOM_SMP_TRACE
+	default 0x584d0037
+
 config MOTOROLA_XOOM_BOOT_TRACE
 	bool "Experimental Wingray early RAM breadcrumbs"
 	depends on MACH_MOTOROLA_WINGRAY && !SMP && !THUMB2_KERNEL
diff --git a/arch/arm/mach-tegra/io.c b/arch/arm/mach-tegra/io.c
index 1018211e..e6b42988 100644
--- a/arch/arm/mach-tegra/io.c
+++ b/arch/arm/mach-tegra/io.c
@@ -24,6 +24,8 @@
 #include <linux/mm.h>
 #include <linux/module.h>
 #include <soc/tegra/wingray-boottrace.h>
+#include <soc/tegra/wingray-smptrace.h>
+#include <linux/of_fdt.h>
 
 #include <asm/mach/map.h>
 #include <asm/page.h>
@@ -68,10 +70,36 @@ static struct map_desc wingray_trace_io_desc __initdata = {
 };
 #endif
 
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+bool wingray_smptrace_ready;
+static struct map_desc wingray_smptrace_desc __initdata = {
+ .virtual = WINGRAY_SMPTRACE_VIRT,
+ .pfn = __phys_to_pfn(WINGRAY_SMPTRACE_BASE),
+ .length = PAGE_SIZE,
+ .type = MT_DEVICE,
+};
+#endif
+
 void __init tegra_map_common_io(void)
 {
 	debug_ll_io_init();
 	iotable_init(tegra_io_desc, ARRAY_SIZE(tegra_io_desc));
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+	if (of_flat_dt_is_compatible(of_get_flat_dt_root(), "motorola,wingray")) {
+		void __iomem *p = (void __iomem *)WINGRAY_SMPTRACE_VIRT;
+		iotable_init(&wingray_smptrace_desc, 1);
+		/* Clear stale records first; publish magic only after the header. */
+		memset_io(p, 0, 128);
+		writel_relaxed(WINGRAY_SMPTRACE_VERSION, p + 4);
+		writel_relaxed(CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE, p + 8);
+		dsb(sy);
+		writel_relaxed(WINGRAY_SMPTRACE_MAGIC, p);
+		dsb(sy);
+		readl_relaxed(p);
+		wingray_smptrace_ready = true;
+		wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 1);
+	}
+#endif
 #ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
 	if (of_flat_dt_is_compatible(of_get_flat_dt_root(), "motorola,wingray")) {
 		/* Early allocation only; no slab/vmalloc dependency. */
diff --git a/arch/arm/mach-tegra/platsmp.c b/arch/arm/mach-tegra/platsmp.c
index 533b89b1..a4b80a3c 100644
--- a/arch/arm/mach-tegra/platsmp.c
+++ b/arch/arm/mach-tegra/platsmp.c
@@ -22,6 +22,7 @@
 #include <linux/smp.h>
 
 #include <soc/tegra/fuse.h>
+#include <soc/tegra/wingray-smptrace.h>
 #include <soc/tegra/pmc.h>
 
 #include <asm/cacheflush.h>
@@ -54,7 +55,9 @@ static int tegra20_boot_secondary(unsigned int cpu, struct task_struct *idle)
 	 * effect on first boot of the CPU since it should already be
 	 * in reset.
 	 */
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 10);
 	tegra_put_cpu_in_reset(cpu);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 11);
 
 	/*
 	 * Unhalt the CPU. If the flow controller was used to
@@ -63,10 +66,14 @@ static int tegra20_boot_secondary(unsigned int cpu, struct task_struct *idle)
 	 * clock and reset block is now driving reset.
 	 */
 	flowctrl_write_cpu_halt(cpu, 0);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 12);
 
 	tegra_enable_cpu_clock(cpu);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 13);
 	flowctrl_write_cpu_csr(cpu, 0); /* Clear flow controller CSR. */
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 14);
 	tegra_cpu_out_of_reset(cpu);
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 15);
 	return 0;
 }
 
@@ -188,6 +195,7 @@ static void __init tegra_smp_prepare_cpus(unsigned int max_cpus)
 	/* Always mark the boot CPU (CPU0) as initialized. */
 	cpumask_set_cpu(0, &tegra_cpu_init_mask);
 
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 4);
 	if (scu_a9_has_base()) {
 		void __iomem *scu_base = IO_ADDRESS(scu_a9_get_base());
 		u32 scu_ctrl = __raw_readl(scu_base) |
@@ -199,6 +207,7 @@ static void __init tegra_smp_prepare_cpus(unsigned int max_cpus)
 
 		scu_enable(scu_base);
 	}
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 5);
 }
 
 struct smp_operations tegra_smp_ops __initdata = {
diff --git a/arch/arm/mach-tegra/reset-handler.S b/arch/arm/mach-tegra/reset-handler.S
index c7204821..e75912fd 100644
--- a/arch/arm/mach-tegra/reset-handler.S
+++ b/arch/arm/mach-tegra/reset-handler.S
@@ -18,6 +18,7 @@
 #include <linux/linkage.h>
 
 #include <soc/tegra/fuse.h>
+#include <soc/tegra/wingray-smptrace.h>
 
 #include <asm/asm-offsets.h>
 #include <asm/cache.h>
@@ -122,6 +123,33 @@ ENTRY(__tegra_cpu_reset_handler_start)
 ENTRY(__tegra_cpu_reset_handler)
 
 	cpsid	aif, 0x13			@ SVC mode, interrupts disabled
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+	/* No stack or cacheable shared state. r0-r2 are scratch at reset. */
+	adr	r0, __tegra_cpu_reset_handler_data
+	ldr	r0, [r0, #RESET_DATA(TRACE_BASE)]
+	cmp	r0, #0
+	beq	90f
+	ldr	r1, [r0]
+	mov32	r2, WINGRAY_SMPTRACE_MAGIC
+	cmp	r1, r2
+	bne	90f
+	ldr	r1, [r0, #4]
+	cmp	r1, #WINGRAY_SMPTRACE_VERSION
+	bne	90f
+	ldr	r1, [r0, #8]
+	mov32	r2, CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE
+	cmp	r1, r2
+	bne	90f
+	mrc	p15, 0, r1, c0, c0, 5
+	and	r1, r1, #3
+	cmp	r1, #1
+	bne	90f
+	mov	r1, #1
+	str	r1, [r0, #WINGRAY_SMPTRACE_RESET]
+	dsb	sy
+	ldr	r1, [r0, #WINGRAY_SMPTRACE_RESET]
+90:
+#endif
 
 	tegra_get_soc_id TEGRA_APB_MISC_BASE, r6
 #ifdef CONFIG_ARCH_TEGRA_2x_SOC
diff --git a/arch/arm/mach-tegra/reset.c b/arch/arm/mach-tegra/reset.c
index 6fd9db54..d75f885d 100644
--- a/arch/arm/mach-tegra/reset.c
+++ b/arch/arm/mach-tegra/reset.c
@@ -20,6 +20,7 @@
 #include <linux/io.h>
 
 #include <soc/tegra/fuse.h>
+#include <soc/tegra/wingray-smptrace.h>
 
 #include <asm/cacheflush.h>
 #include <asm/firmware.h>
@@ -104,5 +105,16 @@ void __init tegra_cpu_reset_handler_init(void)
 		virt_to_phys((void *)tegra_resume);
 #endif
 
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+	/* Assembly never touches this physical page on another Tegra board. */
+	__tegra_cpu_reset_handler_data[TEGRA_RESET_TRACE_BASE] =
+		wingray_smptrace_ready ? WINGRAY_SMPTRACE_BASE : 0;
+#endif
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_ENTRY,
+			     virt_to_phys((void *)secondary_startup));
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 2);
 	tegra_cpu_reset_handler_enable();
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_VECTOR,
+		readl(IO_ADDRESS(TEGRA_EXCEPTION_VECTORS_BASE + 0x100)));
+	wingray_smptrace_mark(WINGRAY_SMPTRACE_CPU0, 3);
 }
diff --git a/arch/arm/mach-tegra/reset.h b/arch/arm/mach-tegra/reset.h
index 9c479c79..e5d7d055 100644
--- a/arch/arm/mach-tegra/reset.h
+++ b/arch/arm/mach-tegra/reset.h
@@ -25,7 +25,12 @@
 #define TEGRA_RESET_STARTUP_SECONDARY	3
 #define TEGRA_RESET_STARTUP_LP2		4
 #define TEGRA_RESET_STARTUP_LP1		5
-#define TEGRA_RESET_DATA_SIZE		6
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+#define TEGRA_RESET_TRACE_BASE           6
+#define TEGRA_RESET_DATA_SIZE            7
+#else
+#define TEGRA_RESET_DATA_SIZE            6
+#endif
 
 #ifndef __ASSEMBLY__
 
diff --git a/include/soc/tegra/wingray-smptrace.h b/include/soc/tegra/wingray-smptrace.h
new file mode 100644
index 00000000..e20a503e
--- /dev/null
+++ b/include/soc/tegra/wingray-smptrace.h
@@ -0,0 +1,37 @@
+/* Optional Wingray SMP diagnostics. GNU GPL version 2. */
+#ifndef __SOC_TEGRA_WINGRAY_SMPTRACE_H
+#define __SOC_TEGRA_WINGRAY_SMPTRACE_H
+#define WINGRAY_SMPTRACE_BASE 0x1fe00000
+#define WINGRAY_SMPTRACE_VIRT 0xfe600000
+#define WINGRAY_SMPTRACE_MAGIC 0x58534d50
+#define WINGRAY_SMPTRACE_VERSION 1
+#define WINGRAY_SMPTRACE_CPU0 0x10
+#define WINGRAY_SMPTRACE_RESET 0x14
+#define WINGRAY_SMPTRACE_CPU1 0x18
+#define WINGRAY_SMPTRACE_ENTRY 0x1c
+#define WINGRAY_SMPTRACE_VECTOR 0x20
+#define WINGRAY_SMPTRACE_RESULT 0x24
+#define WINGRAY_SMPTRACE_ONLINE 0x28
+#ifndef __ASSEMBLY__
+#ifdef CONFIG_MOTOROLA_XOOM_SMP_TRACE
+#include <linux/io.h>
+extern bool wingray_smptrace_ready;
+static inline void wingray_smptrace_mark(unsigned int offset, u32 value)
+{
+ void __iomem *p = (void __iomem *)WINGRAY_SMPTRACE_VIRT;
+ if (!wingray_smptrace_ready || offset < 0x10 || offset > 0x28 || (offset & 3))
+  return;
+ if (readl_relaxed(p) != WINGRAY_SMPTRACE_MAGIC ||
+     readl_relaxed(p + 4) != WINGRAY_SMPTRACE_VERSION ||
+     readl_relaxed(p + 8) != CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE)
+  return;
+ /* Independent CPU0, CPU1-reset and CPU1-C words: no shared RMW/locks. */
+ writel_relaxed(value, p + offset);
+ dsb(sy);
+ readl_relaxed(p + offset);
+}
+#else
+#define wingray_smptrace_mark(offset, value) do { } while (0)
+#endif
+#endif
+#endif
-- 
