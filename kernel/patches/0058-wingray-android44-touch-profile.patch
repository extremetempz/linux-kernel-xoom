From fd24d166a00bd9860f1a287b9b974843bddcc716 Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Fri, 23 Oct 2026 04:30:04 +1100
Subject: [PATCH] arm: isolate Wingray factory touch Android profile

---
 ...gra20-motorola-wingray-android44-touch.dts |  42 ++++++
 .../configs/wingray_android44_touch_defconfig | 137 ++++++++++++++++++
 2 files changed, 179 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-android44-touch.dts
 create mode 100644 arch/arm/configs/wingray_android44_touch_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-touch.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-touch.dts
new file mode 100644
index 00000000..399879a0
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-touch.dts
@@ -0,0 +1,42 @@
+/* GPL-2.0: isolated P3 touch addition to the tested Android RAM-data profile. */
+#include "tegra20-motorola-wingray-android44.dts"
+/ {
+	model = "Motorola Xoom P3 Android 4.4 RAM-data touch test";
+	pinmux@70000014 {
+		wingray_panelbus_mux: panelbus-mux {
+			/* Shared pin groups match the working P3 pinmux capture. GPIO
+			 * requests select GPIO mode; these are the legacy safe muxes.
+			 * All three groups have real pull/tristate fields on Tegra20.
+			 */
+			touch-wake {
+				nvidia,pins = "gmd";
+				nvidia,function = "gmi";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			touch-reset {
+				nvidia,pins = "kbcd";
+				nvidia,function = "sdio2";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			touch-irq {
+				nvidia,pins = "uac";
+				nvidia,function = "rsvd4";
+				nvidia,tristate = <0>;
+				nvidia,pull = <0>;
+			};
+		};
+	};
+	i2c@7000c000 {
+		touchscreen@5b {
+			compatible = "motorola,wingray-maxtouch", "atmel,maxtouch";
+			reg = <0x5b>;
+			interrupt-parent = <&gpio>;
+			interrupts = <TEGRA_GPIO(V, 2) IRQ_TYPE_LEVEL_LOW>;
+			enable-gpios = <&gpio TEGRA_GPIO(J, 2) GPIO_ACTIVE_LOW>;
+			reset-gpios = <&gpio TEGRA_GPIO(R, 4) GPIO_ACTIVE_LOW>;
+			panel-supply = <&panel_power>;
+		};
+	};
+};
diff --git a/arch/arm/configs/wingray_android44_touch_defconfig b/arch/arm/configs/wingray_android44_touch_defconfig
new file mode 100644
index 00000000..57f4b3bd
--- /dev/null
