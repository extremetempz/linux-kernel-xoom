From bc56d535c0692486d9c5576f4ec694c5bf8cb91c Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sat, 24 Oct 2026 07:08:57 +1100
Subject: [PATCH] ARM: tegra: add Motorola Wingray carveout-only legacy
 resource profile

---
 ...ra20-motorola-wingray-legacy-resources.dts |  50 ++++++
 .../wingray_legacy_resources_defconfig        | 168 ++++++++++++++++++
 2 files changed, 218 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-legacy-resources.dts
 create mode 100644 arch/arm/configs/wingray_legacy_resources_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-legacy-resources.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-legacy-resources.dts
new file mode 100644
index 00000000..a5b29dad
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-legacy-resources.dts
@@ -0,0 +1,50 @@
+/* GPL-2.0: Motorola carveout-only legacy allocator experiment.
+ * Reuse the tested P3 pinmux, power, USB/MMC and touch description unchanged.
+ * No host/engine/DC takeover, GART mappings or IRAM allocation in this stage.
+ */
+#include "tegra20-motorola-wingray-android44-smp2.dts"
+
+/ {
+	model = "Motorola Xoom P3 legacy resource experiment (carveout only)";
+
+	reserved-memory {
+		/* Label the existing reservation; do not add overlapping regions
+		 * or change its bounds. fb0/fb1 occupy the first 24 MiB. */
+		wingray_legacy_video: legacy-video@2e800000 { };
+	};
+
+	nvmap {
+		compatible = "nvidia,tegra-nvmap";
+		status = "okay";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		carveouts {
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges;
+			/* Motorola tegra_reserve(256M, 8M, 16M), top of 1 GiB
+			 * DRAM: generic starts after fb0/fb1, at 0x30000000.
+			 * No Samsung address or power table is imported. */
+			generic@30000000 {
+				reg = <0x30000000 0x10000000>;
+				reg-names = "generic-0";
+				buddy-size = <0x8000>;
+				usage-mask = <0x1>;
+				memory-region = <&wingray_legacy_video>;
+			};
+		};
+	};
+
+	/* Keep the firmware display state rather than programming a different
+	 * controller. The tested panel/backlight/power properties are retained. */
+	panel { status = "disabled"; };
+	host1x@50000000 {
+		status = "disabled";
+		dc@54200000 { status = "disabled"; };
+	};
+	memory-controller@7000f000 { status = "disabled"; };
+	iommu@7000f024 { status = "disabled"; };
+	memory-controller@7000f400 { status = "disabled"; };
+};
diff --git a/arch/arm/configs/wingray_legacy_resources_defconfig b/arch/arm/configs/wingray_legacy_resources_defconfig
new file mode 100644
index 00000000..d1f7297c
