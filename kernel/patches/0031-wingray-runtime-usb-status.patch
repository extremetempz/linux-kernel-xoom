From 32291dfb64c45ed7ca32f2b56a73f7c0f15cc4dc Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Tue, 20 Oct 2026 18:21:02 +1100
Subject: [PATCH] ARM: tegra: instrument Wingray post-exec mounts and USB
 probes

---
 drivers/usb/chipidea/ci_hdrc_tegra.c  | 18 +++++++-
 drivers/usb/phy/phy-tegra-usb.c       | 18 +++++++-
 fs/namespace.c                        | 10 +++++
 include/soc/tegra/wingray-boottrace.h | 10 +++++
 init/main.c                           |  1 +
 kernel/panic.c                        | 62 +++++++++++++++++++++++++++
 6 files changed, 117 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/chipidea/ci_hdrc_tegra.c b/drivers/usb/chipidea/ci_hdrc_tegra.c
index bfcee270..aec05dde 100644
--- a/drivers/usb/chipidea/ci_hdrc_tegra.c
+++ b/drivers/usb/chipidea/ci_hdrc_tegra.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/of_device.h>
 #include <linux/reset.h>
+#include <soc/tegra/wingray-boottrace.h>
 
 #include <linux/usb/chipidea.h>
 
@@ -62,7 +63,7 @@ static const struct of_device_id tegra_udc_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, tegra_udc_of_match);
 
-static int tegra_udc_probe(struct platform_device *pdev)
+static int tegra_udc_probe_impl(struct platform_device *pdev)
 {
 	const struct tegra_udc_soc_info *soc;
 	struct tegra_udc *udc;
@@ -78,6 +79,7 @@ static int tegra_udc_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 3);
 	udc->phy = devm_usb_get_phy_by_phandle(&pdev->dev, "nvidia,phy", 0);
 	if (IS_ERR(udc->phy)) {
 		err = PTR_ERR(udc->phy);
@@ -85,6 +87,7 @@ static int tegra_udc_probe(struct platform_device *pdev)
 		return err;
 	}
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 4);
 	udc->clk = devm_clk_get(&pdev->dev, NULL);
 	if (IS_ERR(udc->clk)) {
 		err = PTR_ERR(udc->clk);
@@ -92,6 +95,7 @@ static int tegra_udc_probe(struct platform_device *pdev)
 		return err;
 	}
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 5);
 	err = clk_prepare_enable(udc->clk);
 	if (err < 0) {
 		dev_err(&pdev->dev, "failed to enable clock: %d\n", err);
@@ -103,6 +107,7 @@ static int tegra_udc_probe(struct platform_device *pdev)
 	 * hook, so we have to power on UDC controller before ChipIdea
 	 * driver initialization kicks in.
 	 */
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 6);
 	usb_phy_set_suspend(udc->phy, 0);
 
 	/* setup and register ChipIdea HDRC device */
@@ -111,6 +116,7 @@ static int tegra_udc_probe(struct platform_device *pdev)
 	udc->data.usb_phy = udc->phy;
 	udc->data.capoffset = DEF_CAPOFFSET;
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 7);
 	udc->dev = ci_hdrc_add_device(&pdev->dev, pdev->resource,
 				      pdev->num_resources, &udc->data);
 	if (IS_ERR(udc->dev)) {
@@ -129,6 +135,16 @@ fail_power_off:
 	return err;
 }
 
+static int tegra_udc_probe(struct platform_device *pdev)
+{
+	int ret;
+
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_UDC, 1);
+	ret = tegra_udc_probe_impl(pdev);
+	wingray_boottrace_diagnostic_result(WINGRAY_TRACE_USB_UDC, ret);
+	return ret;
+}
+
 static int tegra_udc_remove(struct platform_device *pdev)
 {
 	struct tegra_udc *udc = platform_get_drvdata(pdev);
diff --git a/drivers/usb/phy/phy-tegra-usb.c b/drivers/usb/phy/phy-tegra-usb.c
index 73029ace..cc4bebbf 100644
--- a/drivers/usb/phy/phy-tegra-usb.c
+++ b/drivers/usb/phy/phy-tegra-usb.c
@@ -36,6 +36,7 @@
 #include <linux/usb/ehci_def.h>
 #include <linux/usb/tegra_usb_phy.h>
 #include <linux/regulator/consumer.h>
+#include <soc/tegra/wingray-boottrace.h>
 
 #define ULPI_VIEWPORT		0x170
 
@@ -962,7 +963,7 @@ static const struct of_device_id tegra_usb_phy_id_table[] = {
 };
 MODULE_DEVICE_TABLE(of, tegra_usb_phy_id_table);
 
-static int tegra_usb_phy_probe(struct platform_device *pdev)
+static int tegra_usb_phy_probe_impl(struct platform_device *pdev)
 {
 	const struct of_device_id *match;
 	struct resource *res;
@@ -1001,6 +1002,7 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 	phy_type = of_usb_get_phy_mode(np);
 	switch (phy_type) {
 	case USBPHY_INTERFACE_MODE_UTMI:
+		wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 3);
 		err = utmi_phy_probe(tegra_phy, pdev);
 		if (err < 0)
 			return err;
@@ -1024,6 +1026,7 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 4);
 	if (of_find_property(np, "dr_mode", NULL))
 		tegra_phy->mode = usb_get_dr_mode(&pdev->dev);
 	else
@@ -1035,6 +1038,7 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 	}
 
 	/* On some boards, the VBUS regulator doesn't need to be controlled */
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 5);
 	if (of_find_property(np, "vbus-supply", NULL)) {
 		tegra_phy->vbus = devm_regulator_get(&pdev->dev, "vbus");
 		if (IS_ERR(tegra_phy->vbus))
@@ -1045,6 +1049,7 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 	}
 
 	tegra_phy->u_phy.dev = &pdev->dev;
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 6);
 	err = tegra_usb_phy_init(tegra_phy);
 	if (err < 0)
 		return err;
@@ -1053,6 +1058,7 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, tegra_phy);
 
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 7);
 	err = usb_add_phy_dev(&tegra_phy->u_phy);
 	if (err < 0) {
 		tegra_usb_phy_close(tegra_phy);
@@ -1062,6 +1068,16 @@ static int tegra_usb_phy_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static int tegra_usb_phy_probe(struct platform_device *pdev)
+{
+	int ret;
+
+	wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USB_PHY, 1);
+	ret = tegra_usb_phy_probe_impl(pdev);
+	wingray_boottrace_diagnostic_result(WINGRAY_TRACE_USB_PHY, ret);
+	return ret;
+}
+
 static int tegra_usb_phy_remove(struct platform_device *pdev)
 {
 	struct tegra_usb_phy *tegra_phy = platform_get_drvdata(pdev);
diff --git a/fs/namespace.c b/fs/namespace.c
index ce282400..d32a65a8 100644
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -24,6 +24,7 @@
 #include <linux/magic.h>
 #include <linux/bootmem.h>
 #include <linux/task_work.h>
+#include <soc/tegra/wingray-boottrace.h>
 #include "pnode.h"
 #include "internal.h"
 
@@ -3010,6 +3011,11 @@ SYSCALL_DEFINE5(mount, char __user *, dev_name, char __user *, dir_name,
 	char *kernel_dev;
 	unsigned long data_page;
 
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	if (is_global_init(current) || task_ppid_nr(current) == 1)
+		wingray_boottrace_diagnostic_mark(WINGRAY_TRACE_USER_MOUNT, 1);
+#endif
+
 	kernel_type = copy_mount_string(type);
 	ret = PTR_ERR(kernel_type);
 	if (IS_ERR(kernel_type))
@@ -3033,6 +3039,10 @@ out_data:
 out_dev:
 	kfree(kernel_type);
 out_type:
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	if (is_global_init(current) || task_ppid_nr(current) == 1)
+		wingray_boottrace_diagnostic_result(WINGRAY_TRACE_USER_MOUNT, ret);
+#endif
 	return ret;
 }
 
diff --git a/include/soc/tegra/wingray-boottrace.h b/include/soc/tegra/wingray-boottrace.h
index 983c3850..fc43dc57 100644
--- a/include/soc/tegra/wingray-boottrace.h
+++ b/include/soc/tegra/wingray-boottrace.h
@@ -43,6 +43,10 @@
 #define WINGRAY_TRACE_PANIC      0xbad00001
 #define WINGRAY_TRACE_INIT_EXIT  0x58495431
 #define WINGRAY_TRACE_USER_FAULT 0x55534631
+#define WINGRAY_TRACE_DIAGNOSTIC 0x44494131
+#define WINGRAY_TRACE_USB_PHY    0x68
+#define WINGRAY_TRACE_USB_UDC    0x6c
+#define WINGRAY_TRACE_USER_MOUNT 0x70
 /* Temporary explicit section mapping; valid ONLY before paging_init(). */
 #define WINGRAY_TRACE_VIRT       0xdfe00000
 #define WINGRAY_TRACE_STATIC_VIRT 0xfe600000
@@ -52,6 +56,9 @@
 #include <linux/of_fdt.h>
 extern bool wingray_boottrace_static_ready;
 void wingray_boottrace_record_init_exit(unsigned int code);
+void wingray_boottrace_diagnostic_begin(void);
+void wingray_boottrace_diagnostic_mark(unsigned int slot, unsigned int value);
+void wingray_boottrace_diagnostic_result(unsigned int slot, int result);
 void wingray_boottrace_record_user_fault(unsigned long pc, unsigned long addr,
 		unsigned int fsr, unsigned long cpsr, unsigned int sig, int code);
 static inline void wingray_boottrace_mapped_mark(unsigned long address,
@@ -126,6 +133,9 @@ static inline void wingray_boottrace_memmap(unsigned long start_pfn,
 #define wingray_boottrace_static_mark(offset, value) do { } while (0)
 #define wingray_boottrace_record_fault(pc) do { } while (0)
 #define wingray_boottrace_record_init_exit(code) do { } while (0)
+#define wingray_boottrace_diagnostic_begin() do { } while (0)
+#define wingray_boottrace_diagnostic_mark(slot, value) do { } while (0)
+#define wingray_boottrace_diagnostic_result(slot, result) do { } while (0)
 #define wingray_boottrace_record_user_fault(pc, addr, fsr, cpsr, sig, code) do { } while (0)
 #define wingray_boottrace_memmap(start, end, page, stride, nid, zone, context) do { } while (0)
 #endif
diff --git a/init/main.c b/init/main.c
index 80fbd7d3..ba363e09 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1041,6 +1041,7 @@ static noinline void __init kernel_init_freeable(void)
 	page_alloc_init_late();
 
 	wingray_boottrace_static_mark(WINGRAY_TRACE_PHASE, 0x410);
+	wingray_boottrace_diagnostic_begin();
 	do_basic_setup();
 	wingray_boottrace_static_mark(WINGRAY_TRACE_PHASE, 0x411);
 
diff --git a/kernel/panic.c b/kernel/panic.c
index fbd2824b..f222de0c 100644
--- a/kernel/panic.c
+++ b/kernel/panic.c
@@ -67,6 +67,68 @@ void __weak panic_smp_self_stop(void)
 }
 
 #ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+/* UP bring-up scratch words: installed after early memory setup, before
+ * driver initcalls. Fatal/exit records retain priority over these statuses.
+ */
+static bool wingray_diagnostic_ready(void __iomem *trace)
+{
+	return wingray_boottrace_static_ready &&
+		readl_relaxed(trace) == WINGRAY_TRACE_MAGIC &&
+		readl_relaxed(trace + 4) == WINGRAY_TRACE_VERSION &&
+		readl_relaxed(trace + WINGRAY_TRACE_COOKIE) ==
+				CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE &&
+		!readl_relaxed(trace + WINGRAY_TRACE_FAULT_PC);
+}
+
+void wingray_boottrace_diagnostic_begin(void)
+{
+	void __iomem *trace = (void __iomem *)WINGRAY_TRACE_STATIC_VIRT;
+
+	if (!wingray_diagnostic_ready(trace))
+		return;
+	writel_relaxed(0, trace + WINGRAY_TRACE_USB_PHY);
+	writel_relaxed(0, trace + WINGRAY_TRACE_USB_UDC);
+	writel_relaxed(0, trace + WINGRAY_TRACE_USER_MOUNT);
+	dsb(sy);
+	writel_relaxed(WINGRAY_TRACE_DIAGNOSTIC, trace + 0x74);
+	dsb(sy);
+	readl_relaxed(trace + 0x74);
+}
+
+static bool wingray_diagnostic_slot(unsigned int slot)
+{
+	return slot == WINGRAY_TRACE_USB_PHY || slot == WINGRAY_TRACE_USB_UDC ||
+		slot == WINGRAY_TRACE_USER_MOUNT;
+}
+
+void wingray_boottrace_diagnostic_mark(unsigned int slot, unsigned int value)
+{
+	void __iomem *trace = (void __iomem *)WINGRAY_TRACE_STATIC_VIRT;
+
+	if (!wingray_diagnostic_slot(slot) || !wingray_diagnostic_ready(trace) ||
+	    readl_relaxed(trace + 0x74) != WINGRAY_TRACE_DIAGNOSTIC)
+		return;
+	writel_relaxed(value, trace + slot);
+	dsb(sy);
+	readl_relaxed(trace + slot);
+}
+EXPORT_SYMBOL_GPL(wingray_boottrace_diagnostic_mark);
+
+void wingray_boottrace_diagnostic_result(unsigned int slot, int result)
+{
+	void __iomem *trace = (void __iomem *)WINGRAY_TRACE_STATIC_VIRT;
+	unsigned int value = 2;
+
+	if (!wingray_diagnostic_slot(slot) || !wingray_diagnostic_ready(trace) ||
+	    readl_relaxed(trace + 0x74) != WINGRAY_TRACE_DIAGNOSTIC)
+		return;
+	if (result < 0)
+		value = 0x80000000 | ((readl_relaxed(trace + slot) & 0x7fff) << 16) |
+			((0U - (unsigned int)result) & 0xffff);
+	wingray_boottrace_diagnostic_mark(slot, value);
+}
+EXPORT_SYMBOL_GPL(wingray_boottrace_diagnostic_result);
+
 /* Preserve the first observed PID 1 page fault before signal delivery.
  * Reuse entry-register words after boot; leave init-exit metadata intact.
  * A userspace handler may recover, so this alone is not a fatal marker.
-- 
2.43.0

