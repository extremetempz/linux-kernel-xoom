From 499f92264367332795ec636fb274fa442c08e02e Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sun, 25 Oct 2026 10:58:58 +1100
Subject: [PATCH] ARM: wingray: add separate accelerated Android P3 profile

---
 ...tegra20-motorola-wingray-android44-gpu.dts |  49 +++++
 .../configs/wingray_android44_gpu_defconfig   | 181 ++++++++++++++++++
 arch/arm/mach-tegra/wingray-gputrace.c        |   3 +-
 include/soc/tegra/wingray-gputrace.h          |   3 +-
 include/soc/tegra/wingray-smptrace.h          |   3 +-
 5 files changed, 236 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-android44-gpu.dts
 create mode 100644 arch/arm/configs/wingray_android44_gpu_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-gpu.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-gpu.dts
new file mode 100644
index 00000000..897704dc
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-gpu.dts
@@ -0,0 +1,49 @@
+/* GPL-2.0: combined Android/NVIDIA experiment. Motorola P3 wiring only.
+ * Retain the successful fixed-clock GPU and tested touch/USB/MMC resources.
+ * The legacy DC exclusively owns scanout; modern DRM/host1x remain disabled.
+ */
+#include "tegra20-motorola-wingray-gpu-test.dts"
+/ {
+ model = "Motorola Xoom P3 accelerated Android experiment";
+ host1x@50000000 {
+  dc@54200000 {
+   status = "okay";
+   /* First 8 MiB of the existing 24 MiB display reservation, outside nvmap. */
+   reg = <0x54200000 0x40000>, <0x2e800000 0x800000>;
+   reg-names = "regs", "fbmem";
+   interrupt-names = "irq";
+   clocks = <&tegra_car TEGRA20_CLK_DISP1>, <&tegra_car TEGRA20_CLK_PLL_C>;
+   clock-names = "dc", "parent";
+   /* No EMC DT handle: legacy clkdev lookup uses the bounded software vote. */
+   pnl-vdd-supply = <&panel_power>;
+   rgb {
+    status = "okay";
+    display {
+     flags = <1>; /* TEGRA_DC_FLAG_ENABLED */
+     type = <0>; /* RGB */
+     align = <0>; /* MSB */
+     order = <0>; /* RED_BLUE */
+     depth = <24>;
+     default-emc-rate = <300000000>;
+     min-emc-rate = <300000000>;
+     lvds-to-bl = <200>; /* Existing tested panel prepare delay. */
+     fb-win = <0>;
+     fb-xres = <1280>;
+     fb-yres = <800>;
+     fb-bpp = <32>;
+     dc-index = <0>;
+     motorola,h-ref-to-sync = <11>;
+     motorola,v-ref-to-sync = <1>;
+     display-timings {
+      timing0 {
+       clock-frequency = <66400000>;
+       hactive = <1280>; vactive = <800>;
+       hfront-porch = <45>; hsync-len = <26>; hback-porch = <12>;
+       vfront-porch = <3>; vsync-len = <6>; vback-porch = <3>;
+      };
+     };
+    };
+   };
+  };
+ };
+};
diff --git a/arch/arm/configs/wingray_android44_gpu_defconfig b/arch/arm/configs/wingray_android44_gpu_defconfig
new file mode 100644
index 00000000..7441ec9d
--- /dev/null
+++ b/arch/arm/configs/wingray_android44_gpu_defconfig
@@ -0,0 +1,181 @@
+CONFIG_LOCALVERSION="-wingray-android44-gpu"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_EXPERT=y
+CONFIG_KALLSYMS=y
+CONFIG_PRINTK_TIME=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_ARCH_TEGRA=y
+CONFIG_ARCH_TEGRA_2x_SOC=y
+# CONFIG_ARCH_TEGRA_3x_SOC is not set
+# CONFIG_ARCH_TEGRA_114_SOC is not set
+# CONFIG_ARCH_TEGRA_124_SOC is not set
+CONFIG_MACH_MOTOROLA_WINGRAY=y
+# CONFIG_MACH_SAMSUNG_VARIATION_TEGRA is not set
+# CONFIG_MACH_SAMSUNG_P4WIFI is not set
+CONFIG_SMP=y
+CONFIG_SMP_ON_UP=y
+CONFIG_NR_CPUS=2
+# CONFIG_HOTPLUG_CPU is not set
+CONFIG_CACHE_L2X0=y
+CONFIG_HIGHMEM=y
+CONFIG_AEABI=y
+CONFIG_SWP_EMULATE=y
+CONFIG_VFP=y
+# CONFIG_NEON is not set
+# CONFIG_CPU_FREQ is not set
+# CONFIG_CPU_IDLE is not set
+# CONFIG_SUSPEND is not set
+CONFIG_ARM_APPENDED_DTB=y
+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE_NAMES="tegra20-motorola-wingray-android44-gpu"
+CONFIG_CMDLINE="console=ttyS0,115200n8 ignore_loglevel loglevel=8 initcall_debug clk_ignore_unused regulator_ignore_unused ro panic=0 maxcpus=2"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_PROC_FS=y
+CONFIG_SYSFS=y
+CONFIG_TMPFS=y
+CONFIG_BLOCK=y
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_EFI_PARTITION=y
+CONFIG_MOTOROLA_XOOM_BIGPART=y
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_BLOCK_MINORS=32
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SDHCI_TEGRA=y
+CONFIG_EXT4_FS=y
+CONFIG_USB=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_CHIPIDEA=y
+CONFIG_USB_CHIPIDEA_UDC=y
+CONFIG_USB_TEGRA_PHY=y
+CONFIG_USB_G_SERIAL=y
+CONFIG_NET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_IPV6=y
+# CONFIG_NETDEVICES is not set
+# CONFIG_WIRELESS is not set
+# CONFIG_CFG80211 is not set
+# Only the factory-preserving P3 maXTouch input path is added.
+CONFIG_INPUT=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_INPUT_TOUCHSCREEN=y
+CONFIG_TOUCHSCREEN_ATMEL_MXT=y
+# CONFIG_TOUCHSCREEN_MXT1386 is not set
+# CONFIG_SAMSUNG_INPUT is not set
+# CONFIG_INPUT_LEDS is not set
+# CONFIG_INPUT_MOUSEDEV is not set
+# CONFIG_INPUT_JOYDEV is not set
+# CONFIG_INPUT_KEYBOARD is not set
+# CONFIG_INPUT_MOUSE is not set
+# CONFIG_INPUT_JOYSTICK is not set
+# CONFIG_INPUT_TABLET is not set
+# CONFIG_INPUT_MISC is not set
+# CONFIG_SERIO is not set
+# CONFIG_GAMEPORT is not set
+# CONFIG_HID is not set
+# CONFIG_USB_HID is not set
+# CONFIG_VT is not set
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_8250_NR_UARTS=5
+CONFIG_SERIAL_8250_RUNTIME_UARTS=5
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_FS=y
+# CONFIG_DEBUG_LL is not set
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_I2C=y
+CONFIG_I2C_TEGRA=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_BACKLIGHT_LP855X=y
+
+# CONFIG_DRM is not set
+# CONFIG_DRM_TEGRA is not set
+# CONFIG_DRM_TEGRA_FBDEV is not set
+# CONFIG_DRM_PANEL_SIMPLE is not set
+CONFIG_BACKLIGHT_LCD_SUPPORT=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_PWM=y
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=16
+
+# Installed Android 4.4 userspace ABI; separate from the future Oreo ABI.
+CONFIG_ANDROID=y
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDER_DEVICES="binder"
+CONFIG_ANDROID_BINDER_IPC_32BIT=y
+CONFIG_STAGING=y
+CONFIG_ASHMEM=y
+CONFIG_ANDROID_LOGGER=y
+# CONFIG_ANDROID_TIMED_OUTPUT is not set
+CONFIG_ANDROID_LOW_MEMORY_KILLER=y
+CONFIG_SYNC=y
+# CONFIG_SW_SYNC is not set
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_FUSE_FS=y
+CONFIG_INOTIFY_USER=y
+# CONFIG_MOTOROLA_XOOM_BOOT_TRACE is not set
+
+# Isolated Decatf nvmap backing-ownership experiment; no engine or DC access.
+CONFIG_MEMORY=y
+# CONFIG_TEGRA20_MC is not set
+# CONFIG_TEGRA_HOST1X is not set
+# CONFIG_IOMMU_SUPPORT is not set
+# CONFIG_IOMMU_API is not set
+# CONFIG_TEGRA_IOMMU_GART is not set
+CONFIG_TEGRA_DOWNSTREAM=y
+CONFIG_TEGRA_NVMAP=y
+# CONFIG_TEGRA_NVMAP_WINGRAY_RESOURCES is not set
+# CONFIG_TEGRA_RPC is not set
+# CONFIG_TEGRA_AVP is not set
+# CONFIG_TEGRA_AVP_KERNEL_ON_MMU is not set
+# CONFIG_TEGRA_MEDIASERVER is not set
+# CONFIG_TEGRA_IOVMM_GART is not set
+# CONFIG_TEGRA_IOVMM is not set
+CONFIG_TEGRA_GRHOST=y
+# CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST is not set
+CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST=y
+CONFIG_TEGRA_GRHOST_WINGRAY_LEGACY_SUBMIT=y
+CONFIG_TEGRA_SEMA_STANDALONE=y
+CONFIG_FB=y
+CONFIG_TEGRA_DC=y
+CONFIG_FB_TEGRA=y
+# CONFIG_TEGRA_DC_EXTENSIONS is not set
+# CONFIG_TEGRA_OVERLAY is not set
+CONFIG_FB_TEGRA_WINGRAY_LEGACY=y
+# CONFIG_FB_TEGRA_CMC623 is not set
+# CONFIG_NVMAP_ALLOW_SYSMEM is not set
+# CONFIG_NVMAP_RECLAIM_UNPINNED_VM is not set
+# CONFIG_NVMAP_HIGHMEM_ONLY is not set
+# CONFIG_NVMAP_CONVERT_CARVEOUT_TO_IOVMM is not set
+# CONFIG_NVMAP_CARVEOUT_KILLER is not set
+# CONFIG_NVMAP_CARVEOUT_COMPACTOR is not set
+# CONFIG_NVMAP_PAGE_POOLS is not set
+
+# Reserved-RAM startup localization only; no userspace GPU submission.
+CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE=0x584d0059
+
+# Bypass the externally loaded large initrd; RAM runtime stays private.
+CONFIG_INITRAMFS_SOURCE="usr/wingray-android-runtime.cpio"
diff --git a/arch/arm/mach-tegra/wingray-gputrace.c b/arch/arm/mach-tegra/wingray-gputrace.c
index 8d077eaf..20cda317 100644
--- a/arch/arm/mach-tegra/wingray-gputrace.c
+++ b/arch/arm/mach-tegra/wingray-gputrace.c
@@ -86,7 +86,8 @@ static int wingray_trace_panic(struct notifier_block *nb,
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0054 || \
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0055 || \
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0056 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057)
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0059)
 	/* panic() supplies its bounded, NUL-terminated formatted buffer.
 	 * Publish the panic flag only after the 20-byte prefix. */
 	const unsigned char *text = data;
diff --git a/include/soc/tegra/wingray-gputrace.h b/include/soc/tegra/wingray-gputrace.h
index d5c0cadc..fa194ef7 100644
--- a/include/soc/tegra/wingray-gputrace.h
+++ b/include/soc/tegra/wingray-gputrace.h
@@ -43,7 +43,8 @@ static inline void wingray_gputrace_engine(unsigned int index,
 #endif
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0056 || \
- CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057)
+ CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057 || \
+ CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0059)
 #define wingray_gputrace_runtime(i,s,r) wingray_gputrace_engine(i,s,r)
 #else
 #define wingray_gputrace_runtime(i,s,r) do { } while (0)
diff --git a/include/soc/tegra/wingray-smptrace.h b/include/soc/tegra/wingray-smptrace.h
index 15239d2e..ee51640f 100644
--- a/include/soc/tegra/wingray-smptrace.h
+++ b/include/soc/tegra/wingray-smptrace.h
@@ -28,7 +28,8 @@ static inline void wingray_smptrace_mark(unsigned int offset, u32 value)
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0054 || \
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0055 || \
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0056 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057))
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0057 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0059))
      offset > 0x7c ||
 #elif defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE)
      offset > 0x68 ||
-- 
