diff --git a/drivers/staging/tegra/video/dc/mode.c b/drivers/staging/tegra/video/dc/mode.c
index 29173dd8..514e90f3 100644
--- a/drivers/staging/tegra/video/dc/mode.c
+++ b/drivers/staging/tegra/video/dc/mode.c
@@ -19,6 +19,7 @@
 #include <linux/err.h>
 #include <linux/types.h>
 #include <linux/clk.h>
+#include <linux/of.h>
 
 #include <mach/clk.h>
 
@@ -294,6 +295,34 @@ int tegra_dc_set_fb_mode(struct tegra_dc *dc,
 	if (!fbmode->pixclock)
 		return -EINVAL;
 
+	/* fb_videomode has no Tegra ref-to-sync fields. A round trip through
+	 * calc_ref_to_sync changed the AUO native href from 11 to 0, which was
+	 * cached without a hardware modeset and only programmed on DC resume.
+	 * This fixed RGB panel has one native mode, not arbitrary fb modes.
+	 * Scope the correction to the separate resume experiment. */
+	if (IS_ENABLED(CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST) &&
+	    of_machine_is_compatible("motorola,wingray") &&
+	    dc->out->type == TEGRA_DC_OUT_RGB) {
+		const struct tegra_dc_mode *native;
+		if (!dc->out->modes || dc->out->n_modes != 1 || stereo_mode)
+			return -EINVAL;
+		native = &dc->out->modes[0];
+		if (fbmode->xres != (unsigned int)native->h_active ||
+		    fbmode->yres != (unsigned int)native->v_active ||
+		    fbmode->hsync_len != (unsigned int)native->h_sync_width ||
+		    fbmode->vsync_len != (unsigned int)native->v_sync_width ||
+		    fbmode->left_margin != (unsigned int)native->h_back_porch ||
+		    fbmode->upper_margin != (unsigned int)native->v_back_porch ||
+		    fbmode->right_margin != (unsigned int)native->h_front_porch ||
+		    fbmode->lower_margin != (unsigned int)native->v_front_porch ||
+		    fbmode->pixclock != KHZ2PICOS(native->pclk / 1000))
+			return -EINVAL;
+		dev_info(&dc->ndev->dev,
+			 "Wingray native mode retained: href=%d vref=%d pclk=%d\n",
+			 native->h_ref_to_sync, native->v_ref_to_sync, native->pclk);
+		return tegra_dc_set_mode(dc, native);
+	}
+
 	mode.pclk = PICOS2KHZ(fbmode->pixclock) * 1000;
 	mode.h_sync_width = fbmode->hsync_len;
 	mode.v_sync_width = fbmode->vsync_len;
diff --git a/drivers/staging/tegra/video/fb.c b/drivers/staging/tegra/video/fb.c
index c09f6218..69da8a88 100644
--- a/drivers/staging/tegra/video/fb.c
+++ b/drivers/staging/tegra/video/fb.c
@@ -66,6 +66,10 @@ struct tegra_fb_info {
 	struct nvmap_client *user_nvmap, *fb_nvmap;
 	struct nvmap_handle_ref *legacy_front[TEGRA_FB_FLIP_N_WINDOWS];
 	struct nvmap_handle_ref *legacy_pending[TEGRA_FB_FLIP_N_WINDOWS];
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
+	bool dc_blanked;
+	u32 dc_saved_flags[DC_N_WINDOWS];
+#endif
 #endif
 };
 
@@ -295,6 +299,118 @@ static int tegra_fb_setcmap(struct fb_cmap *cmap, struct fb_info *info)
 	return 0;
 }
 
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
+/* legacy_lock owns flips and their pinned front buffers across this entire
+ * transition. Do not change rails or let HWC replace a saved front buffer
+ * while reset destroys the hardware window state. */
+static int tegra_fb_wingray_dc_blank(int blank, struct tegra_fb_info *fb)
+{
+	struct tegra_dc *dc = fb->win->dc;
+	struct tegra_dc_win *wins[DC_N_WINDOWS];
+	unsigned int mask = 0;
+	unsigned long ref;
+	int i, ret = 0, sync = 0;
+
+	cancel_delayed_work_sync(&dc->disable_work);
+	mutex_lock(&fb->legacy_lock);
+	if (!fb->legacy_enabled || fb->legacy_dead || fb->legacy_poisoned) {
+		ret = -EIO;
+		goto out;
+	}
+	for (i = 0; i < DC_N_WINDOWS; i++) {
+		wins[i] = tegra_dc_get_window(dc, i);
+		if (!wins[i]) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	if (blank != FB_BLANK_UNBLANK) {
+		if (fb->dc_blanked)
+			goto out;
+		if (!dc->enabled) {
+			ret = -EIO;
+			goto out;
+		}
+		for (i = 0; i < DC_N_WINDOWS; i++) {
+			fb->dc_saved_flags[i] = wins[i]->flags;
+			if (wins[i]->flags & TEGRA_WIN_FLAG_ENABLED)
+				mask |= BIT(i);
+		}
+		/* Do not reset with no known scanout to restore. */
+		if (!mask) {
+			ret = -ENODATA;
+			goto out;
+		}
+		ret = tegra_wingray_backlight_power(dc, FB_BLANK_POWERDOWN);
+		if (ret)
+			goto out;
+		tegra_dc_disable(dc); /* Clears ALL window enable flags. */
+		fb->dc_blanked = true;
+		dev_info(&fb->ndev->dev,
+			 "Wingray DC test off: dc=%d saved=%x href=%d vref=%d\n",
+			 dc->enabled, mask, dc->mode.h_ref_to_sync,
+			 dc->mode.v_ref_to_sync);
+		goto out;
+	}
+	if (!fb->dc_blanked) {
+		ret = tegra_wingray_backlight_power(dc, FB_BLANK_UNBLANK);
+		goto out;
+	}
+	tegra_dc_enable(dc);
+	if (!dc->enabled) {
+		ret = -EIO;
+		goto fail;
+	}
+	/* Keep addresses, strides, formats, geometry and pinned front ownership.
+	 * Only flags were destroyed by disable. Restore every window, including
+	 * disabled ones, instead of forcing the fbdev window on. */
+	for (i = 0; i < DC_N_WINDOWS; i++) {
+		wins[i]->flags = fb->dc_saved_flags[i];
+		if (wins[i]->flags & TEGRA_WIN_FLAG_ENABLED)
+			mask |= BIT(i);
+	}
+	ret = tegra_dc_update_windows(wins, DC_N_WINDOWS);
+	if (ret)
+		goto fail;
+	sync = tegra_dc_sync_windows(wins, DC_N_WINDOWS);
+	if (sync <= 0) {
+		ret = sync ? sync : -ETIMEDOUT;
+		goto fail;
+	}
+	/* Read only while this driver has enabled the controller clock. */
+	ref = tegra_dc_readl(dc, DC_DISP_REF_TO_SYNC);
+	dev_info(&fb->ndev->dev,
+		 "Wingray DC test scanout: ref=%08lx command=%08lx clock=%08lx restored=%x sync=%d\n",
+		 ref, tegra_dc_readl(dc, DC_CMD_DISPLAY_COMMAND),
+		 tegra_dc_readl(dc, DC_DISP_DISP_CLOCK_CONTROL), mask, sync);
+	if (ref != (dc->mode.h_ref_to_sync |
+		    ((unsigned long)dc->mode.v_ref_to_sync << 16))) {
+		ret = -EIO;
+		goto fail;
+	}
+	ret = tegra_wingray_backlight_power(dc, FB_BLANK_UNBLANK);
+	if (ret)
+		goto fail;
+	fb->dc_blanked = false;
+	dev_info(&fb->ndev->dev,
+		 "Wingray DC test on: dc=%d restored=%x sync=%d href=%d vref=%d\n",
+		 dc->enabled, mask, sync, dc->mode.h_ref_to_sync,
+		 dc->mode.v_ref_to_sync);
+	goto out;
+fail:
+	/* Retain front pins and saved flags for a retry; never claim completion
+	 * or expose a half-restored frame. No automatic restart or rail toggle. */
+	tegra_wingray_backlight_power(dc, FB_BLANK_POWERDOWN);
+	tegra_dc_disable(dc);
+	dev_err(&fb->ndev->dev, "Wingray DC test resume failed: %d sync=%d\n",
+		ret, sync);
+out:
+	mutex_unlock(&fb->legacy_lock);
+	return ret;
+}
+#endif
+
+#ifndef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
 /* Stage A/B only: backlight-only blank.  DC disable/enable was observed to
  * leave the panel dark with a scan line after re-enable, so controller
  * power-down is deliberately deferred until the panel power/reset sequence
@@ -318,6 +434,7 @@ static int tegra_fb_wingray_blank(int blank, struct tegra_fb_info *fb)
 	dev_info(&fb->ndev->dev, "Wingray backlight on: dc=%d\n", dc->enabled);
 	return 0;
 }
+#endif
 
 static int tegra_fb_blank(int blank, struct fb_info *info)
 {
@@ -330,7 +447,11 @@ static int tegra_fb_blank(int blank, struct fb_info *info)
      of_machine_is_compatible("motorola,wingray")) {
   if (blank < FB_BLANK_UNBLANK || blank > FB_BLANK_POWERDOWN)
    return -EINVAL;
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
+  return tegra_fb_wingray_dc_blank(blank, tegra_fb);
+#else
   return tegra_fb_wingray_blank(blank, tegra_fb);
+#endif
  }
 
 	switch (blank) {
diff --git a/drivers/staging/tegra/video/fb_legacy.h b/drivers/staging/tegra/video/fb_legacy.h
index 19211ed9..f6746631 100644
--- a/drivers/staging/tegra/video/fb_legacy.h
+++ b/drivers/staging/tegra/video/fb_legacy.h
@@ -179,6 +179,12 @@ static int tegra_fb_legacy_flip(struct tegra_fb_info *fb,
 
 	if (!fb->user_nvmap || !host || fb->legacy_poisoned)
 		return -EIO;
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
+	/* blank/unblank holds legacy_lock too. Do not pin/program or fabricate
+	 * a completed post-syncpoint while the display is clock-gated. */
+	if (fb->dc_blanked)
+		return -EBUSY;
+#endif
 	/* Validate the entire request and all syncpoint IDs before pinning. */
 	for (i = 0; i < TEGRA_FB_FLIP_N_WINDOWS; i++) {
 		struct tegra_fb_windowattr *a = &args->win[i];
-- 
