diff --git a/drivers/staging/tegra/video/dc/dc.c b/drivers/staging/tegra/video/dc/dc.c
index f1713e65..2522ac71 100644
--- a/drivers/staging/tegra/video/dc/dc.c
+++ b/drivers/staging/tegra/video/dc/dc.c
@@ -1396,6 +1396,30 @@ static int tegra_dc_init(struct tegra_dc *dc)
 	return 0;
 }
 
+/* The LP8550 owns its shared panel supply and register sequencing.
+ * Do not manipulate the old Samsung bl-vdd regulator or guessed GPIOs. */
+int tegra_wingray_backlight_power(struct tegra_dc *dc, int power)
+{
+ struct backlight_device *bl = dc->out->wingray_backlight;
+ int old, ret;
+ if (!bl)
+  return -ENODEV;
+ mutex_lock(&bl->ops_lock);
+ old = bl->props.power;
+ bl->props.power = power;
+ ret = backlight_update_status(bl);
+ if (ret)
+  bl->props.power = old;
+ mutex_unlock(&bl->ops_lock);
+ return ret;
+}
+
+static void tegra_wingray_put_backlight(void *data)
+{
+ struct backlight_device *bl = data;
+ put_device(&bl->dev);
+}
+
 void tegra_enable_backlight(struct tegra_dc *dc)
 {
 	if (dc->out->type != TEGRA_DC_OUT_RGB)
@@ -1983,6 +2007,25 @@ static struct tegra_dc_platform_data *tegra_dc_parse_dt(struct nvhost_device *nd
 	dc_out->lvds_vdd = devm_regulator_get(&ndev->dev, "lvds-vdd");
 	dc_out->pnl_vdd = devm_regulator_get(&ndev->dev, "pnl-vdd");
 	dc_out->bl_vdd = devm_regulator_get(&ndev->dev, "bl-vdd");
+ if (IS_ENABLED(CONFIG_FB_TEGRA_WINGRAY_DISPLAY_PM) &&
+     of_machine_is_compatible("motorola,wingray")) {
+  struct device_node *bl_node;
+  int err;
+  bl_node = of_parse_phandle(dc_np, "backlight", 0);
+  if (!bl_node)
+   return ERR_PTR(-EINVAL);
+  dc_out->wingray_backlight = of_find_backlight_by_node(bl_node);
+  of_node_put(bl_node);
+  if (!dc_out->wingray_backlight)
+   return ERR_PTR(-EPROBE_DEFER);
+  err = devm_add_action(&ndev->dev, tegra_wingray_put_backlight,
+         dc_out->wingray_backlight);
+  if (err) {
+   tegra_wingray_put_backlight(dc_out->wingray_backlight);
+   return ERR_PTR(err);
+  }
+ }
+
 	dc_out->hdmi_vdd = devm_regulator_get(&ndev->dev, "hdmi-vdd");
 	dc_out->hdmi_pll = devm_regulator_get(&ndev->dev, "hdmi-pll");
 	/* Wingray uses the existing shared panel rail, never a guessed dummy.
