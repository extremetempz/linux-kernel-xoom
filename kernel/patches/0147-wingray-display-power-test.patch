 }
 
+/* Stage A/B only: synchronous DC/backlight power, never SoC suspend. */
+static int tegra_fb_wingray_blank(int blank, struct tegra_fb_info *fb)
+{
+ struct tegra_dc *dc = fb->win->dc;
+ int ret;
+ cancel_delayed_work_sync(&dc->disable_work);
+ if (blank != FB_BLANK_UNBLANK) {
+  ret = tegra_wingray_backlight_power(dc, FB_BLANK_POWERDOWN);
+  if (ret)
+   return ret;
+  tegra_dc_disable(dc);
+  dev_info(&fb->ndev->dev, "Wingray display off: blank=%d dc=%d\n",
+    blank, dc->enabled);
+  return 0;
+ }
+ tegra_dc_enable(dc);
+ if (!dc->enabled)
+  return -EIO;
+ fb->win->flags |= TEGRA_WIN_FLAG_ENABLED;
+ ret = tegra_dc_update_windows(&fb->win, 1);
+ if (!ret) {
+  ret = tegra_dc_sync_windows(&fb->win, 1);
+  /* wait_event returns positive remaining jiffies on success. */
+  ret = ret > 0 ? 0 : ret == 0 ? -ETIMEDOUT : ret;
+ }
+ if (!ret)
+  ret = tegra_wingray_backlight_power(dc, FB_BLANK_UNBLANK);
+ if (ret) {
+  tegra_wingray_backlight_power(dc, FB_BLANK_POWERDOWN);
+  tegra_dc_disable(dc);
+  return ret;
+ }
+ dev_info(&fb->ndev->dev, "Wingray display on: dc=%d\n", dc->enabled);
+ return 0;
+}
+
 static int tegra_fb_blank(int blank, struct fb_info *info)
 {
 	struct tegra_fb_info *tegra_fb = info->par;
@@ -302,6 +338,12 @@ static int tegra_fb_blank(int blank, struct fb_info *info)
 	if (tegra_fb_legacy_dead(tegra_fb))
 		return -ENODEV;
 	dc = tegra_fb->win->dc;
+ if (IS_ENABLED(CONFIG_FB_TEGRA_WINGRAY_DISPLAY_PM) &&
+     of_machine_is_compatible("motorola,wingray")) {
+  if (blank < FB_BLANK_UNBLANK || blank > FB_BLANK_POWERDOWN)
+   return -EINVAL;
+  return tegra_fb_wingray_blank(blank, tegra_fb);
+ }
 
 	switch (blank) {
 	case FB_BLANK_UNBLANK:
