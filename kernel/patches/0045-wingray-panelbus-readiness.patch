From e3ea2b294e08f24d46f5782915779892eebc47d5 Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Wed, 21 Oct 2026 19:37:35 +1100
Subject: [PATCH] ARM: tegra: isolate Wingray shared panel supply and I2C
 readiness

---
 .../dts/tegra20-motorola-wingray-panelbus.dts | 38 +++++++++
 arch/arm/configs/wingray_panelbus_defconfig   | 82 +++++++++++++++++++
 2 files changed, 120 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-panelbus.dts
 create mode 100644 arch/arm/configs/wingray_panelbus_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-panelbus.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-panelbus.dts
new file mode 100644
index 00000000..65e1604e
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-panelbus.dts
@@ -0,0 +1,38 @@
+/* P3 shared panel-supply/I2C readiness. GPL-2.0.
+ * Retain the tested USB/MMC diagnostic. No display controller, backlight,
+ * touch, PMIC, CPU rail or network driver is enabled by this profile.
+ */
+#include "tegra20-motorola-wingray-diagnostic.dts"
+/ {
+ model = "Motorola Xoom P3 panel bus diagnostic";
+ aliases { i2c0 = "/i2c@7000c000"; };
+ panel_power: panel-power {
+  compatible = "regulator-fixed";
+  regulator-name = "wingray-panel";
+  regulator-min-microvolt = <5000000>;
+  regulator-max-microvolt = <5000000>;
+  gpio = <&gpio TEGRA_GPIO(B, 2) GPIO_ACTIVE_HIGH>;
+  enable-active-high;
+  regulator-boot-on;
+  regulator-always-on;
+  startup-delay-us = <200000>;
+ };
+ pinmux@70000014 {
+  pinctrl-names = "default";
+  pinctrl-0 = <&wingray_panelbus_mux>;
+  wingray_panelbus_mux: panelbus-mux {
+   /* Only I2C1 pins, copied from the working P3 mux capture. */
+   i2c1 {
+    nvidia,pins = "spdi", "spdo";
+    nvidia,function = "i2c1";
+    nvidia,tristate = <0>;
+    nvidia,pull = <0>;
+   };
+  };
+ };
+ i2c@7000c000 {
+  status = "okay";
+  clock-frequency = <400000>;
+  /* Deliberately no clients: fixed readback, no backlight configuration. */
+ };
+};
diff --git a/arch/arm/configs/wingray_panelbus_defconfig b/arch/arm/configs/wingray_panelbus_defconfig
new file mode 100644
index 00000000..7e85c230
--- /dev/null
