+config MOTOROLA_WINGRAY_PERSISTENT_STORAGE
+	bool "Wingray persistent userdata/cache storage profile"
+	depends on MACH_MOTOROLA_WINGRAY && MMC_BLOCK && EXT4_FS
+	default n
+	help
+	  Enables the Android persistent-storage runtime. The boot DTB selects
+	  the driver policy; the whole eMMC stays read-only while only the
