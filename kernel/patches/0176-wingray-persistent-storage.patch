+/* Persistent Android profile: exact BigPart board only. The whole disk stays
+ * read-only; p9/p10 are explicitly released by the bootstrap after filesystem
+ * inspection. Raw MMC and partition-table ioctls remain forbidden. */
+static bool mmc_wingray_persistent_storage(struct mmc_card *card)
+{
+	struct device *parent = card->host->parent;
+
+	return of_machine_is_compatible("motorola,wingray") &&
+		mmc_card_mmc(card) &&
+		(card->host->caps & MMC_CAP_NONREMOVABLE) && parent &&
+		of_property_read_bool(parent->of_node, "motorola,xoom-bigpart") &&
+		of_property_read_bool(parent->of_node,
+				      "motorola,xoom-persistent-storage");
+}
