diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-inspect.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-inspect.dts
new file mode 100644
index 00000000..9e7766ad
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-inspect.dts
@@ -0,0 +1,10 @@
+/* GPL-2.0: read-only userdata/cache inspection image.
+ * Same kernel and hardware as the persistent image, but the bootstrap must
+ * not release either partition or start Android.
+ */
+#include "tegra20-motorola-wingray-android44-persistent.dts"
+
+/ {
+	model = "Motorola Xoom P3 Android persistent-storage read-only inspection";
+	motorola,wingray-storage-inspect;
+};
diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-write-test.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-persistent-write-test.dts
