 static int mmc_blk_ioctl(struct block_device *bdev, fmode_t mode,
 	unsigned int cmd, unsigned long arg)
 {
 	struct mmc_blk_data *md = bdev->bd_disk->private_data;
+	unsigned int partno = bdev->bd_part ? bdev->bd_part->partno : 0;
+	int ro;
 
 	/* Raw commands can program media through an O_RDONLY fd. BLKROSET
 	 * otherwise falls back to generic set_device_ro() after -EINVAL.
@@ -974,6 +1001,20 @@ static int mmc_blk_ioctl(struct block_device *bdev, fmode_t mode,
 	if ((cmd == MMC_IOC_CMD || cmd == MMC_IOC_MULTI_CMD || cmd == BLKROSET) && md &&
 	    mmc_wingray_firstboot_ro(md->queue.card))
 		return -EROFS;
+	if (md && mmc_wingray_persistent_storage(md->queue.card)) {
+		if (cmd == MMC_IOC_CMD || cmd == MMC_IOC_MULTI_CMD ||
+		    cmd == BLKPG || cmd == BLKRRPART)
+			return -EROFS;
+		if (cmd == BLKROSET) {
+			if (!arg)
+				return -EROFS; /* NULL cannot describe a policy */
+			if (get_user(ro, (int __user *)arg))
+				return -EFAULT;
+			if (ro == 0 && partno != 9 && partno != 10)
+				return -EROFS;
+			return -ENOTTY; /* generic set_device_ro */
+		}
+	}
 	switch (cmd) {
 	case MMC_IOC_CMD:
 		return mmc_blk_ioctl_cmd(bdev,
@@ -2523,6 +2564,13 @@ static struct mmc_blk_data *mmc_blk_alloc_req(struct mmc_card *card,
 		pr_info("%s: Wingray first-boot software read-only policy\n",
 			mmc_hostname(card->host));
 	}
+	if (mmc_wingray_persistent_storage(card)) {
+		/* Main disk p0 and every partition start read-only. Only p9/p10
+		 * may be released by the fixed storage helper after inspection. */
+		md->read_only = subname ? 1 : 0;
+		pr_info("%s: Wingray persistent-storage partition policy\n",
+			mmc_hostname(card->host));
+	}
 
 	md->disk = alloc_disk(perdev_minors);
 	if (md->disk == NULL) {
@@ -2547,7 +2595,8 @@ static struct mmc_blk_data *mmc_blk_alloc_req(struct mmc_card *card,
 	md->disk->private_data = md;
 	md->disk->queue = md->queue.queue;
 	md->disk->driverfs_dev = parent;
-	set_disk_ro(md->disk, md->read_only || default_ro);
+	set_disk_ro(md->disk, md->read_only || default_ro ||
+		    mmc_wingray_persistent_storage(card));
 	md->disk->flags = GENHD_FL_EXT_DEVT;
 	if (area_type & (MMC_BLK_DATA_AREA_RPMB | MMC_BLK_DATA_AREA_BOOT))
 		md->disk->flags |= GENHD_FL_NO_PART_SCAN;
