diff --git a/drivers/power/reset/wingray-power.c b/drivers/power/reset/wingray-power.c
new file mode 100644
index 00000000..632b140a
--- /dev/null
+++ b/drivers/power/reset/wingray-power.c
@@ -0,0 +1,114 @@
+/* Motorola Xoom reset/poweroff integration. GNU GPL version 2. */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mfd/motorola-cpcap.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+#include <linux/regmap.h>
+
+struct wingray_power {
+	struct regmap *regmap;
+	struct gpio_desc *restart, *poweroff;
+	struct notifier_block reboot_nb, restart_nb;
+};
+static struct wingray_power *wingray_power;
+
+static int wingray_reboot(struct notifier_block *nb, unsigned long event, void *arg)
+{
+	struct wingray_power *power = container_of(nb, struct wingray_power, reboot_nb);
+	const char *mode = arg;
+	unsigned int mask = 0x0816; /* BOOT_MODE, SOFT_RESET, FOTA_MODE, AP_KERNEL_PANIC */
+	unsigned int value = 0;
+	int ret;
+
+	if (event == SYS_RESTART && mode) {
+		if (!strcmp(mode, "recovery"))
+			value = 0x0004;
+		else if (!strcmp(mode, "bootloader"))
+			value = 0x0800;
+	}
+	ret = regmap_update_bits(power->regmap, CPCAP_REG_VAL1, mask, value);
+	if (ret)
+		pr_err("Wingray: failed to save reboot mode: %d\n", ret);
+	return NOTIFY_DONE;
+}
+
+static int wingray_restart(struct notifier_block *nb, unsigned long event, void *arg)
+{
+	struct wingray_power *power = container_of(nb, struct wingray_power, restart_nb);
+
+	/* Match the original board's CPCAP uC pulse, then let Tegra PMC reset. */
+	gpiod_set_value(power->restart, 1);
+	mdelay(100);
+	gpiod_set_value(power->restart, 0);
+	mdelay(100);
+	return NOTIFY_DONE;
+}
+
+static void wingray_poweroff(void)
+{
+	gpiod_set_value(wingray_power->poweroff, 1);
+	mdelay(3000);
+	pr_emerg("Wingray: poweroff did not complete\n");
+}
+
+static int wingray_power_probe(struct platform_device *pdev)
+{
+	struct wingray_power *power;
+	int ret;
+
+	if (wingray_power || pm_power_off)
+		return -EBUSY;
+	power = devm_kzalloc(&pdev->dev, sizeof(*power), GFP_KERNEL);
+	if (!power)
+		return -ENOMEM;
+	power->regmap = dev_get_regmap(pdev->dev.parent, NULL);
+	if (!power->regmap)
+		return -EPROBE_DEFER;
+	power->restart = devm_gpiod_get(&pdev->dev, "restart", GPIOD_OUT_LOW);
+	if (IS_ERR(power->restart))
+		return PTR_ERR(power->restart);
+	power->poweroff = devm_gpiod_get(&pdev->dev, "poweroff", GPIOD_OUT_LOW);
+	if (IS_ERR(power->poweroff))
+		return PTR_ERR(power->poweroff);
+	if (gpiod_cansleep(power->restart) || gpiod_cansleep(power->poweroff))
+		return -EINVAL;
+	power->reboot_nb.notifier_call = wingray_reboot;
+	power->restart_nb.notifier_call = wingray_restart;
+	power->restart_nb.priority = 192;
+	ret = register_reboot_notifier(&power->reboot_nb);
+	if (ret)
+		return ret;
+	ret = register_restart_handler(&power->restart_nb);
+	if (ret) {
+		unregister_reboot_notifier(&power->reboot_nb);
+		return ret;
+	}
+	platform_set_drvdata(pdev, power);
+	wingray_power = power;
+	pm_power_off = wingray_poweroff;
+	return 0;
+}
+
+static int wingray_power_remove(struct platform_device *pdev)
+{
+	struct wingray_power *power = platform_get_drvdata(pdev);
+	pm_power_off = NULL;
+	wingray_power = NULL;
+	unregister_restart_handler(&power->restart_nb);
+	unregister_reboot_notifier(&power->reboot_nb);
+	return 0;
+}
+
+static const struct of_device_id wingray_power_match[] = {
+	{ .compatible = "motorola,wingray-power" }, { }
+};
+MODULE_DEVICE_TABLE(of, wingray_power_match);
+static struct platform_driver wingray_power_driver = {
+	.probe = wingray_power_probe, .remove = wingray_power_remove,
+	.driver = { .name = "wingray-power", .of_match_table = wingray_power_match },
+};
+module_platform_driver(wingray_power_driver);
+MODULE_LICENSE("GPL v2");
