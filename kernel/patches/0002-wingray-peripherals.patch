diff --git a/arch/arm/boot/compressed/head.S b/arch/arm/boot/compressed/head.S
index d2e43b05..1629783e 100644
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -177,7 +177,14 @@ not_angel:
 
 		.text
 
-#ifdef CONFIG_AUTO_ZRELADDR
+#if defined(CONFIG_MACH_MOTOROLA_WINGRAY)
+		/* Xoom's Android boot header loads zImage at 0x10008000,
+		 * outside AUTO_ZRELADDR's first-128MiB assumption. Tegra20
+		 * RAM starts at zero, as in the original Motorola kernel.
+		 */
+		mov	r4, #0
+		add	r4, r4, #TEXT_OFFSET
+#elif defined(CONFIG_AUTO_ZRELADDR)
 		/*
 		 * Find the start of physical memory.  As we are executing
 		 * without the MMU on, we are in the physical address space.
diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-peripherals.dtsi b/arch/arm/boot/dts/tegra20-motorola-wingray-peripherals.dtsi
new file mode 100644
index 00000000..3f5f5a56
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-peripherals.dtsi
@@ -0,0 +1,215 @@
+/* MZ604 P3 / AUO board. GPIOs and power values from Motorola source and
+ * read-only capture of the working tablet. GNU GPL version 2. */
+/ {
+	aliases {
+		i2c0 = "/i2c@7000c000";
+		i2c1 = "/i2c@7000c400";
+		i2c2 = "/i2c@7000c500";
+		i2c3 = "/i2c@7000d000";
+		spi1 = "/spi@7000d400";
+	};
+	panel_power: panel-power {
+		compatible = "regulator-fixed";
+		regulator-name = "wingray-panel";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio TEGRA_GPIO(B, 2) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+		startup-delay-us = <200000>;
+	};
+	backlight_gate: backlight-gate {
+		compatible = "regulator-fixed";
+		regulator-name = "wingray-auo-backlight-enable";
+		gpio = <&gpio TEGRA_GPIO(D, 0) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+	panel: panel {
+		compatible = "motorola,wingray-auo-panel";
+		power-supply = <&panel_power>;
+		backlight = <&backlight>;
+	};
+	host1x@50000000 {
+		status = "okay";
+		dc@54200000 {
+			status = "okay";
+			rgb {
+				status = "okay";
+				nvidia,panel = <&panel>;
+			};
+		};
+		dc@54240000 { status = "disabled"; };
+		hdmi@54280000 { status = "disabled"; };
+	};
+	i2c@7000c000 {
+		status = "okay";
+		clock-frequency = <400000>;
+		backlight: backlight@2c {
+			compatible = "ti,lp8550";
+			reg = <0x2c>;
+			dev-ctrl = /bits/ 8 <0x04>;
+			init-brt = /bits/ 8 <0x80>;
+			bl-name = "lcd-backlight";
+			power-supply = <&backlight_gate>;
+		};
+		touchscreen@5b {
+			compatible = "motorola,wingray-maxtouch", "atmel,maxtouch";
+			reg = <0x5b>;
+			interrupt-parent = <&gpio>;
+			interrupts = <TEGRA_GPIO(V, 2) IRQ_TYPE_LEVEL_LOW>;
+			enable-gpios = <&gpio TEGRA_GPIO(J, 2) GPIO_ACTIVE_LOW>;
+			reset-gpios = <&gpio TEGRA_GPIO(R, 4) GPIO_ACTIVE_LOW>;
+			panel-supply = <&panel_power>;
+		};
+	};
+	i2c@7000d000 {
+		status = "okay";
+		clock-frequency = <400000>;
+		vdd_cpu: regulator@60 {
+			compatible = "maxim,max8649";
+			reg = <0x60>;
+			maxim,vid-mode = <1>;
+			maxim,ramp-timing = <0>;
+			regulator-name = "vdd_cpu";
+			regulator-min-microvolt = <770000>;
+			regulator-max-microvolt = <1100000>;
+			regulator-always-on;
+		};
+	};
+	spi@7000d400 {
+		status = "okay";
+		cpcap: pmic@0 {
+			compatible = "motorola,cpcap";
+			reg = <0>;
+			spi-max-frequency = <10000000>;
+			spi-cs-high;
+			interrupt-parent = <&lic>;
+			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;
+			regulator-controller {
+				compatible = "motorola,wingray-cpcap-regulator";
+				regulators {
+					cpcap_core: SW2 {
+						regulator-name = "core";
+						regulator-min-microvolt = <1000000>;
+						regulator-max-microvolt = <1200000>;
+						regulator-always-on;
+					};
+					cpcap_aon: SW4 {
+						regulator-name = "aon";
+						regulator-min-microvolt = <1000000>;
+						regulator-max-microvolt = <1200000>;
+						regulator-always-on;
+					};
+					cpcap_vcam: VCAM {
+						regulator-name = "vcam";
+						regulator-min-microvolt = <2900000>;
+						regulator-max-microvolt = <2900000>;
+						regulator-always-on;
+					};
+					cpcap_vcsi: VCSI {
+						regulator-name = "vcsi";
+						regulator-min-microvolt = <1200000>;
+						regulator-max-microvolt = <1200000>;
+						regulator-always-on;
+					};
+					cpcap_vdig: VDIG {
+						regulator-name = "vdig";
+						regulator-min-microvolt = <1875000>;
+						regulator-max-microvolt = <1875000>;
+						regulator-always-on;
+					};
+					cpcap_vhvio: VHVIO {
+						regulator-name = "vhvio";
+						regulator-min-microvolt = <2775000>;
+						regulator-max-microvolt = <2775000>;
+						regulator-always-on;
+					};
+					cpcap_vsdio: VSDIO {
+						regulator-name = "vsdio";
+						regulator-min-microvolt = <3000000>;
+						regulator-max-microvolt = <3000000>;
+						regulator-always-on;
+					};
+					cpcap_vpll: VPLL {
+						regulator-name = "vpll";
+						regulator-min-microvolt = <1800000>;
+						regulator-max-microvolt = <1800000>;
+						regulator-always-on;
+					};
+					cpcap_vwlan1: VWLAN1 {
+						regulator-name = "vwlan1";
+						regulator-min-microvolt = <1800000>;
+						regulator-max-microvolt = <1800000>;
+						regulator-always-on;
+					};
+					cpcap_vwlan2: VWLAN2 {
+						regulator-name = "vwlan2";
+						regulator-min-microvolt = <3300000>;
+						regulator-max-microvolt = <3300000>;
+						regulator-always-on;
+					};
+					cpcap_vusb: VUSB {
+						regulator-name = "vusb";
+						regulator-min-microvolt = <3300000>;
+						regulator-max-microvolt = <3300000>;
+						regulator-always-on;
+					};
+					cpcap_vaudio: VAUDIO {
+						regulator-name = "vaudio";
+						regulator-min-microvolt = <2775000>;
+						regulator-max-microvolt = <2775000>;
+						regulator-always-on;
+					};
+				};
+			};
+			power-controller {
+				compatible = "motorola,wingray-power";
+				restart-gpios = <&gpio TEGRA_GPIO(G, 3) GPIO_ACTIVE_LOW>;
+				poweroff-gpios = <&gpio TEGRA_GPIO(V, 7) GPIO_ACTIVE_LOW>;
+			};
+		};
+	};
+	wlan_power: wlan-power {
+		compatible = "regulator-fixed";
+		regulator-name = "wingray-wlan-io";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&cpcap_vwlan1>;
+		gpio = <&gpio TEGRA_GPIO(U, 4) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <300000>;
+	};
+	wlan_pwrseq: wlan-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpio TEGRA_GPIO(U, 2) GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <200>;
+	};
+	sdhci@c8000200 {
+		status = "okay";
+		bus-width = <4>;
+		non-removable;
+		cap-sdio-irq;
+		max-frequency = <25000000>;
+		mmc-pwrseq = <&wlan_pwrseq>;
+		vmmc-supply = <&wlan_power>;
+		vqmmc-supply = <&cpcap_vwlan1>;
+		nvidia,tap-delay = <6>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		wifi@1 {
+			compatible = "brcm,bcm4329-fmac";
+			reg = <1>;
+			interrupt-parent = <&gpio>;
+			interrupts = <TEGRA_GPIO(U, 5) IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "host-wake";
+		};
+	};
+	sdhci@c8000400 {
+		status = "okay";
+		bus-width = <4>;
+		cd-gpios = <&gpio TEGRA_GPIO(I, 5) GPIO_ACTIVE_LOW>;
+		max-frequency = <25000000>;
+		nvidia,tap-delay = <5>;
+	};
+};
diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-pinmux.dtsi b/arch/arm/boot/dts/tegra20-motorola-wingray-pinmux.dtsi
