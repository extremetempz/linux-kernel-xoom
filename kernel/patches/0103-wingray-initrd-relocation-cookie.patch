From e45db8355f0d3dd35357ef27c9b56892009bf4e4 Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sun, 25 Oct 2026 05:48:44 +1100
Subject: [PATCH] ARM: wingray: assign fresh trace identity for initrd
 relocation test

---
 .../wingray_gpu_initrd_relocated_defconfig    | 177 ++++++++++++++++++
 arch/arm/mach-tegra/wingray-gputrace.c        |   3 +-
 include/soc/tegra/wingray-smptrace.h          |   3 +-
 init/initramfs.c                              |  18 +-
 init/main.c                                   |   3 +-
 5 files changed, 195 insertions(+), 9 deletions(-)
 create mode 100644 arch/arm/configs/wingray_gpu_initrd_relocated_defconfig

diff --git a/arch/arm/configs/wingray_gpu_initrd_relocated_defconfig b/arch/arm/configs/wingray_gpu_initrd_relocated_defconfig
new file mode 100644
index 00000000..fb58482e
--- /dev/null
+++ b/arch/arm/configs/wingray_gpu_initrd_relocated_defconfig
@@ -0,0 +1,177 @@
+CONFIG_LOCALVERSION="-wingray-gpu-trace"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_EXPERT=y
+CONFIG_KALLSYMS=y
+CONFIG_PRINTK_TIME=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_ARCH_TEGRA=y
+CONFIG_ARCH_TEGRA_2x_SOC=y
+# CONFIG_ARCH_TEGRA_3x_SOC is not set
+# CONFIG_ARCH_TEGRA_114_SOC is not set
+# CONFIG_ARCH_TEGRA_124_SOC is not set
+CONFIG_MACH_MOTOROLA_WINGRAY=y
+# CONFIG_MACH_SAMSUNG_VARIATION_TEGRA is not set
+# CONFIG_MACH_SAMSUNG_P4WIFI is not set
+CONFIG_SMP=y
+CONFIG_SMP_ON_UP=y
+CONFIG_NR_CPUS=2
+# CONFIG_HOTPLUG_CPU is not set
+CONFIG_CACHE_L2X0=y
+CONFIG_HIGHMEM=y
+CONFIG_AEABI=y
+CONFIG_SWP_EMULATE=y
+CONFIG_VFP=y
+# CONFIG_NEON is not set
+# CONFIG_CPU_FREQ is not set
+# CONFIG_CPU_IDLE is not set
+# CONFIG_SUSPEND is not set
+CONFIG_ARM_APPENDED_DTB=y
+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE_NAMES="tegra20-motorola-wingray-gpu-test"
+CONFIG_CMDLINE="console=ttyS0,115200n8 ignore_loglevel loglevel=8 initcall_debug clk_ignore_unused regulator_ignore_unused ro panic=0 maxcpus=2"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_PROC_FS=y
+CONFIG_SYSFS=y
+CONFIG_TMPFS=y
+CONFIG_BLOCK=y
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_EFI_PARTITION=y
+CONFIG_MOTOROLA_XOOM_BIGPART=y
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_BLOCK_MINORS=32
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SDHCI_TEGRA=y
+CONFIG_EXT4_FS=y
+CONFIG_USB=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_CHIPIDEA=y
+CONFIG_USB_CHIPIDEA_UDC=y
+CONFIG_USB_TEGRA_PHY=y
+CONFIG_USB_G_SERIAL=y
+CONFIG_NET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_IPV6=y
+# CONFIG_NETDEVICES is not set
+# CONFIG_WIRELESS is not set
+# CONFIG_CFG80211 is not set
+# Only the factory-preserving P3 maXTouch input path is added.
+CONFIG_INPUT=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_INPUT_TOUCHSCREEN=y
+CONFIG_TOUCHSCREEN_ATMEL_MXT=y
+# CONFIG_TOUCHSCREEN_MXT1386 is not set
+# CONFIG_SAMSUNG_INPUT is not set
+# CONFIG_INPUT_LEDS is not set
+# CONFIG_INPUT_MOUSEDEV is not set
+# CONFIG_INPUT_JOYDEV is not set
+# CONFIG_INPUT_KEYBOARD is not set
+# CONFIG_INPUT_MOUSE is not set
+# CONFIG_INPUT_JOYSTICK is not set
+# CONFIG_INPUT_TABLET is not set
+# CONFIG_INPUT_MISC is not set
+# CONFIG_SERIO is not set
+# CONFIG_GAMEPORT is not set
+# CONFIG_HID is not set
+# CONFIG_USB_HID is not set
+# CONFIG_VT is not set
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_8250_NR_UARTS=5
+CONFIG_SERIAL_8250_RUNTIME_UARTS=5
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_FS=y
+# CONFIG_DEBUG_LL is not set
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_I2C=y
+CONFIG_I2C_TEGRA=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_BACKLIGHT_LP855X=y
+
+# CONFIG_DRM is not set
+# CONFIG_DRM_TEGRA is not set
+# CONFIG_DRM_TEGRA_FBDEV is not set
+# CONFIG_DRM_PANEL_SIMPLE is not set
+CONFIG_BACKLIGHT_LCD_SUPPORT=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_PWM=y
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=16
+
+# Installed Android 4.4 userspace ABI; separate from the future Oreo ABI.
+CONFIG_ANDROID=y
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDER_DEVICES="binder"
+CONFIG_ANDROID_BINDER_IPC_32BIT=y
+CONFIG_STAGING=y
+CONFIG_ASHMEM=y
+CONFIG_ANDROID_LOGGER=y
+# CONFIG_ANDROID_TIMED_OUTPUT is not set
+CONFIG_ANDROID_LOW_MEMORY_KILLER=y
+CONFIG_SYNC=y
+# CONFIG_SW_SYNC is not set
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_FUSE_FS=y
+CONFIG_INOTIFY_USER=y
+# CONFIG_MOTOROLA_XOOM_BOOT_TRACE is not set
+
+# Isolated Decatf nvmap backing-ownership experiment; no engine or DC access.
+CONFIG_MEMORY=y
+# CONFIG_TEGRA20_MC is not set
+# CONFIG_TEGRA_HOST1X is not set
+# CONFIG_IOMMU_SUPPORT is not set
+# CONFIG_IOMMU_API is not set
+# CONFIG_TEGRA_IOMMU_GART is not set
+CONFIG_TEGRA_DOWNSTREAM=y
+CONFIG_TEGRA_NVMAP=y
+# CONFIG_TEGRA_NVMAP_WINGRAY_RESOURCES is not set
+# CONFIG_TEGRA_RPC is not set
+# CONFIG_TEGRA_AVP is not set
+# CONFIG_TEGRA_AVP_KERNEL_ON_MMU is not set
+# CONFIG_TEGRA_MEDIASERVER is not set
+# CONFIG_TEGRA_IOVMM_GART is not set
+# CONFIG_TEGRA_IOVMM is not set
+CONFIG_TEGRA_GRHOST=y
+# CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST is not set
+CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST=y
+CONFIG_TEGRA_GRHOST_WINGRAY_LEGACY_SUBMIT=y
+CONFIG_TEGRA_SEMA_STANDALONE=y
+# CONFIG_TEGRA_DC is not set
+# CONFIG_FB_TEGRA is not set
+# CONFIG_TEGRA_DC_EXTENSIONS is not set
+# CONFIG_TEGRA_OVERLAY is not set
+# CONFIG_FB_TEGRA_WINGRAY_LEGACY is not set
+# CONFIG_FB_TEGRA_CMC623 is not set
+# CONFIG_NVMAP_ALLOW_SYSMEM is not set
+# CONFIG_NVMAP_RECLAIM_UNPINNED_VM is not set
+# CONFIG_NVMAP_HIGHMEM_ONLY is not set
+# CONFIG_NVMAP_CONVERT_CARVEOUT_TO_IOVMM is not set
+# CONFIG_NVMAP_CARVEOUT_KILLER is not set
+# CONFIG_NVMAP_CARVEOUT_COMPACTOR is not set
+# CONFIG_NVMAP_PAGE_POOLS is not set
+
+# Reserved-RAM startup localization only; no userspace GPU submission.
+CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE=y
+CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE=0x584d0053
diff --git a/arch/arm/mach-tegra/wingray-gputrace.c b/arch/arm/mach-tegra/wingray-gputrace.c
index 074ac4b0..48ce0fe4 100644
--- a/arch/arm/mach-tegra/wingray-gputrace.c
+++ b/arch/arm/mach-tegra/wingray-gputrace.c
@@ -55,7 +55,8 @@ static int wingray_trace_panic(struct notifier_block *nb,
 {
 #if CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0050 || \
  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0051 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052
+  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053)
 	/* panic() supplies its bounded, NUL-terminated formatted buffer.
 	 * Publish the panic flag only after the 20-byte prefix. */
 	const unsigned char *text = data;
diff --git a/include/soc/tegra/wingray-smptrace.h b/include/soc/tegra/wingray-smptrace.h
index 0cfd1395..30001b28 100644
--- a/include/soc/tegra/wingray-smptrace.h
+++ b/include/soc/tegra/wingray-smptrace.h
@@ -23,7 +23,8 @@ static inline void wingray_smptrace_mark(unsigned int offset, u32 value)
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0050 || \
   CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0051 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052)
+  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053))
      offset > 0x7c ||
 #elif defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE)
      offset > 0x68 ||
diff --git a/init/initramfs.c b/init/initramfs.c
index 56df7ca9..72e89282 100644
--- a/init/initramfs.c
+++ b/init/initramfs.c
@@ -618,7 +618,8 @@ static int __init skip_initramfs_param(char *str)
 __setup("skip_initramfs", skip_initramfs_param);
 
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
- CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052
+ (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053)
 /* Bounded input fingerprint only; no mapped addresses or writable interface. */
 static u32 __init wingray_initrd_fingerprint(const unsigned char *p,
 		unsigned long len)
@@ -634,14 +635,16 @@ static int __init populate_rootfs(void)
 {
 	char *err;
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
- CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052
+ (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053)
 	u32 initrd_fingerprint = 0;
 	unsigned long initrd_bytes = 0;
 #endif
 
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0051 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052)
+  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053))
 	/* This RAM-only diagnostic cannot use a disk-root fallback. */
 	if (do_skip_initramfs)
 		panic("XOOM initrd skipped");
@@ -659,7 +662,8 @@ static int __init populate_rootfs(void)
 		panic("%s", err); /* Failed to decompress INTERNAL initramfs */
 	if (initrd_start) {
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
- CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052
+ (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053)
 		initrd_bytes = initrd_end - initrd_start;
 		/* Reject an implausible region before the extra diagnostic read. */
 		if (!initrd_bytes || initrd_bytes > 16 * 1024 * 1024)
@@ -703,9 +707,11 @@ static int __init populate_rootfs(void)
 			initrd_end - initrd_start);
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0051 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052)
+  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053))
 		if (err) {
-#if CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052
+#if (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053)
 			/* Exactly 20 prefix bytes retain the complete pair. */
 			panic("RD %08x %08lx", initrd_fingerprint, initrd_bytes);
 #else
diff --git a/init/main.c b/init/main.c
index 616e8178..fb9b5937 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1081,7 +1081,8 @@ static noinline void __init kernel_init_freeable(void)
 
 #if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && \
  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0051 || \
-  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052)
+  (CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0052 || \
+  CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0053))
 	{
 		int access_result = sys_access((const char __user *)
 				ramdisk_execute_command, 0);
-- 
2.43.0

