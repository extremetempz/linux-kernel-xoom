diff --git a/kernel/power/main.c b/kernel/power/main.c
index 154886eb..00b6bdfc 100644
--- a/kernel/power/main.c
+++ b/kernel/power/main.c
@@ -748,11 +748,92 @@ static ssize_t wingray_dpm_test_store(struct kobject *kobj,
 static struct kobj_attribute wingray_dpm_test_attr =
 	__ATTR(wingray_dpm_test, 0600, wingray_dpm_test_show,
 	       wingray_dpm_test_store);
+
+static DEFINE_MUTEX(wingray_stage_lock);
+static unsigned int wingray_late_completed, wingray_syscore_completed;
+static int wingray_late_result, wingray_syscore_result;
+
+static ssize_t wingray_stage_show(struct kobject *kobj,
+				  struct kobj_attribute *attr, char *buf,
+				  unsigned int completed, int result,
+				  const char *name)
+{
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	if (!mutex_trylock(&wingray_stage_lock))
+		return -EBUSY;
+	scnprintf(buf, PAGE_SIZE,
+		"completed=%u last_result=%d selected=%s whole_tree=1 platform_entry=0 cpu_sleep=0 ordinary_sleep=blocked\n",
+		completed, result, name);
+	mutex_unlock(&wingray_stage_lock);
+	return strlen(buf);
+}
+
+static ssize_t wingray_late_show(struct kobject *kobj,
+				 struct kobj_attribute *attr, char *buf)
+{
+	return wingray_stage_show(kobj, attr, buf, wingray_late_completed,
+				  wingray_late_result, "late");
+}
+
+static ssize_t wingray_late_store(struct kobject *kobj,
+				  struct kobj_attribute *attr, const char *buf,
+				  size_t count)
+{
+	int ret;
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!mutex_trylock(&wingray_stage_lock))
+		return -EBUSY;
+	ret = wingray_pm_late_test();
+	wingray_late_result = ret;
+	if (!ret)
+		wingray_late_completed++;
+	mutex_unlock(&wingray_stage_lock);
+	return ret ? ret : count;
+}
+
+static ssize_t wingray_syscore_show(struct kobject *kobj,
+				    struct kobj_attribute *attr, char *buf)
+{
+	return wingray_stage_show(kobj, attr, buf, wingray_syscore_completed,
+				  wingray_syscore_result, "syscore");
+}
+
+static ssize_t wingray_syscore_store(struct kobject *kobj,
+				     struct kobj_attribute *attr,
+				     const char *buf, size_t count)
+{
+	int ret;
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!mutex_trylock(&wingray_stage_lock))
+		return -EBUSY;
+	ret = wingray_pm_syscore_test();
+	wingray_syscore_result = ret;
+	if (!ret)
+		wingray_syscore_completed++;
+	mutex_unlock(&wingray_stage_lock);
+	return ret ? ret : count;
+}
+
+static struct kobj_attribute wingray_late_test_attr =
+	__ATTR(wingray_late_test, 0600, wingray_late_show,
+	       wingray_late_store);
+static struct kobj_attribute wingray_syscore_test_attr =
+	__ATTR(wingray_syscore_test, 0600, wingray_syscore_show,
+	       wingray_syscore_store);
 #endif
 
