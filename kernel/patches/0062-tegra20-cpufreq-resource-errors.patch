From 77d1c0ed13cfd7d8ed7039f8d60549048b33660d Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Fri, 23 Oct 2026 15:57:04 +1100
Subject: [PATCH] cpufreq: tegra20: balance clock acquisition and prepare
 failures

---
 drivers/cpufreq/tegra20-cpufreq.c | 60 ++++++++++++++++++++++---------
 1 file changed, 44 insertions(+), 16 deletions(-)

diff --git a/drivers/cpufreq/tegra20-cpufreq.c b/drivers/cpufreq/tegra20-cpufreq.c
index d83f506f..93761066 100644
--- a/drivers/cpufreq/tegra20-cpufreq.c
+++ b/drivers/cpufreq/tegra20-cpufreq.c
@@ -82,7 +82,9 @@ static int tegra_target_intermediate(struct cpufreq_policy *policy,
 	 * Also, we wouldn't be using pll_x anymore and must not take extra
 	 * reference to it, as it can be disabled now to save some power.
 	 */
-	clk_prepare_enable(pll_x_clk);
+	ret = clk_prepare_enable(pll_x_clk);
+	if (ret)
+		return ret;
 
 	ret = clk_set_parent(cpu_clk, pll_p_clk);
 	if (ret)
@@ -147,16 +149,17 @@ static int tegra_cpu_init(struct cpufreq_policy *policy)
 	if (policy->cpu >= NUM_CPUS)
 		return -EINVAL;
 
-	clk_prepare_enable(emc_clk);
-	clk_prepare_enable(cpu_clk);
+	ret = clk_prepare_enable(emc_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(cpu_clk);
+	if (ret)
+		goto disable_emc;
 
 	/* FIXME: what's the actual transition time? */
 	ret = cpufreq_generic_init(policy, freq_table, 300 * 1000);
-	if (ret) {
-		clk_disable_unprepare(cpu_clk);
-		clk_disable_unprepare(emc_clk);
-		return ret;
-	}
+	if (ret)
+		goto disable_cpu;
 
 	policy->clk = cpu_clk;
 	policy->suspend_freq = freq_table[0].frequency;
@@ -166,6 +169,12 @@ static int tegra_cpu_init(struct cpufreq_policy *policy)
 	// policy->cpuinfo.max_freq = 2000000;
 
 	return 0;
+
+disable_cpu:
+	clk_disable_unprepare(cpu_clk);
+disable_emc:
+	clk_disable_unprepare(emc_clk);
+	return ret;
 }
 
 static int tegra_cpu_exit(struct cpufreq_policy *policy)
@@ -191,31 +200,50 @@ static struct cpufreq_driver tegra_cpufreq_driver = {
 
 static int __init tegra_cpufreq_init(void)
 {
+	int ret;
+
 	cpu_clk = clk_get_sys(NULL, "cclk");
 	if (IS_ERR(cpu_clk))
 		return PTR_ERR(cpu_clk);
 
 	pll_x_clk = clk_get_sys(NULL, "pll_x");
-	if (IS_ERR(pll_x_clk))
-		return PTR_ERR(pll_x_clk);
+	if (IS_ERR(pll_x_clk)) {
+		ret = PTR_ERR(pll_x_clk);
+		goto put_cpu;
+	}
 
 	pll_p_clk = clk_get_sys(NULL, "pll_p");
-	if (IS_ERR(pll_p_clk))
-		return PTR_ERR(pll_p_clk);
+	if (IS_ERR(pll_p_clk)) {
+		ret = PTR_ERR(pll_p_clk);
+		goto put_pll_x;
+	}
 
 	emc_clk = clk_get_sys("cpu", "emc");
 	if (IS_ERR(emc_clk)) {
-		clk_put(cpu_clk);
-		return PTR_ERR(emc_clk);
+		ret = PTR_ERR(emc_clk);
+		goto put_pll_p;
 	}
 
-	return cpufreq_register_driver(&tegra_cpufreq_driver);
+	ret = cpufreq_register_driver(&tegra_cpufreq_driver);
+	if (!ret)
+		return 0;
+
+	clk_put(emc_clk);
+put_pll_p:
+	clk_put(pll_p_clk);
+put_pll_x:
+	clk_put(pll_x_clk);
+put_cpu:
+	clk_put(cpu_clk);
+	return ret;
 }
 
 static void __exit tegra_cpufreq_exit(void)
 {
-        cpufreq_unregister_driver(&tegra_cpufreq_driver);
+	cpufreq_unregister_driver(&tegra_cpufreq_driver);
 	clk_put(emc_clk);
+	clk_put(pll_p_clk);
+	clk_put(pll_x_clk);
 	clk_put(cpu_clk);
 }
 
-- 
2.43.0

