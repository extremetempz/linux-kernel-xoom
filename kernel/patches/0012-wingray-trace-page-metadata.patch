From 66d8f580a1659a6c16df4cb2acfe1964f5bf3369 Mon Sep 17 00:00:00 2001
From: Xoom kernel port work
Date: Mon, 19 Oct 2026 17:27:33 +1100
Subject: [PATCH] ARM: tegra: sample page metadata steps without changing
 atomics

---
 arch/arm/configs/wingray_trace_defconfig |  2 +-
 mm/page_alloc.c                          | 25 ++++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/arch/arm/configs/wingray_trace_defconfig b/arch/arm/configs/wingray_trace_defconfig
index 6e217b1e..3fea56d4 100644
--- a/arch/arm/configs/wingray_trace_defconfig
+++ b/arch/arm/configs/wingray_trace_defconfig
@@ -53,4 +53,4 @@ CONFIG_PSTORE=y
 CONFIG_PSTORE_CONSOLE=y
 CONFIG_PSTORE_RAM=y
 CONFIG_MOTOROLA_XOOM_BOOT_TRACE=y
-CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE=0x584d0006
+CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE=0x584d0007
diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index cc5da74e..5d4a7375 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -77,8 +77,15 @@ static noinline void wingray_alloc_trace(unsigned int phase)
 		wingray_boottrace_mapped_mark(WINGRAY_TRACE_STATIC_VIRT,
 					WINGRAY_TRACE_PHASE, phase);
 }
+/* Four PFNs per 1024-page interval: bounded overhead, plus block starts. */
+#define wingray_page_trace(step, pfn) do { \
+	if (((pfn) & 1023UL) < 4) \
+		wingray_alloc_trace(0x80000000U | ((step) << 24) | \
+				    ((pfn) & 0x00ffffffUL)); \
+} while (0)
 #else
 #define wingray_alloc_trace(phase) do { } while (0)
+#define wingray_page_trace(step, pfn) do { } while (0)
 #endif
 
 /* prevent >1 _updater_ of zone percpu pageset ->high and ->batch fields */
@@ -961,12 +968,18 @@ out:
 static void __meminit __init_single_page(struct page *page, unsigned long pfn,
 				unsigned long zone, int nid)
 {
+	wingray_page_trace(8, pfn);
 	set_page_links(page, zone, nid, pfn);
+	wingray_page_trace(9, pfn);
 	init_page_count(page);
+	wingray_page_trace(10, pfn);
 	page_mapcount_reset(page);
+	wingray_page_trace(11, pfn);
 	page_cpupid_reset_last(page);
+	wingray_page_trace(12, pfn);
 
 	INIT_LIST_HEAD(&page->lru);
+	wingray_page_trace(13, pfn);
 #ifdef WANT_PAGE_VIRTUAL
 	/* The shift won't overflow because ZONE_NORMAL is below 4G. */
 	if (!is_highmem_idx(zone))
@@ -4563,11 +4576,14 @@ void __meminit memmap_init_zone(unsigned long size, int nid, unsigned long zone,
 	struct zone *z;
 	unsigned long nr_initialised = 0;
 
+	wingray_alloc_trace(0x701);
 	if (highest_memmap_pfn < end_pfn - 1)
 		highest_memmap_pfn = end_pfn - 1;
 
 	z = &pgdat->node_zones[zone];
+	wingray_alloc_trace(0x702);
 	for (pfn = start_pfn; pfn < end_pfn; pfn++) {
+		wingray_page_trace(1, pfn);
 		/*
 		 * There can be holes in boot-time mem_map[]s
 		 * handed to this function.  They do not
@@ -4583,6 +4599,8 @@ void __meminit memmap_init_zone(unsigned long size, int nid, unsigned long zone,
 				break;
 		}
 
+		wingray_page_trace(2, pfn);
+
 		/*
 		 * Mark the block movable so that blocks are reserved for
 		 * movable at startup. This will force kernel allocations
@@ -4598,12 +4616,19 @@ void __meminit memmap_init_zone(unsigned long size, int nid, unsigned long zone,
 		if (!(pfn & (pageblock_nr_pages - 1))) {
 			struct page *page = pfn_to_page(pfn);
 
+			wingray_page_trace(3, pfn);
 			__init_single_page(page, pfn, zone, nid);
+			wingray_page_trace(4, pfn);
+			wingray_page_trace(5, pfn);
 			set_pageblock_migratetype(page, MIGRATE_MOVABLE);
+			wingray_page_trace(6, pfn);
 		} else {
+			wingray_page_trace(3, pfn);
 			__init_single_pfn(pfn, zone, nid);
+			wingray_page_trace(4, pfn);
 		}
 	}
+	wingray_alloc_trace(0x703);
 }
 
 static void __meminit zone_init_free_lists(struct zone *zone)
-- 
2.43.0

