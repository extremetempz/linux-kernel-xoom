 	switch (mode) {
 	case TEGRA_SUSPEND_LP1:
@@ -357,7 +380,9 @@ static int tegra_suspend_enter(suspend_state_t state)
 
 	local_fiq_enable();
 
-	return 0;
+	if (ret)
