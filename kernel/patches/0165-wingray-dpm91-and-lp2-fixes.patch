 static int tegra_sleep_cpu(unsigned long v2p)
 {
+	/*
+	 * LP2 powers down the CPU complex and disables the PL310.  The generic
+	 * cpu_suspend path only cleans the CPU context; clean all L1 data and
+	 * then clean/invalidate/disable the outer cache before the MMU-off
+	 * sequence.  CPU1 must already be offline and DMA must be quiescent.
