-		    mode >= TEGRA_MAX_SUSPEND_MODE))
+	/* LP0 is not implemented by this platform path.  Do not treat a
+	 * NONE/unknown mode as a successful suspend. */
+	if (WARN_ON(mode != TEGRA_SUSPEND_LP1 && mode != TEGRA_SUSPEND_LP2))
+		return -EINVAL;
