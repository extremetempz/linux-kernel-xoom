+	if (mode == TEGRA_SUSPEND_LP1)
+		pr_info("Entering suspend state %s\n", lp_state[mode]);
+	else
+		pr_info("Entering suspend state %s\n", lp_state[mode]);
 
 	tegra_pm_set(mode);
 
