diff --git a/arch/arm/mach-tegra/Kconfig b/arch/arm/mach-tegra/Kconfig
index 1159598c..4604ad72 100644
--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -90,6 +90,17 @@ config MOTOROLA_WINGRAY_FREEZER_TEST
 	  preparation/notifiers and thawing, stops before device callbacks,
 	  and never enters CPU/platform sleep. Ordinary suspend stays blocked.
 
+config MOTOROLA_WINGRAY_DEVICEPM_TEST
+	bool "Wingray CPCAP driver PM callback test (CPU sleep blocked)"
+	depends on MOTOROLA_WINGRAY_FREEZER_TEST
+	depends on MFD_CPCAP=y && MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
+	default n
+	help
+	  Freeze tasks using the existing preparation path, then exercise only
+	  CPCAP suspend/resume through generic driver PM dispatch. SPI parents,
+	  normal IRQ delivery and CPUs remain running. Does not run whole-tree
+	  DPM, late/noirq, CPU hotplug, syscore or Tegra platform entry.
+
 config MOTOROLA_XOOM_GPU_STARTUP_TRACE
 	bool "Wingray retained GPU startup checkpoints (no rendering test)"
 	depends on TEGRA_GRHOST_WINGRAY_GPU_TEST && SMP && !THUMB2_KERNEL
diff --git a/drivers/mfd/motorola-cpcap.c b/drivers/mfd/motorola-cpcap.c
index cdedce31..a9bd2b86 100644
--- a/drivers/mfd/motorola-cpcap.c
+++ b/drivers/mfd/motorola-cpcap.c
@@ -19,6 +19,8 @@
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
 #include <linux/pm_wakeup.h>
+#include <linux/pm.h>
+#include <linux/wingray_pm_prepare.h>
 #include <linux/regmap.h>
 #include <linux/workqueue.h>
 #include <linux/sysfs.h>
@@ -49,6 +51,9 @@ struct cpcap_ddata {
 #ifdef CONFIG_MFD_CPCAP_WINGRAY_WAKE_ARM_TEST
 	struct mutex wake_arm_lock;
 	bool wake_arm_owned;
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+	bool pm_test_active, pm_cycle_owned;
+#endif
 	int wake_arm_error, wake_arm_cleanup_error;
 #endif
 };
@@ -856,9 +861,119 @@ static int cpcap_probe(struct spi_device *spi)
 	return ret;
 }
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+/* These callbacks only acquire/release a wake vote. No PMIC mask, ACK,
+ * rail, voltage or SPI transport changes. Normal IRQ handling stays live.
+ * Full-tree PM ordering and hardware wake are deliberately not tested here.
+ */
+static int cpcap_wingray_pm_suspend(struct device *dev)
+{
+	struct cpcap_ddata *cpcap = dev_get_drvdata(dev);
+	int ret;
+
+	if (!wingray_pm_prepare_only() || !cpcap->pm_test_active)
+		return -EOPNOTSUPP;
+	if (!mutex_trylock(&cpcap->wake_arm_lock))
+		return -EBUSY;
+	/* Never borrow or release an awake manual test's wake reference. */
+	if (cpcap->wake_arm_owned || cpcap->pm_cycle_owned) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = cpcap_wingray_set_wake_arm(cpcap, true);
+	/* Also track a reference retained after a failed arm rollback. */
+	cpcap->pm_cycle_owned = cpcap->wake_arm_owned;
+	dev_info(dev, "WG_PM90_CPCAP_SUSPEND result=%d owned=%u\n",
+		 ret, cpcap->pm_cycle_owned);
+out:
+	mutex_unlock(&cpcap->wake_arm_lock);
+	return ret;
+}
+
+static int cpcap_wingray_pm_resume(struct device *dev)
+{
+	struct cpcap_ddata *cpcap = dev_get_drvdata(dev);
+	int ret = 0;
+
+	if (!wingray_pm_prepare_only() || !cpcap->pm_test_active)
+		return -EOPNOTSUPP;
+	if (!mutex_trylock(&cpcap->wake_arm_lock))
+		return -EBUSY;
+	if (cpcap->pm_cycle_owned) {
+		ret = cpcap_wingray_set_wake_arm(cpcap, false);
+		if (!ret)
+			cpcap->pm_cycle_owned = false;
+	}
+	dev_info(dev, "WG_PM90_CPCAP_RESUME result=%d owned=%u\n",
+		 ret, cpcap->pm_cycle_owned);
+	mutex_unlock(&cpcap->wake_arm_lock);
+	return ret;
+}
+
+static const struct dev_pm_ops cpcap_wingray_test_pm_ops = {
+	.suspend = cpcap_wingray_pm_suspend,
+	.resume = cpcap_wingray_pm_resume,
+};
+
+static int cpcap_wingray_pm_match(struct device *dev, void *unused)
+{
+	return of_device_is_compatible(dev->of_node, "motorola,cpcap") &&
+		dev->driver && dev->driver->pm == &cpcap_wingray_test_pm_ops;
+}
+
+/* One selected driver's normal-phase callbacks via existing generic PM
+ * dispatch. This is NOT dpm_suspend_start(), a whole-tree PM test, or proof
+ * of parent/child late/noirq ordering. Keep the SPI parent and CPUs active.
+ */
+int wingray_cpcap_devicepm_test(void)
+{
+	struct device *dev;
+	struct cpcap_ddata *cpcap;
+	int ret, cleanup;
+
+	if (!wingray_pm_prepare_only())
+		return -EOPNOTSUPP;
+	dev = bus_find_device(&spi_bus_type, NULL, NULL, cpcap_wingray_pm_match);
+	if (!dev)
+		return -ENODEV;
+	/* A frozen task must never be needed to release a device lock. */
+	if (!device_trylock(dev)) {
+		ret = -EBUSY;
+		goto put;
+	}
+	if (!cpcap_wingray_pm_match(dev, NULL)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	cpcap = dev_get_drvdata(dev);
+	if (cpcap->pm_test_active || cpcap->pm_cycle_owned) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	cpcap->pm_test_active = true;
+	ret = pm_generic_suspend(dev);
+	/* Resume also unwinds this cycle's reference on suspend failure.
+	 * It cannot release a pre-existing owner's reference.
+	 */
+	cleanup = pm_generic_resume(dev);
+	cpcap->pm_test_active = false;
+	dev_info(dev, "WG_PM90_CPCAP_COMPLETE suspend=%d resume=%d\n", ret, cleanup);
+	if (cleanup)
+		ret = cleanup;
+unlock:
+	device_unlock(dev);
+put:
+	put_device(dev);
+	return ret;
+}
+#endif
+
 static struct spi_driver cpcap_driver = {
 	.driver = {
 		.name = "cpcap-core",
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+		.pm = &cpcap_wingray_test_pm_ops,
+#endif
 		.of_match_table = cpcap_of_match,
 	},
 	.probe = cpcap_probe,
diff --git a/include/linux/wingray_pm_prepare.h b/include/linux/wingray_pm_prepare.h
index cf92de05..91289e7d 100644
--- a/include/linux/wingray_pm_prepare.h
+++ b/include/linux/wingray_pm_prepare.h
@@ -3,11 +3,23 @@
 #define _LINUX_WINGRAY_PM_PREPARE_H
 #include <linux/kconfig.h>
 #include <linux/of.h>
+#include <linux/errno.h>
 static inline bool wingray_pm_prepare_only(void)
 {
 	return IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_PM_PREPARE) &&
 		of_machine_is_compatible("motorola,wingray");
 }
+enum wingray_pm_test_mode {
+	WINGRAY_PM_TEST_NONE,
+	WINGRAY_PM_TEST_FREEZER,
+	WINGRAY_PM_TEST_CPCAP,
+};
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+int wingray_pm_device_test(void);
+int wingray_cpcap_devicepm_test(void);
+#else
+static inline int wingray_cpcap_devicepm_test(void) { return -EOPNOTSUPP; }
+#endif
 #ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
 int wingray_pm_freezer_test(void);
 #endif
diff --git a/kernel/power/main.c b/kernel/power/main.c
index 23744a51..6f558aba 100644
--- a/kernel/power/main.c
+++ b/kernel/power/main.c
@@ -655,7 +655,58 @@ static struct kobj_attribute wingray_freezer_test_attr =
 	       wingray_freezer_test_store);
 #endif
 
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+static DEFINE_MUTEX(wingray_devicepm_lock);
+static unsigned int wingray_devicepm_completed;
+static int wingray_devicepm_result;
+
+static ssize_t wingray_devicepm_test_show(struct kobject *kobj,
+				struct kobj_attribute *attr, char *buf)
+{
+	int ret;
+
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	/* Readers must not block behind the test while tasks are freezing. */
+	if (!mutex_trylock(&wingray_devicepm_lock))
+		return -EBUSY;
+	ret = scnprintf(buf, PAGE_SIZE,
+		"completed=%u last_result=%d selected=cpcap whole_tree=0 cpu_sleep=0 ordinary_sleep=blocked\n",
+		wingray_devicepm_completed, wingray_devicepm_result);
+	mutex_unlock(&wingray_devicepm_lock);
+	return ret;
+}
+
+static ssize_t wingray_devicepm_test_store(struct kobject *kobj,
+		struct kobj_attribute *attr, const char *buf, size_t count)
+{
+	int ret;
+
+	if (!wingray_pm_prepare_only())
+		return -ENODEV;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	/* Do not queue competing tests or hold another task across freeze. */
+	if (!mutex_trylock(&wingray_devicepm_lock))
+		return -EBUSY;
+	ret = wingray_pm_device_test();
+	wingray_devicepm_result = ret;
+	if (!ret)
+		wingray_devicepm_completed++;
+	mutex_unlock(&wingray_devicepm_lock);
+	if (ret)
+		return ret;
+	return count;
+}
+static struct kobj_attribute wingray_devicepm_test_attr =
+	__ATTR(wingray_devicepm_test, 0600, wingray_devicepm_test_show,
+	       wingray_devicepm_test_store);
+#endif
+
 static struct attribute * g[] = {
+#ifdef CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST
+	&wingray_devicepm_test_attr.attr,
+#endif
 #ifdef CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST
 	&wingray_freezer_test_attr.attr,
 #endif
diff --git a/kernel/power/suspend.c b/kernel/power/suspend.c
index d63a20bc..0052f3a1 100644
--- a/kernel/power/suspend.c
+++ b/kernel/power/suspend.c
@@ -488,15 +488,20 @@ static void suspend_finish(void)
  * Fail if that's not the case.  Otherwise, prepare for system suspend, make the
  * system enter the given sleep state and clean up after wakeup.
  */
-static int enter_state(suspend_state_t state, bool freezer_only)
+static int enter_state(suspend_state_t state, enum wingray_pm_test_mode test_mode)
 {
 	int error;
 
-	if (freezer_only &&
+	if (test_mode != WINGRAY_PM_TEST_NONE &&
 	    (!IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_FREEZER_TEST) ||
 	     !wingray_pm_prepare_only() || state != PM_SUSPEND_FREEZE))
 		return -EOPNOTSUPP;
 
+	if (test_mode < WINGRAY_PM_TEST_NONE || test_mode > WINGRAY_PM_TEST_CPCAP ||
+	    (test_mode == WINGRAY_PM_TEST_CPCAP &&
+	     !IS_ENABLED(CONFIG_MOTOROLA_WINGRAY_DEVICEPM_TEST)))
+		return -EOPNOTSUPP;
+
 	trace_suspend_resume(TPS("suspend_enter"), state, true);
 	if (state == PM_SUSPEND_FREEZE) {
 #ifdef CONFIG_PM_DEBUG
@@ -514,7 +519,7 @@ static int enter_state(suspend_state_t state, bool freezer_only)
 
 #ifdef CONFIG_PM_DEBUG
 	/* Serialized with pm_test_store; do not alter the global test mode. */
-	if (freezer_only && pm_test_level != TEST_NONE) {
+	if (test_mode != WINGRAY_PM_TEST_NONE && pm_test_level != TEST_NONE) {
 		error = -EBUSY;
 		goto Unlock;
 	}
@@ -537,7 +542,14 @@ static int enter_state(suspend_state_t state, bool freezer_only)
 	if (error)
 		goto Unlock;
 
-	if (freezer_only) {
+	if (test_mode == WINGRAY_PM_TEST_CPCAP) {
+		pr_info("WG_PM90_FREEZER_COMPLETE selected=cpcap cpu_sleep=0\n");
+		pm_restrict_gfp_mask();
+		error = wingray_cpcap_devicepm_test();
+		pm_restore_gfp_mask();
+		goto Finish;
