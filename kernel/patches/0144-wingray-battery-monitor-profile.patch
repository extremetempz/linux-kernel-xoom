diff --git a/drivers/power/wingray_battery_monitor.c b/drivers/power/wingray_battery_monitor.c
new file mode 100644
index 00000000..afc5a52d
--- /dev/null
+++ b/drivers/power/wingray_battery_monitor.c
@@ -0,0 +1,217 @@
+/*
+ * Motorola Xoom P3 DS2781/BQ24617 monitoring only.
+ * Reuses Motorola's register map, scaling and charger truth table.
+ * No calibration, EEPROM, charger-enable, current-limit or voltage writes.
+ * Copyright (C) 2026. Licensed under GPL version 2.
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/gpio.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include "../w1/slaves/w1_ds2781.h"
+#include "wingray_battery_monitor.h"
+
+struct wingray_monitor {
+ struct device *w1_dev;
+ struct power_supply *battery, *ac;
+ struct power_supply_desc bat_desc, ac_desc;
+ struct delayed_work work;
+ struct mutex lock;
+ int gpio[3]; /* STAT1 PV5, STAT2 PD1, DETECT PV6: inputs only */
+ int error, current_error, online, status, capacity, uv, ua, temp;
+ bool stopping;
+};
+
+static int wingray_read(struct wingray_monitor *m, u8 *data, int addr, int len)
+{
+ int ret = w1_ds2781_io(m->w1_dev, data, addr, len, 0);
+ return ret == len ? 0 : ret < 0 ? ret : -EIO;
+}
+
+/* Caller holds lock. Failed refresh invalidates old readings. */
+static void wingray_sample(struct wingray_monitor *m)
+{
+ u8 raw[15], conductance;
+ int s1, s2, det, ret;
+ s1 = gpio_get_value_cansleep(m->gpio[0]);
+ s2 = gpio_get_value_cansleep(m->gpio[1]);
+ det = gpio_get_value_cansleep(m->gpio[2]);
+ m->status = wingray_charge_status(s1, s2, det, &m->online);
+ ret = wingray_read(m, raw, DS2781_STATUS, sizeof(raw));
+ m->error = ret;
+ if (ret) {
+  dev_warn_ratelimited(m->w1_dev, "battery gauge read failed: %d\n", ret);
+  return;
+ }
+ /* Gauge RARC, not voltage estimation. Out-of-range is an error. */
+ if (raw[DS2781_RARC - 1] > 100) {
+  m->error = -ERANGE;
+  return;
+ }
+ m->capacity = raw[DS2781_RARC - 1];
+ m->uv = wingray_voltage_uv(raw[DS2781_VOLT_MSB - 1],
+          raw[DS2781_VOLT_LSB - 1]);
+ m->temp = wingray_temperature_dc(raw[DS2781_TEMP_MSB - 1],
+             raw[DS2781_TEMP_LSB - 1]);
+ /* Zero/open data must not become a fabricated present battery. */
+ if (!m->uv || m->uv > 10000000) {
+  m->error = -ERANGE;
+  return;
+ }
+ ret = wingray_read(m, &conductance, DS2781_RSNSP, 1);
+ m->current_error = ret ? ret : conductance ? 0 : -ENODATA;
+ if (!m->current_error)
+  m->ua = wingray_current_ua(raw[DS2781_CURRENT_MSB - 1],
+            raw[DS2781_CURRENT_LSB - 1], conductance);
+}
+
+static int wingray_get(struct power_supply *psy,
+        enum power_supply_property prop, union power_supply_propval *v)
+{
+ struct wingray_monitor *m = power_supply_get_drvdata(psy);
+ int ret = 0;
+ mutex_lock(&m->lock);
+ if (psy->desc->type == POWER_SUPPLY_TYPE_MAINS) {
+  if (prop == POWER_SUPPLY_PROP_ONLINE)
+   v->intval = m->online;
+  else
+   ret = -EINVAL;
+  goto out;
+ }
+ if (prop == POWER_SUPPLY_PROP_STATUS) {
+  v->intval = m->status;
+  goto out;
+ }
+ if (m->error) {
+  ret = m->error;
+  goto out;
+ }
+ switch (prop) {
+ case POWER_SUPPLY_PROP_PRESENT: v->intval = 1; break;
+ case POWER_SUPPLY_PROP_CAPACITY: v->intval = m->capacity; break;
+ case POWER_SUPPLY_PROP_VOLTAGE_NOW: v->intval = m->uv; break;
+ case POWER_SUPPLY_PROP_CURRENT_NOW:
+  ret = m->current_error;
+  if (!ret)
+   v->intval = m->ua;
+  break;
+ case POWER_SUPPLY_PROP_TEMP: v->intval = m->temp; break;
+ default: ret = -EINVAL;
+ }
+ out:
+ mutex_unlock(&m->lock);
+ return ret;
+}
+
+static void wingray_poll(struct work_struct *work)
+{
+ struct wingray_monitor *m = container_of(work, struct wingray_monitor, work.work);
+ mutex_lock(&m->lock);
+ wingray_sample(m);
+ mutex_unlock(&m->lock);
+ power_supply_changed(m->battery);
+ power_supply_changed(m->ac);
+ if (!m->stopping)
+  schedule_delayed_work(&m->work, msecs_to_jiffies(2000));
+}
+
+static enum power_supply_property battery_props[] = {
+ POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_STATUS,
+ POWER_SUPPLY_PROP_CAPACITY, POWER_SUPPLY_PROP_VOLTAGE_NOW,
+ POWER_SUPPLY_PROP_CURRENT_NOW, POWER_SUPPLY_PROP_TEMP,
+};
+static enum power_supply_property ac_props[] = { POWER_SUPPLY_PROP_ONLINE };
+
+static int wingray_monitor_probe(struct platform_device *pdev)
+{
+ const char *names[] = { "stat1-gpios", "stat2-gpios", "detect-gpios" };
+ const char *labels[] = { "wingray-stat1", "wingray-stat2", "wingray-detect" };
+ const int expected[] = { 173, 25, 174 };
+ struct power_supply_config cfg = {};
+ struct device_node *np;
+ struct wingray_monitor *m;
+ int i, ret;
+
+ if (!of_machine_is_compatible("motorola,wingray"))
+  return -ENODEV;
+ np = of_find_compatible_node(NULL, NULL, "motorola,wingray-p3-battery-monitor");
+ if (!np)
+  return -ENODEV;
+ m = devm_kzalloc(&pdev->dev, sizeof(*m), GFP_KERNEL);
+ if (!m) {
+  of_node_put(np);
+  return -ENOMEM;
+ }
+ for (i = 0; i < 3; i++) {
+  enum of_gpio_flags flags;
+  ret = of_get_named_gpio_flags(np, names[i], 0, &flags);
+  if (ret < 0)
+   goto put_node;
+  if (ret != expected[i] || flags) {
+   ret = -EINVAL;
+   goto put_node;
+  }
+  m->gpio[i] = ret;
+  ret = devm_gpio_request_one(&pdev->dev, m->gpio[i], GPIOF_IN, labels[i]);
+  if (ret)
+   goto put_node;
+ }
+ of_node_put(np);
+ m->w1_dev = pdev->dev.parent;
+ mutex_init(&m->lock);
+ INIT_DELAYED_WORK(&m->work, wingray_poll);
+ cfg.drv_data = m;
+ m->bat_desc.name = "battery";
+ m->bat_desc.type = POWER_SUPPLY_TYPE_BATTERY;
+ m->bat_desc.properties = battery_props;
+ m->bat_desc.num_properties = ARRAY_SIZE(battery_props);
+ m->bat_desc.get_property = wingray_get;
+ m->ac_desc.name = "ac";
+ m->ac_desc.type = POWER_SUPPLY_TYPE_MAINS;
+ m->ac_desc.properties = ac_props;
+ m->ac_desc.num_properties = ARRAY_SIZE(ac_props);
+ m->ac_desc.get_property = wingray_get;
+ wingray_sample(m);
+ /* Failed gauge access must not publish a made-up initial percentage. */
+ if (m->error)
+  return m->error;
+ m->battery = power_supply_register(&pdev->dev, &m->bat_desc, &cfg);
+ if (IS_ERR(m->battery))
+  return PTR_ERR(m->battery);
+ m->ac = power_supply_register(&pdev->dev, &m->ac_desc, &cfg);
+ if (IS_ERR(m->ac)) {
+  ret = PTR_ERR(m->ac);
+  power_supply_unregister(m->battery);
+  return ret;
+ }
+ platform_set_drvdata(pdev, m);
+ schedule_delayed_work(&m->work, msecs_to_jiffies(2000));
+ dev_info(&pdev->dev, "DS2781/BQ24617 P3 read-only monitor, 2s polling\n");
+ return 0;
+ put_node:
+ of_node_put(np);
+ return ret;
+}
+static int wingray_monitor_remove(struct platform_device *pdev)
+{
+ struct wingray_monitor *m = platform_get_drvdata(pdev);
+ m->stopping = true;
+ cancel_delayed_work_sync(&m->work);
+ power_supply_unregister(m->ac);
+ power_supply_unregister(m->battery);
+ return 0;
+}
+static struct platform_driver wingray_monitor_driver = {
+ .probe = wingray_monitor_probe,
+ .remove = wingray_monitor_remove,
+ .driver = { .name = "ds2781-battery" },
+};
+module_platform_driver(wingray_monitor_driver);
+MODULE_ALIAS("platform:ds2781-battery");
+MODULE_DESCRIPTION("Wingray P3 battery/charger input-only monitor");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/wingray_battery_monitor.h b/drivers/power/wingray_battery_monitor.h
new file mode 100644
index 00000000..b700128b
--- /dev/null
+++ b/drivers/power/wingray_battery_monitor.h
@@ -0,0 +1,36 @@
+/* GPL-2.0: read-only decoding, based on Motorola DS2781/BQ24617 drivers. */
+#ifndef WINGRAY_BATTERY_MONITOR_H
+#define WINGRAY_BATTERY_MONITOR_H
+/* Inputs are raw GPIO levels, as in Motorola bq24617_read_status(). */
+static int wingray_charge_status(int stat1, int stat2, int detect, int *online)
+{
+ *online = !stat1 || !stat2 || detect;
+ if (!*online)
+  return POWER_SUPPLY_STATUS_DISCHARGING;
+ if (!stat1 && !stat2) /* Invalid STAT combination; do not claim full. */
+  return POWER_SUPPLY_STATUS_UNKNOWN;
+ if (!stat2)
+  return POWER_SUPPLY_STATUS_FULL;
+ if (!stat1)
+  return POWER_SUPPLY_STATUS_CHARGING;
+ return POWER_SUPPLY_STATUS_NOT_CHARGING;
+}
+static int wingray_voltage_uv(unsigned int msb, unsigned int lsb)
+{
+ return ((msb << 3) | (lsb >> 5)) * 9760;
+}
+static int wingray_temperature_dc(unsigned int msb, unsigned int lsb)
+{
+ int raw = (msb >= 128 ? (int)msb - 256 : (int)msb) * 8 + (lsb >> 5);
+ return raw * 10 / 8; /* signed 0.125 C -> tenths C */
+}
+static int wingray_current_ua(unsigned int msb, unsigned int lsb,
+        unsigned int conductance)
+{
+ int raw = (msb << 8) | lsb;
+ if (raw & 0x8000)
+  raw -= 65536;
+ /* 1.5625 uV/LSB * conductance(mho); keep precision until the end. */
+ return raw * 25 * (int)conductance / 16;
+}
