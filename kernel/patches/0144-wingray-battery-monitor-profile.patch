diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-android44-battery.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-battery.dts
new file mode 100644
index 00000000..d3125a0a
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-android44-battery.dts
@@ -0,0 +1,27 @@
+/* Opt-in P3 monitoring only; inherits the tested build-78 hardware profile. */
+#include "tegra20-motorola-wingray-android44-bluetooth.dts"
+/ {
+ wingray_battery_monitor {
+  compatible = "motorola,wingray-p3-battery-monitor";
+  /* Raw levels: STAT1/2 active low, DETECT high, per Motorola driver. */
+  stat1-gpios = <&gpio TEGRA_GPIO(V, 5) GPIO_ACTIVE_HIGH>;
+  stat2-gpios = <&gpio TEGRA_GPIO(D, 1) GPIO_ACTIVE_HIGH>;
+  detect-gpios = <&gpio TEGRA_GPIO(V, 6) GPIO_ACTIVE_HIGH>;
+ };
+ onewire@7000c600 {
+  compatible = "motorola,wingray-tegra20-owr";
+  reg = <0x7000c600 0x50>;
+  interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+  clocks = <&tegra_car TEGRA20_CLK_OWR>;
+  resets = <&tegra_car 71>;
+  reset-names = "owr";
+  pinctrl-names = "default";
+  pinctrl-0 = <&wingray_owr>;
+ };
+ pinmux@70000014 {
+  wingray_owr: battery-owr-pins {
+   owc { nvidia,pins = "owc"; nvidia,function = "owr";
+         nvidia,pull = <2>; nvidia,tristate = <0>; };
+  };
+ };
+};
