diff --git a/block/partitions/xoom-bigpart-gpt.h b/block/partitions/xoom-bigpart-gpt.h
new file mode 100644
index 00000000..b139bca4
--- /dev/null
+++ b/block/partitions/xoom-bigpart-gpt.h
@@ -0,0 +1,84 @@
+#ifndef _XOOM_BIGPART_GPT_H
+#define _XOOM_BIGPART_GPT_H
+/*
+ * Motorola Xoom Wi-Fi BigPart GPT view. GPL version 2.
+ * Based on Schischu's 2013 BigPart sector remapping, with board, controller,
+ * geometry and overlap checks. This never writes a partition table.
+ */
+#include <linux/device.h>
+#include <linux/of.h>
+#include <linux/string.h>
+
+#include "xoom-bigpart.h"
+
+/* Included by efi.c so we can use its validated GPT types and helpers. */
+static bool xoom_bigpart_enabled(struct parsed_partitions *state)
+{
+	struct device *dev;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return false;
+	for (dev = disk_to_dev(state->bdev->bd_disk); dev; dev = dev->parent)
+		if (dev->of_node &&
+		    of_property_read_bool(dev->of_node, "motorola,xoom-bigpart"))
+			return true;
+	return false;
+}
+
+static int xoom_bigpart_prepare(struct parsed_partitions *state,
+			       gpt_header *gpt, gpt_entry *ptes,
+			       int slots[3], struct xoom_bigpart_extent p[3])
+{
+	u32 i, j, count = le32_to_cpu(gpt->num_partition_entries);
+	u64 last = le64_to_cpu(gpt->last_usable_lba);
+	const u64 starts[3] = {
+		XOOM_SYSTEM_START, XOOM_CACHE_START, XOOM_DATA_START
+	};
+
+	if (!xoom_bigpart_enabled(state))
+		return 0;
+	if (bdev_logical_block_size(state->bdev) != 512)
+		return -EINVAL;
+	for (j = 0; j < 3; j++)
+		slots[j] = -1;
+	for (i = 0; i < count; i++) {
+		u64 start = le64_to_cpu(ptes[i].starting_lba);
+		u64 end = le64_to_cpu(ptes[i].ending_lba);
+
+		if (!is_pte_valid(&ptes[i], last_lba(state->bdev)))
+			continue;
+		if (end < start || end > last)
+			return -EINVAL;
+		for (j = 0; j < 3; j++) {
+			if (start != starts[j])
+				continue;
+			if (slots[j] >= 0 || end < start || i >= state->limit - 1)
+				return -EINVAL;
+			slots[j] = i;
+			p[j].start = start;
+			p[j].size = end - start + 1;
+		}
+	}
+	for (j = 0; j < 3; j++)
+		if (slots[j] < 0)
+			return -EINVAL;
+	if (xoom_bigpart_layout(p, last))
+		return -EINVAL;
+
+	/* Refuse layouts where expansion would cover another valid entry. */
+	for (i = 0; i < count; i++) {
+		u64 start = le64_to_cpu(ptes[i].starting_lba);
+		u64 end = le64_to_cpu(ptes[i].ending_lba);
+
+		if (i == slots[0] || i == slots[1] || i == slots[2] ||
+		    !is_pte_valid(&ptes[i], last_lba(state->bdev)))
+			continue;
+		for (j = 0; j < 3; j++)
+			if (start < p[j].start + p[j].size && end >= p[j].start)
+				return -EINVAL;
+	}
+	pr_info("Xoom: using Wingray BigPart GPT view (system 1 GiB, cache 512 MiB)\n");
+	return 1;
+}
+
+#endif
diff --git a/block/partitions/xoom-bigpart.h b/block/partitions/xoom-bigpart.h
new file mode 100644
index 00000000..6ea31ad1
--- /dev/null
+++ b/block/partitions/xoom-bigpart.h
@@ -0,0 +1,43 @@
+/* Motorola Xoom BigPart geometry, in 512-byte sectors. GPL-2.0 */
+#ifndef _XOOM_BIGPART_H
+#define _XOOM_BIGPART_H
+
+struct xoom_bigpart_extent {
+	u64 start;
+	u64 size;
+};
+
+#define XOOM_SYSTEM_START 0x1d000ULL
+#define XOOM_CACHE_START  0x9d000ULL
+#define XOOM_DATA_START   0xf1800ULL
+#define XOOM_SYSTEM_OLD   0x80000ULL
+#define XOOM_CACHE_OLD    0x54800ULL
+#define XOOM_SYSTEM_NEW  0x200000ULL
+#define XOOM_CACHE_NEW   0x100000ULL
+#define XOOM_DATA_SHIFT  ((XOOM_SYSTEM_NEW - XOOM_SYSTEM_OLD) + \
+			 (XOOM_CACHE_NEW - XOOM_CACHE_OLD))
+
+/* Check the whole legacy triplet before changing any entry. Return zero
+ * only for the original Wingray geometry. An already-remapped table must
+ * never be shifted a second time. Callers also validate other GPT entries.
+ */
+static inline int xoom_bigpart_layout(struct xoom_bigpart_extent p[3],
+				      u64 last_usable)
+{
+	if (p[0].start != XOOM_SYSTEM_START || p[0].size != XOOM_SYSTEM_OLD ||
+	    p[1].start != XOOM_CACHE_START || p[1].size != XOOM_CACHE_OLD ||
+	    p[2].start != XOOM_DATA_START || p[2].size <= XOOM_DATA_SHIFT)
+		return -1;
+	if (p[2].start > last_usable ||
+	    p[2].size - 1 > last_usable - p[2].start)
+		return -1;
+
+	p[0].size = XOOM_SYSTEM_NEW;
+	p[1].start += XOOM_SYSTEM_NEW - XOOM_SYSTEM_OLD;
+	p[1].size = XOOM_CACHE_NEW;
+	p[2].start += XOOM_DATA_SHIFT;
+	p[2].size -= XOOM_DATA_SHIFT;
+	return 0;
+}
+
+#endif
