diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray.dts b/arch/arm/boot/dts/tegra20-motorola-wingray.dts
new file mode 100644
index 00000000..9873dcb9
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray.dts
@@ -0,0 +1,149 @@
+/*
+ * Motorola Xoom Wi-Fi (MZ604 / Wingray) initial board description.
+ * Wiring derived from Motorola/Google's GPLv2 board-stingray sources.
+ * This file is licensed under the GNU General Public License version 2.
+ */
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include "tegra20.dtsi"
+
+/ {
+	model = "Motorola Xoom Wi-Fi (MZ604)";
+	compatible = "motorola,wingray", "nvidia,tegra20";
+
+	aliases {
+		serial0 = &uartb;
+		mmc0 = "/sdhci@c8000600";
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	clk32k_in: clock-32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+	};
+
+	memory {
+		device_type = "memory";
+		reg = <0x00000000 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		safety@0 {
+			reg = <0x0 0x1000>;
+			no-map;
+		};
+
+		/* Legacy stingray_reserve removes the last 2 MiB below 512 MiB. */
+		legacy-console@1fe00000 {
+			reg = <0x1fe00000 0x00200000>;
+			no-map;
+		};
+
+		/* Preserve legacy framebuffer/carveout memory during bring-up. */
+		legacy-video@2e800000 {
+			reg = <0x2e800000 0x11800000>;
+			no-map;
+		};
+	};
+
+	ramoops@1ff00000 {
+		compatible = "ramoops";
+		reg = <0x1ff00000 0x00100000>;
+		record-size = <0x20000>;
+		console-size = <0x80000>;
+		pmsg-size = <0x20000>;
+	};
+
+	/* CPCAP and MAX8649 are deliberately left in the firmware state.
+	 * No Samsung TPS6586x, WM8994 or CMC623 devices belong on this board.
+	 * CPU frequency scaling and suspend are disabled in the bring-up config.
+	 */
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpio TEGRA_GPIO(R, 0) GPIO_ACTIVE_LOW>;
+		};
+
+		volume-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	gpio@6000d000 {
+		/* Shared column for the two volume switches. */
+		keypad-column {
+			gpio-hog;
+			gpios = <TEGRA_GPIO(Q, 0) GPIO_ACTIVE_HIGH>;
+			output-low;
+			line-name = "wingray-keypad-column";
+		};
+
+		usb-data-enable {
+			gpio-hog;
+			gpios = <TEGRA_GPIO(V, 4) GPIO_ACTIVE_HIGH>;
+			output-high;
+			line-name = "wingray-usb-data-enable";
+		};
+
+		usb-forceon-n {
+			gpio-hog;
+			gpios = <TEGRA_GPIO(C, 5) GPIO_ACTIVE_HIGH>;
+			output-high;
+			line-name = "wingray-usb-forceon-n";
+		};
+	};
+
+	usb@c5000000 {
+		compatible = "nvidia,tegra20-udc";
+		status = "okay";
+		dr_mode = "peripheral";
+	};
+
+	usb-phy@c5000000 {
+		status = "okay";
+		dr_mode = "peripheral";
+		nvidia,hssync-start-delay = <9>;
+		nvidia,idle-wait-delay = <17>;
+		nvidia,elastic-limit = <16>;
+		nvidia,term-range-adj = <6>;
+		nvidia,xcvr-setup = <15>;
+		nvidia,xcvr-lsfslew = <1>;
+		nvidia,xcvr-lsrslew = <1>;
+	};
+
+	/* First image uses RAM initramfs and eMMC only. External SD and Wi-Fi
+	 * stay disabled until power sequencing and SDMMC tap delays are ported.
+	 */
+	sdhci@c8000600 {
+		status = "okay";
+		bus-width = <8>;
+		non-removable;
+		max-frequency = <25000000>;
+		motorola,xoom-bigpart;
+	};
+
+	/* Do not probe downstream video engines without Xoom power support. */
+	host1x@50000000 {
+		status = "disabled";
+	};
+};
+
+&uartb {
+	status = "okay";
+	clock-frequency = <26000000>;
+};
