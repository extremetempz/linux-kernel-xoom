diff --git a/arch/arm/mach-tegra/board-wingray.c b/arch/arm/mach-tegra/board-wingray.c
new file mode 100644
index 00000000..86896d96
--- /dev/null
+++ b/arch/arm/mach-tegra/board-wingray.c
@@ -0,0 +1,51 @@
+/* Motorola Xoom early memory preservation. GNU GPL version 2. */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/of_fdt.h>
+
+static phys_addr_t wingray_fb_start, wingray_fb_size;
+static phys_addr_t wingray_lp0_start, wingray_lp0_size;
+
+static int __init wingray_parse_region(char *arg, phys_addr_t *start,
+				      phys_addr_t *size)
+{
+	char *p = arg;
+	u64 length = memparse(p, &p), address;
+
+	if (!of_flat_dt_is_compatible(of_get_flat_dt_root(), "motorola,wingray"))
+		return 0;
+	if (*p != '@')
+		return -EINVAL;
+	address = memparse(p + 1, &p);
+	if (*p || !length || address >= 0x40000000ULL ||
+	    length > 0x40000000ULL - address)
+		return -EINVAL;
+	*start = address;
+	*size = length;
+	return 0;
+}
+
+static int __init wingray_fb_arg(char *arg)
+{
+	return wingray_parse_region(arg, &wingray_fb_start, &wingray_fb_size);
+}
+early_param("tegra_fbmem", wingray_fb_arg);
+
+static int __init wingray_lp0_arg(char *arg)
+{
+	return wingray_parse_region(arg, &wingray_lp0_start, &wingray_lp0_size);
+}
+early_param("lp0_vec", wingray_lp0_arg);
+
+void __init wingray_reserve(void)
+{
+	if (!of_flat_dt_is_compatible(of_get_flat_dt_root(), "motorola,wingray"))
+		return;
+	if (wingray_fb_size &&
+	    memblock_reserve(wingray_fb_start, wingray_fb_size))
+		panic("Wingray: cannot preserve bootloader framebuffer");
+	if (wingray_lp0_size &&
+	    memblock_reserve(wingray_lp0_start, wingray_lp0_size))
+		panic("Wingray: cannot preserve bootloader LP0 vector");
+}
