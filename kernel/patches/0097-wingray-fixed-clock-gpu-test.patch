diff --git a/drivers/staging/tegra/clk.c b/drivers/staging/tegra/clk.c
index 204a01ff..38064e42 100644
--- a/drivers/staging/tegra/clk.c
+++ b/drivers/staging/tegra/clk.c
@@ -10,6 +10,7 @@
 #include <linux/clk.h>
 #include <linux/clkdev.h>
 #include <linux/clk-provider.h>
+#include <linux/of.h>
 
 int tegra_is_clk_enabled(struct clk *c)
 {
@@ -40,6 +41,10 @@ static struct shared_emc_clk {
 	struct clk_hw hw;
 	unsigned long rate;
 	int enabled;
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+	struct clk *registered;
+	struct clk_lookup *lookup;
+#endif
 } virtual_emc_clks[SHARED_CLK_NB];
 
 static int update_emc_clk_rate(void)
@@ -177,8 +182,127 @@ static void register_shared_emc_clk(struct shared_emc_clk *shrd_clk,
 	}
 }
 
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+/* Diagnostic-only votes: validate the minimum, never reprogram DRAM. */
+static unsigned long wingray_emc_rate;
+
+static int wingray_emc_check(unsigned long vote)
+{
+	if (!emc_clk || IS_ERR(emc_clk) || !wingray_emc_rate)
+		return -ENODEV;
+	if (clk_get_rate(emc_clk) != wingray_emc_rate)
+		return -EIO;
+	return vote <= wingray_emc_rate ? 0 : -ERANGE;
+}
+
+static int wingray_emc_prepare(struct clk_hw *hw)
+{
+	struct shared_emc_clk *v = container_of(hw, struct shared_emc_clk, hw);
+	int err = wingray_emc_check(v->rate);
+	if (!err)
+		v->enabled = 1;
+	return err;
+}
+
+static void wingray_emc_unprepare(struct clk_hw *hw)
+{
+	container_of(hw, struct shared_emc_clk, hw)->enabled = 0;
+}
+
+static long wingray_emc_round(struct clk_hw *hw, unsigned long rate,
+		unsigned long *parent_rate)
+{
+	int err = wingray_emc_check(rate);
+	if (err)
+		return err;
+	return rate;
+}
+
+static int wingray_emc_set(struct clk_hw *hw, unsigned long rate,
+		unsigned long parent_rate)
+{
+	struct shared_emc_clk *v = container_of(hw, struct shared_emc_clk, hw);
+	int err = wingray_emc_check(rate);
+	if (!err)
+		v->rate = rate;
+	return err;
+}
+
+static const struct clk_ops wingray_emc_ops = {
+	.prepare = wingray_emc_prepare,
+	.unprepare = wingray_emc_unprepare,
+	.is_enabled = shared_emc_clk_is_enabled,
+	.recalc_rate = shared_emc_clk_recalc_rate,
+	.round_rate = wingray_emc_round,
+	.set_rate = wingray_emc_set,
+};
+
+static int register_wingray_emc(void)
+{
+	static const int ids[] = {G3D, G2D};
+	static const char * const names[] = {"wingray_gr3d_emc", "wingray_gr2d_emc"};
+	static const char * const clients[] = {"gr3d", "gr2d"};
+	int i, err;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return -ENODEV;
+	emc_clk = clk_get_sys(NULL, "emc");
+	if (IS_ERR(emc_clk)) {
+		err = PTR_ERR(emc_clk);
+		emc_clk = NULL;
+		return err;
+	}
+	wingray_emc_rate = clk_get_rate(emc_clk);
+	if (wingray_emc_rate < 400000000) {
+		err = -ERANGE;
+		goto fail;
+	}
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		struct shared_emc_clk *v = &virtual_emc_clks[ids[i]];
+		struct clk_init_data init = {
+			.name = names[i], .ops = &wingray_emc_ops,
+		};
+		v->rate = wingray_emc_rate;
+		v->hw.init = &init;
+		v->registered = clk_register(NULL, &v->hw);
+		if (IS_ERR(v->registered)) {
+			err = PTR_ERR(v->registered);
+			v->registered = NULL;
+			goto fail;
+		}
+		v->lookup = clkdev_create(v->registered, "emc", "%s", clients[i]);
+		if (!v->lookup) {
+			err = -ENOMEM;
+			goto fail;
+		}
+	}
+	pr_info("XOOM_GPU_FIXED_EMC rate=%lu no_dram_writes\n", wingray_emc_rate);
+	return 0;
+fail:
+	for (i = ARRAY_SIZE(ids); i-- > 0;) {
+		struct shared_emc_clk *v = &virtual_emc_clks[ids[i]];
+		if (v->lookup) {
+			clkdev_drop(v->lookup);
+			v->lookup = NULL;
+		}
+		if (v->registered) {
+			clk_unregister(v->registered);
+			v->registered = NULL;
+		}
+	}
+	clk_put(emc_clk);
+	emc_clk = NULL;
+	wingray_emc_rate = 0;
+	return err;
+}
+#endif
+
 static int register_shared_emc_clks(void)
 {
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+	return register_wingray_emc();
+#endif
+
 	/* The carveout-only Wingray experiment must not replace even the USB
 	 * EMC clock lookups while validating allocator backing ownership. */
 	if (IS_ENABLED(CONFIG_TEGRA_NVMAP_WINGRAY_RESOURCES) ||
diff --git a/drivers/staging/tegra/video/Kconfig b/drivers/staging/tegra/video/Kconfig
index 287ca372..438ab76c 100644
--- a/drivers/staging/tegra/video/Kconfig
+++ b/drivers/staging/tegra/video/Kconfig
@@ -8,6 +8,22 @@ config TEGRA_GRHOST
 	help
 	  Driver for the Tegra graphics host hardware.
 
+config TEGRA_GRHOST_WINGRAY_GPU_TEST
+	bool "Motorola Wingray fixed-clock offscreen GPU diagnostic"
+	depends on MACH_MOTOROLA_WINGRAY && ARCH_TEGRA_2x_SOC && TEGRA_GRHOST=y && TEGRA_NVMAP=y
+	depends on !TEGRA_HOST1X && !TEGRA_DC && !TEGRA_IOVMM && !IOMMU_API
+	depends on !CPU_FREQ && !SUSPEND && !TEGRA_RPC && !TEGRA_AVP && !TEGRA_MEDIASERVER
+	depends on !TEGRA_GRHOST_WINGRAY_HOST_TEST
+	select TEGRA_SEMA_STANDALONE
+	select TEGRA_GRHOST_WINGRAY_LEGACY_SUBMIT
+	default n
+	help
+	  Separate diagnostic only: cap GR3D at 200 MHz and GR2D/EPP at
+	  100 MHz, retain host rate, and use fixed software EMC votes which
+	  never change DRAM timing/rate. Reject a boot EMC rate below 400 MHz.
+	  Perform checked engine reset before channel publication. Use only
+	  with the GPU-test DT, RAM NVIDIA runtime and offscreen readback test.
+
 config TEGRA_GRHOST_WINGRAY_HOST_TEST
 	bool "Motorola Wingray host-only diagnostic"
 	depends on MACH_MOTOROLA_WINGRAY && ARCH_TEGRA_2x_SOC && TEGRA_GRHOST=y && TEGRA_NVMAP=y
diff --git a/drivers/staging/tegra/video/host/nvhost_acm.c b/drivers/staging/tegra/video/host/nvhost_acm.c
index 2d91591e..3a787dd4 100644
--- a/drivers/staging/tegra/video/host/nvhost_acm.c
+++ b/drivers/staging/tegra/video/host/nvhost_acm.c
@@ -28,6 +28,7 @@
 #include <linux/delay.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
+#include <linux/clk-provider.h>
 #include <mach/powergate.h>
 #include <mach/clk.h>
 
@@ -429,6 +430,10 @@ int nvhost_module_get_rate(struct nvhost_device *dev, unsigned long *rate,
 
 static int nvhost_module_update_rate(struct nvhost_device *dev, int index)
 {
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+	return 0;
+#else
+
 	unsigned long rate = 0;
 	struct nvhost_module_client *m;
 	struct clk *c;
@@ -445,11 +450,16 @@ static int nvhost_module_update_rate(struct nvhost_device *dev, int index)
 				dev->clocks[index].default_rate);
 
 	return clk_set_rate(dev->clk[index], rate);
+#endif
 }
 
 int nvhost_module_set_rate(struct nvhost_device *dev, void *priv,
 		unsigned long rate, int index)
 {
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+	return -EOPNOTSUPP;
+#else
+
 	struct nvhost_module_client *m;
 	int i, ret = 0;
 
@@ -470,6 +480,7 @@ int nvhost_module_set_rate(struct nvhost_device *dev, void *priv,
 	mutex_unlock(&client_list_lock);
 	return ret;
 
+#endif
 }
 
 int nvhost_module_add_client(struct nvhost_device *dev, void *priv)
@@ -623,6 +634,37 @@ static void nvhost_module_release_clocks(struct nvhost_device *dev)
 	dev->emc_idx = 0;
 }
 
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+static long wingray_gpu_initial_rate(struct nvhost_device *dev, int i,
+		struct clk *c)
+{
+	const char *name = dev->clocks[i].name;
+	unsigned long cap;
+	long rate;
+
+	if (dev->index == 10 && !strcmp(name, "host1x"))
+		return clk_get_rate(c);
+	if (!strcmp(name, "emc")) {
+		const char *provider = dev->index == 1 ? "wingray_gr3d_emc" :
+			dev->index == 2 ? "wingray_gr2d_emc" : NULL;
+		if (!provider || strcmp(__clk_get_name(c), provider))
+			return -ENODEV;
+		return clk_round_rate(c, 400000000);
+	}
+	if (dev->index == 1 && !strcmp(name, "gr3d"))
+		cap = 200000000;
+	else if (dev->index == 2 &&
+		 (!strcmp(name, "gr2d") || !strcmp(name, "epp")))
+		cap = 100000000;
+	else
+		return -EINVAL;
+	rate = clk_round_rate(c, cap);
+	if (rate < 0)
+		return rate;
+	return (unsigned long)rate > cap ? -ERANGE : rate;
+}
+#endif
+
 static int nvhost_module_init_clocks(struct nvhost_device *dev)
 {
 	long rates[NVHOST_MODULE_MAX_CLOCKS];
@@ -656,6 +698,8 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 			goto fail;
 		}
 		rates[i] = previous[i];
+#elif defined(CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST)
+		rates[i] = wingray_gpu_initial_rate(dev, i, c);
 #else
 		rates[i] = clk_round_rate(c, dev->clocks[i].default_rate);
 #endif
@@ -668,6 +712,18 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 #ifdef CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST
 		/* Runtime activation tests the enable path, never changes its rate. */
 		continue;
+#endif
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+		/* Program only safe low engine dividers while the engine is gated.
+		 * The EMC provider is a software-only fixed-rate vote. */
+		if (dev->index != 10) {
+			changed[i] = true;
+			err = clk_set_rate(dev->clk[i], rates[i]);
+			if (err)
+				goto fail;
+		}
+		dev->clocks[i].default_rate = rates[i];
+		continue;
 #endif
 		err = clk_prepare_enable(dev->clk[i]);
 		if (err)
@@ -692,11 +748,15 @@ fail:
 		int restore;
 		if (!changed[i])
 			continue;
+#ifdef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
+		restore = clk_set_rate(dev->clk[i], previous[i]);
+#else
 		restore = clk_prepare_enable(dev->clk[i]);
 		if (!restore) {
 			restore = clk_set_rate(dev->clk[i], previous[i]);
 			clk_disable_unprepare(dev->clk[i]);
 		}
+#endif
 		if (restore)
 			dev_err(&dev->dev, "Clock %s rollback failed: %d\n",
 				dev->clocks[i].name, restore);
-- 
