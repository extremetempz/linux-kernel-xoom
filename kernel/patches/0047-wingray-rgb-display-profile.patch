From 16b705900f6422fc90347e22ed4aaf1c1b9970ce Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Thu, 22 Oct 2026 17:01:28 +1100
Subject: [PATCH] ARM: tegra: add isolated Wingray RGB display profile

---
 .../dts/tegra20-motorola-wingray-display.dts  | 229 ++++++++++++++++++
 arch/arm/configs/wingray_display_defconfig    |  93 +++++++
 2 files changed, 322 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-display.dts
 create mode 100644 arch/arm/configs/wingray_display_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-display.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-display.dts
new file mode 100644
index 00000000..fdca8353
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-display.dts
@@ -0,0 +1,229 @@
+/* Minimum RGB scanout plus verified USB/MMC and P3 backlight. GPL-2.0. */
+#include "tegra20-motorola-wingray-panelbus.dts"
+/ {
+ model = "Motorola Xoom P3 display bring-up";
+ panel: panel {
+  compatible = "motorola,wingray-auo-panel";
+  power-supply = <&panel_power>;
+  backlight = <&backlight>;
+ };
+ pinmux@70000014 {
+  wingray_panelbus_mux: panelbus-mux {
+			ld0 {
+				nvidia,pins = "ld0";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld1 {
+				nvidia,pins = "ld1";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld10 {
+				nvidia,pins = "ld10";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld11 {
+				nvidia,pins = "ld11";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld12 {
+				nvidia,pins = "ld12";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld13 {
+				nvidia,pins = "ld13";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld14 {
+				nvidia,pins = "ld14";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld15 {
+				nvidia,pins = "ld15";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld16 {
+				nvidia,pins = "ld16";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld17 {
+				nvidia,pins = "ld17";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld2 {
+				nvidia,pins = "ld2";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld3 {
+				nvidia,pins = "ld3";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld4 {
+				nvidia,pins = "ld4";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld5 {
+				nvidia,pins = "ld5";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld6 {
+				nvidia,pins = "ld6";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld7 {
+				nvidia,pins = "ld7";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld8 {
+				nvidia,pins = "ld8";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ld9 {
+				nvidia,pins = "ld9";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			ldi {
+				nvidia,pins = "ldi";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lhp0 {
+				nvidia,pins = "lhp0";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lhp1 {
+				nvidia,pins = "lhp1";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lhp2 {
+				nvidia,pins = "lhp2";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lhs {
+				nvidia,pins = "lhs";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lpp {
+				nvidia,pins = "lpp";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lpw0 {
+				nvidia,pins = "lpw0";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lpw2 {
+				nvidia,pins = "lpw2";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lsc0 {
+				nvidia,pins = "lsc0";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lsc1 {
+				nvidia,pins = "lsc1";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lspi {
+				nvidia,pins = "lspi";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+			lvp1 {
+				nvidia,pins = "lvp1";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <1>;
+			};
+			lvs {
+				nvidia,pins = "lvs";
+				nvidia,function = "displaya";
+				nvidia,tristate = <0>;
+				nvidia,pull = <2>;
+			};
+  };
+ };
+ i2c@7000c000 {
+  backlight: backlight@2c {
+   compatible = "motorola,wingray-p3-lp8550", "ti,lp8550";
+   reg = <0x2c>;
+   dev-ctrl = /bits/ 8 <0x03>;
+   init-brt = /bits/ 8 <0x80>;
+   bl-name = "lcd-backlight";
+   power-supply = <&panel_power>;
+  };
+ };
+ host1x@50000000 {
+  status = "okay";
+  mpe@54040000 { status = "disabled"; };
+  vi@54080000 { status = "disabled"; };
+  epp@540c0000 { status = "disabled"; };
+  isp@54100000 { status = "disabled"; };
+  gr2d@54140000 { status = "disabled"; };
+  gr3d@54180000 { status = "disabled"; };
+  dc@54200000 {
+   status = "okay";
+   clocks = <&tegra_car TEGRA20_CLK_DISP1>, <&tegra_car TEGRA20_CLK_PLL_C>;
+   /* Match the working non-LTE board's 598 MHz parent. */
+   assigned-clocks = <&tegra_car TEGRA20_CLK_PLL_C>;
+   assigned-clock-rates = <598000000>;
+   rgb { status = "okay"; nvidia,panel = <&panel>; };
+  };
+  dc@54240000 { status = "disabled"; };
+  hdmi@54280000 { status = "disabled"; };
+ };
+};
diff --git a/arch/arm/configs/wingray_display_defconfig b/arch/arm/configs/wingray_display_defconfig
new file mode 100644
index 00000000..34352b24
--- /dev/null
+++ b/arch/arm/configs/wingray_display_defconfig
@@ -0,0 +1,93 @@
+CONFIG_LOCALVERSION="-wingray-display"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_EXPERT=y
+CONFIG_KALLSYMS=y
+CONFIG_PRINTK_TIME=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_ARCH_TEGRA=y
+CONFIG_ARCH_TEGRA_2x_SOC=y
