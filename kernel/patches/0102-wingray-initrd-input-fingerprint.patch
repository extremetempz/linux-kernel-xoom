From bed8efa2bdab57ee9bb2e4478641dc66edccc4cf Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sun, 25 Oct 2026 05:39:44 +1100
Subject: [PATCH] ARM: wingray: retain bounded initrd input fingerprint in
 diagnostic 52

---
 .../wingray_gpu_initrd_integrity_defconfig    | 177 ++++++++++++++++++
 arch/arm/mach-tegra/wingray-gputrace.c        |   3 +-
 include/soc/tegra/wingray-smptrace.h          |   3 +-
 init/initramfs.c                              |  43 ++++-
 init/main.c                                   |   3 +-
 5 files changed, 223 insertions(+), 6 deletions(-)
 create mode 100644 arch/arm/configs/wingray_gpu_initrd_integrity_defconfig

diff --git a/arch/arm/configs/wingray_gpu_initrd_integrity_defconfig b/arch/arm/configs/wingray_gpu_initrd_integrity_defconfig
new file mode 100644
index 00000000..85e091c5
--- /dev/null
+++ b/arch/arm/configs/wingray_gpu_initrd_integrity_defconfig
@@ -0,0 +1,177 @@
+CONFIG_LOCALVERSION="-wingray-gpu-trace"
