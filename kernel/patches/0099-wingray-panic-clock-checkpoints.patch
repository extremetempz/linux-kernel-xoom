diff --git a/arch/arm/mach-tegra/wingray-gputrace.c b/arch/arm/mach-tegra/wingray-gputrace.c
index 45172f23..a86f6585 100644
--- a/arch/arm/mach-tegra/wingray-gputrace.c
+++ b/arch/arm/mach-tegra/wingray-gputrace.c
@@ -53,6 +53,22 @@ static struct miscdevice wingray_trace_device = {
 static int wingray_trace_panic(struct notifier_block *nb,
 		unsigned long event, void *data)
 {
+#if CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0050
+	/* panic() supplies its bounded, NUL-terminated formatted buffer.
+	 * Publish the panic flag only after the 20-byte prefix. */
+	const unsigned char *text = data;
+	unsigned int i, j;
+	for (i = 0; i < 5; i++) {
+		u32 word = 0;
+		for (j = 0; j < 4; j++) {
+			if (text && *text) {
+				word |= (u32)*text << (j * 8);
+				text++;
+			}
+		}
+		wingray_gputrace_mark(0x6c + i * 4, word);
+	}
+#endif
 	wingray_gputrace_mark(WG_PANIC, 1);
 	return NOTIFY_DONE;
 }
diff --git a/drivers/staging/tegra/video/host/bus_client.c b/drivers/staging/tegra/video/host/bus_client.c
index 3c1dc963..68aa4119 100644
--- a/drivers/staging/tegra/video/host/bus_client.c
+++ b/drivers/staging/tegra/video/host/bus_client.c
@@ -642,7 +642,8 @@ int nvhost_client_device_init(struct nvhost_device *dev)
 
 	wingray_gputrace_engine(dev->index, 40, 0);
 	err = nvhost_module_init(dev);
-	wingray_gputrace_engine(dev->index, 41, err);
+	if (!err)
+		wingray_gputrace_engine(dev->index, 41, err);
 	if (err)
 		goto fail_channel;
 
diff --git a/drivers/staging/tegra/video/host/nvhost_acm.c b/drivers/staging/tegra/video/host/nvhost_acm.c
index b2a913d6..02c9ed37 100644
--- a/drivers/staging/tegra/video/host/nvhost_acm.c
+++ b/drivers/staging/tegra/video/host/nvhost_acm.c
@@ -686,9 +686,12 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 	dev->emc_idx = 0;
 	/* Resolve and validate the complete list before changing a clock. */
 	for (i = 0; i < NVHOST_MODULE_MAX_CLOCKS && dev->clocks[i].name; i++) {
-		struct clk *c = clk_get(&dev->dev, dev->clocks[i].name);
+		struct clk *c;
+		wingray_gputrace_engine(dev->index, 0x100 + i * 16, 0);
+		c = clk_get(&dev->dev, dev->clocks[i].name);
 		if (IS_ERR(c)) {
 			err = PTR_ERR(c);
+			wingray_gputrace_engine(dev->index, 0x101 + i * 16, err);
 			dev_err(&dev->dev, "Cannot get clock %s: %d\n",
 				dev->clocks[i].name, err);
 			goto fail;
@@ -700,6 +703,7 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 		dev->clk[i] = c;
 		dev->num_clks++;
 		previous[i] = clk_get_rate(c);
+		wingray_gputrace_engine(dev->index, 0x102 + i * 16, previous[i]);
 #ifdef CONFIG_TEGRA_GRHOST_WINGRAY_HOST_TEST
 		/* Diagnostic is host-only: retain the firmware clock/voltage point. */
 		if (dev->index != 10 || i != 0 || strcmp(dev->clocks[i].name, "host1x")) {
@@ -712,8 +716,10 @@ static int nvhost_module_init_clocks(struct nvhost_device *dev)
 #else
 		rates[i] = clk_round_rate(c, dev->clocks[i].default_rate);
 #endif
+		wingray_gputrace_engine(dev->index, 0x103 + i * 16, rates[i]);
 		if (rates[i] <= 0 || !previous[i]) {
 			err = rates[i] < 0 ? (int)rates[i] : -EINVAL;
+			wingray_gputrace_engine(dev->index, (rates[i] <= 0 ? 0x104 : 0x105) + i * 16, err);
 			goto fail;
 		}
 	}
@@ -782,7 +788,8 @@ int nvhost_module_init(struct nvhost_device *dev)
 	INIT_LIST_HEAD(&dev->client_list);
 	wingray_gputrace_engine(dev->index, 41, 0);
 	err = nvhost_module_init_clocks(dev);
-	wingray_gputrace_engine(dev->index, 42, err);
+	if (!err)
+		wingray_gputrace_engine(dev->index, 42, err);
 	if (err)
 		return err;
 
diff --git a/include/soc/tegra/wingray-smptrace.h b/include/soc/tegra/wingray-smptrace.h
index c9560f3b..cb90794d 100644
--- a/include/soc/tegra/wingray-smptrace.h
+++ b/include/soc/tegra/wingray-smptrace.h
@@ -20,7 +20,9 @@ static inline void wingray_smptrace_mark(unsigned int offset, u32 value)
 {
  void __iomem *p = (void __iomem *)WINGRAY_SMPTRACE_VIRT;
  if (!wingray_smptrace_ready || offset < 0x10 ||
-#ifdef CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE
+#if defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE) && CONFIG_MOTOROLA_XOOM_SMP_TRACE_COOKIE == 0x584d0050
+     offset > 0x7c ||
+#elif defined(CONFIG_MOTOROLA_XOOM_GPU_STARTUP_TRACE)
      offset > 0x68 ||
 #else
      offset > 0x28 ||
