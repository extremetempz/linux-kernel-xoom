From 135f41fef92e93d023c9b8eaf832250fd583651d Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Tue, 20 Oct 2026 17:03:36 +1100
Subject: [PATCH] ARM: tegra: add Wingray USB and storage diagnostic profile

---
 .../tegra20-motorola-wingray-diagnostic.dts   | 24 ++++++
 arch/arm/configs/wingray_diagnostic_defconfig | 74 +++++++++++++++++++
 2 files changed, 98 insertions(+)
 create mode 100644 arch/arm/boot/dts/tegra20-motorola-wingray-diagnostic.dts
 create mode 100644 arch/arm/configs/wingray_diagnostic_defconfig

diff --git a/arch/arm/boot/dts/tegra20-motorola-wingray-diagnostic.dts b/arch/arm/boot/dts/tegra20-motorola-wingray-diagnostic.dts
new file mode 100644
index 00000000..7a491da3
--- /dev/null
+++ b/arch/arm/boot/dts/tegra20-motorola-wingray-diagnostic.dts
@@ -0,0 +1,24 @@
+/* USB serial and read-only storage discovery after early-memory bring-up.
+ * No Android filesystem mounts are part of this diagnostic. GPL version 2.
+ */
+#include "tegra20-motorola-wingray-early.dts"
+/ {
+	model = "Motorola Xoom Wi-Fi USB and storage diagnostic";
+	gpio@6000d000 {
+		usb-data-enable {
+			gpio-hog;
+			gpios = <TEGRA_GPIO(V, 4) GPIO_ACTIVE_HIGH>;
+			output-high;
+			line-name = "wingray-usb-data-enable";
+		};
+		usb-forceon-n {
+			gpio-hog;
+			gpios = <TEGRA_GPIO(C, 5) GPIO_ACTIVE_HIGH>;
+			output-high;
+			line-name = "wingray-usb-forceon-n";
+		};
+	};
+	usb@c5000000 { status = "okay"; };
+	usb-phy@c5000000 { status = "okay"; };
+	sdhci@c8000600 { status = "okay"; };
+};
diff --git a/arch/arm/configs/wingray_diagnostic_defconfig b/arch/arm/configs/wingray_diagnostic_defconfig
new file mode 100644
index 00000000..5342fb65
--- /dev/null
+++ b/arch/arm/configs/wingray_diagnostic_defconfig
@@ -0,0 +1,74 @@
+CONFIG_LOCALVERSION="-wingray-diagnostic"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_EXPERT=y
+CONFIG_KALLSYMS=y
+CONFIG_PRINTK_TIME=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_ARCH_TEGRA=y
+CONFIG_ARCH_TEGRA_2x_SOC=y
+# CONFIG_ARCH_TEGRA_3x_SOC is not set
+# CONFIG_ARCH_TEGRA_114_SOC is not set
+# CONFIG_ARCH_TEGRA_124_SOC is not set
+CONFIG_MACH_MOTOROLA_WINGRAY=y
+# CONFIG_MACH_SAMSUNG_VARIATION_TEGRA is not set
+# CONFIG_MACH_SAMSUNG_P4WIFI is not set
+# CONFIG_SMP is not set
+# CONFIG_CACHE_L2X0 is not set
+CONFIG_HIGHMEM=y
+CONFIG_AEABI=y
+CONFIG_VFP=y
+# CONFIG_NEON is not set
+# CONFIG_CPU_FREQ is not set
+# CONFIG_CPU_IDLE is not set
+# CONFIG_SUSPEND is not set
+CONFIG_ARM_APPENDED_DTB=y
+CONFIG_ARM_ATAG_DTB_COMPAT=y
+CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_EXTEND=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE=y
+CONFIG_BUILD_ARM_APPENDED_DTB_IMAGE_NAMES="tegra20-motorola-wingray-diagnostic"
+CONFIG_CMDLINE="console=ttyS0,115200n8 ignore_loglevel loglevel=8 initcall_debug clk_ignore_unused regulator_ignore_unused ro panic=0"
+CONFIG_CMDLINE_EXTEND=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_PROC_FS=y
+CONFIG_SYSFS=y
+CONFIG_TMPFS=y
+CONFIG_BLOCK=y
+CONFIG_PARTITION_ADVANCED=y
+CONFIG_EFI_PARTITION=y
+CONFIG_MOTOROLA_XOOM_BIGPART=y
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_BLOCK_MINORS=32
+CONFIG_MMC_SDHCI=y
+CONFIG_MMC_SDHCI_PLTFM=y
+CONFIG_MMC_SDHCI_TEGRA=y
+CONFIG_EXT4_FS=y
+CONFIG_USB=y
+CONFIG_USB_GADGET=y
+CONFIG_USB_CHIPIDEA=y
+CONFIG_USB_CHIPIDEA_UDC=y
+CONFIG_USB_TEGRA_PHY=y
+CONFIG_USB_G_SERIAL=y
+# CONFIG_NET is not set
+# CONFIG_INPUT is not set
+# CONFIG_VT is not set
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_8250_NR_UARTS=5
+CONFIG_SERIAL_8250_RUNTIME_UARTS=5
+CONFIG_DEBUG_KERNEL=y
+CONFIG_DEBUG_FS=y
+# CONFIG_DEBUG_LL is not set
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_RAM=y
+CONFIG_MOTOROLA_XOOM_BOOT_TRACE=y
+CONFIG_MOTOROLA_XOOM_BOOT_TRACE_PAGE_PROGRESS=y
+CONFIG_MOTOROLA_XOOM_BOOT_TRACE_PAGE_WINDOW=y
+CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE=0x584d000f
