From 361622c8634ca9c8959932a1b5462febf177b51e Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sun, 18 Oct 2026 21:33:38 +1100
Subject: [PATCH] ARM: tegra: add optional Wingray RAM boot-stage
 instrumentation

---
 arch/arm/boot/compressed/head.S            | 39 +++++++++++++++
 arch/arm/configs/wingray_trace_defconfig   | 56 ++++++++++++++++++++++
 arch/arm/include/debug/wingray-boottrace.S | 52 ++++++++++++++++++++
 arch/arm/kernel/head.S                     | 20 +++++++-
 arch/arm/mach-tegra/Kconfig                | 18 +++++++
 arch/arm/mach-tegra/board-wingray.c        | 35 ++++++++++++++
 arch/arm/mach-tegra/tegra.c                |  7 +++
 include/soc/tegra/wingray-boottrace.h      | 26 ++++++++++
 8 files changed, 252 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm/configs/wingray_trace_defconfig
 create mode 100644 arch/arm/include/debug/wingray-boottrace.S
 create mode 100644 include/soc/tegra/wingray-boottrace.h

diff --git a/arch/arm/boot/compressed/head.S b/arch/arm/boot/compressed/head.S
index 1629783e..2270326f 100644
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -11,6 +11,7 @@
 #include <linux/linkage.h>
 #include <asm/assembler.h>
 #include <asm/v7m.h>
+#include <debug/wingray-boottrace.S>
 
  AR_CLASS(	.arch	armv7-a	)
  M_CLASS(	.arch	armv7-m	)
@@ -141,6 +142,14 @@ start:
  THUMB(		.thumb			)
 1:
  ARM_BE8(	setend	be		)	@ go BE8 if compiled for BE8
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+		.global wingray_trace_zentry_begin, wingray_trace_zentry_end
+wingray_trace_zentry_begin:
+#endif
+		wingray_trace_enter
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+wingray_trace_zentry_end:
+#endif
  AR_CLASS(	mrs	r9, cpsr	)
 #ifdef CONFIG_ARM_VIRT_EXT
 		bl	__hyp_stub_install	@ get into SVC mode, reversibly
@@ -176,6 +185,18 @@ not_angel:
 		 */
 
 		.text
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+		ldr ip, =(WINGRAY_TRACE_BASE + WINGRAY_TRACE_SCTLR)
+		mrc p15, 0, r3, c1, c0, 0
+		str r3, [ip]
+		mcr p15, 0, ip, c7, c10, 1
+		ldr ip, =(WINGRAY_TRACE_BASE + WINGRAY_TRACE_CPUID)
+		mrc p15, 0, r3, c0, c0, 0
+		str r3, [ip]
+		mcr p15, 0, ip, c7, c10, 1
+		dsb sy
+#endif
+		wingray_trace_store WINGRAY_TRACE_MODE, 1
 
 #if defined(CONFIG_MACH_MOTOROLA_WINGRAY)
 		/* Xoom's Android boot header loads zImage at 0x10008000,
@@ -343,6 +364,22 @@ restart:	adr	r0, LC0
 		mov	r2, r5
 		bleq	atags_to_fdt
 
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+		.global wingray_trace_atag_begin, wingray_trace_atag_end
+wingray_trace_atag_begin:
+		/* r3/ip are saved on the stack here; r0 is converter status. */
+		ldr ip, =(WINGRAY_TRACE_BASE + WINGRAY_TRACE_ATAG_RC)
+		str r0, [ip]
+		mcr p15, 0, ip, c7, c10, 1
+		ldr ip, =(WINGRAY_TRACE_BASE + WINGRAY_TRACE_FDT)
+		str r6, [ip]
+		mcr p15, 0, ip, c7, c10, 1
+		dsb sy
+#endif
+		wingray_trace_store WINGRAY_TRACE_ATAG, 2
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+wingray_trace_atag_end:
+#endif
 		ldmfd	sp!, {r0-r3, ip, lr}
 		sub	sp, sp, r5
 #endif
@@ -543,11 +580,13 @@ not_relocated:	mov	r0, #0
  *   r7  = architecture ID
  *   r8  = atags pointer
  */
+		wingray_trace_store WINGRAY_TRACE_INFLATE, 3
 		mov	r0, r4
 		mov	r1, sp			@ malloc space above stack
 		add	r2, sp, #0x10000	@ 64k max
 		mov	r3, r7
 		bl	decompress_kernel
+		wingray_trace_store WINGRAY_TRACE_INFLATED, 4
 		bl	cache_clean_flush
 		bl	cache_off
 		mov	r1, r7			@ restore architecture number
