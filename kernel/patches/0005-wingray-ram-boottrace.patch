diff --git a/arch/arm/include/debug/wingray-boottrace.S b/arch/arm/include/debug/wingray-boottrace.S
new file mode 100644
index 00000000..7f780e7f
--- /dev/null
+++ b/arch/arm/include/debug/wingray-boottrace.S
@@ -0,0 +1,52 @@
+/* Optional stack-free physical RAM breadcrumbs. GNU GPL version 2.
+ * Clobbers r3 and ip ONLY; preserves flags and boot arguments.
+ * Call only with MMU off. The first 128 bytes of the reserved lower legacy
+ * console MiB are separate from ramoops at 0x1ff00000. Clean by MVA and DSB
+ * make writes visible before reset; this does not repair bootloader state.
+ */
+#include <soc/tegra/wingray-boottrace.h>
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	.macro wingray_trace_store offset, value
+	ldr ip, =(WINGRAY_TRACE_BASE + \offset)
+	ldr r3, =\value
+	str r3, [ip]
+	mcr p15, 0, ip, c7, c10, 1
+	dsb sy
+	.endm
+
+	.macro wingray_trace_enter
+	ldr ip, =WINGRAY_TRACE_BASE
+	mov r3, #0
+	.irp offset,0,4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64,68,72,76,80,84,88,92,96,100,104,108,112,116,120,124
+	str r3, [ip, #\offset]
+	.endr
+	str r0, [ip, #WINGRAY_TRACE_R0]
+	str r1, [ip, #WINGRAY_TRACE_R1]
+	str r2, [ip, #WINGRAY_TRACE_R2]
+	mov r3, pc
+	str r3, [ip, #WINGRAY_TRACE_ENTRY_PC]
+	mrs r3, cpsr
+	str r3, [ip, #WINGRAY_TRACE_CPSR]
+	mov r3, #WINGRAY_TRACE_VERSION
+	str r3, [ip, #4]
+	ldr r3, =CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE
+	str r3, [ip, #WINGRAY_TRACE_COOKIE]
+	ldr r3, =0xdeadffff
+	str r3, [ip, #WINGRAY_TRACE_ATAG_RC]
+	ldr r3, =WINGRAY_TRACE_MAGIC
+	str r3, [ip]
+	mcr p15, 0, ip, c7, c10, 1
+	add ip, ip, #32
+	mcr p15, 0, ip, c7, c10, 1
+	add ip, ip, #32
+	mcr p15, 0, ip, c7, c10, 1
+	add ip, ip, #32
+	mcr p15, 0, ip, c7, c10, 1
+	dsb sy
+	.endm
+#else
+	.macro wingray_trace_store offset, value
+	.endm
+	.macro wingray_trace_enter
+	.endm
+#endif
diff --git a/arch/arm/kernel/head.S b/arch/arm/kernel/head.S
index 04286fd9..cf680a27 100644
--- a/arch/arm/kernel/head.S
+++ b/arch/arm/kernel/head.S
@@ -22,6 +22,7 @@
 #include <asm/memory.h>
 #include <asm/thread_info.h>
 #include <asm/pgtable.h>
+#include <debug/wingray-boottrace.S>
 
 #if defined(CONFIG_DEBUG_LL) && !defined(CONFIG_DEBUG_SEMIHOSTING)
 #include CONFIG_DEBUG_LL_INCLUDE
@@ -78,6 +79,14 @@
 
 	__HEAD
 ENTRY(stext)
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	.global wingray_trace_stext_begin, wingray_trace_stext_end
+wingray_trace_stext_begin:
+#endif
+	wingray_trace_store WINGRAY_TRACE_STEXT, 5
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+wingray_trace_stext_end:
+#endif
  ARM_BE8(setend	be )			@ ensure we are in BE8 mode
 
  THUMB(	badr	r9, 1f		)	@ Kernel is always entered in ARM.
@@ -158,7 +167,16 @@ ENTRY(stext)
 	ldr	r12, [r10, #PROCINFO_INITFUNC]
 	add	r12, r12, r10
 	ret	r12
-1:	b	__enable_mmu
+1:
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	.global wingray_trace_mmu_begin, wingray_trace_mmu_end
+wingray_trace_mmu_begin:
+#endif
+	wingray_trace_store WINGRAY_TRACE_MMU, 6
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+wingray_trace_mmu_end:
+#endif
+	b	__enable_mmu
 ENDPROC(stext)
 	.ltorg
 #ifndef CONFIG_XIP_KERNEL
diff --git a/arch/arm/mach-tegra/Kconfig b/arch/arm/mach-tegra/Kconfig
index c193264a..653fe6de 100644
--- a/arch/arm/mach-tegra/Kconfig
+++ b/arch/arm/mach-tegra/Kconfig
@@ -70,6 +70,24 @@ config MACH_MOTOROLA_WINGRAY
 	  Experimental device-tree support for the Wi-Fi Xoom. Power,
 	  display and suspend support still require hardware validation.
 
+config MOTOROLA_XOOM_BOOT_TRACE
+	bool "Experimental Wingray early RAM breadcrumbs"
+	depends on MACH_MOTOROLA_WINGRAY && !SMP && !THUMB2_KERNEL
+	default n
+	help
+	  Instrument the decompressor and pre-MMU kernel entry without UART.
+	  Writes the first 128 bytes at physical 0x1fe00000 in the already
+	  reserved legacy console region. Verify ownership and readback before
+	  any hardware test. Never enable for an ordinary ROM build.
+
+config MOTOROLA_XOOM_BOOT_TRACE_COOKIE
+	hex "Wingray trace build identifier"
+	depends on MOTOROLA_XOOM_BOOT_TRACE
+	default 0x584d0001
+	help
+	  Choose a different value for every candidate build. This identifies
+	  a build, not a unique boot attempt. A stale record must be excluded.
+
 config MACH_SAMSUNG_VARIATION_TEGRA
        bool "Samsung variations based on Tegra 2"
        help
diff --git a/arch/arm/mach-tegra/board-wingray.c b/arch/arm/mach-tegra/board-wingray.c
index 86896d96..715505c4 100644
--- a/arch/arm/mach-tegra/board-wingray.c
+++ b/arch/arm/mach-tegra/board-wingray.c
@@ -49,3 +49,38 @@ void __init wingray_reserve(void)
 	    memblock_reserve(wingray_lp0_start, wingray_lp0_size))
 		panic("Wingray: cannot preserve bootloader LP0 vector");
 }
+
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+#include <linux/io.h>
+#include <linux/of.h>
+#include <soc/tegra/wingray-boottrace.h>
+
+static void __init wingray_boottrace_mark(unsigned int offset, u32 value)
+{
+	void __iomem *trace;
+
+	if (!of_machine_is_compatible("motorola,wingray"))
+		return;
+	trace = ioremap_nocache(WINGRAY_TRACE_BASE, WINGRAY_TRACE_SIZE);
+	if (!trace)
+		return;
+	if (readl(trace) == WINGRAY_TRACE_MAGIC &&
+	    readl(trace + WINGRAY_TRACE_COOKIE) == CONFIG_MOTOROLA_XOOM_BOOT_TRACE_COOKIE)
+		writel(value, trace + offset);
+	readl(trace + offset); /* drain posted write */
+	iounmap(trace);
+}
+
+void __init wingray_boottrace_c_early(void)
+{
+	wingray_boottrace_mark(WINGRAY_TRACE_C_EARLY, 7);
+}
+
+static int __init wingray_boottrace_initcall(void)
+{
+	wingray_boottrace_mark(WINGRAY_TRACE_INITCALL, 8);
+	pr_info("Wingray boot trace reached early initcall\n");
+	return 0;
+}
+early_initcall(wingray_boottrace_initcall);
+#endif
diff --git a/arch/arm/mach-tegra/tegra.c b/arch/arm/mach-tegra/tegra.c
index b222a483..70ffcacf 100644
--- a/arch/arm/mach-tegra/tegra.c
+++ b/arch/arm/mach-tegra/tegra.c
@@ -71,8 +71,15 @@ u32 tegra_uart_config[3] = {
 	0,
 };
 
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+void __init wingray_boottrace_c_early(void);
+#endif
+
 static void __init tegra_init_early(void)
 {
+#ifdef CONFIG_MOTOROLA_XOOM_BOOT_TRACE
+	wingray_boottrace_c_early();
+#endif
 	of_register_trusted_foundations();
 	tegra_cpu_reset_handler_init();
 	tegra_flowctrl_init();
diff --git a/include/soc/tegra/wingray-boottrace.h b/include/soc/tegra/wingray-boottrace.h
new file mode 100644
index 00000000..9e731dce
--- /dev/null
+++ b/include/soc/tegra/wingray-boottrace.h
@@ -0,0 +1,26 @@
+/* Optional Wingray RAM boot trace. GNU GPL version 2. */
+#ifndef __WINGRAY_BOOTTRACE_H
+#define __WINGRAY_BOOTTRACE_H
+#define WINGRAY_TRACE_BASE       0x1fe00000
+#define WINGRAY_TRACE_MAGIC      0x584f4f4d
+#define WINGRAY_TRACE_VERSION    1
+#define WINGRAY_TRACE_SIZE       0x80
+#define WINGRAY_TRACE_COOKIE     0x08
+#define WINGRAY_TRACE_ENTRY_PC   0x0c
+#define WINGRAY_TRACE_R0         0x10
+#define WINGRAY_TRACE_R1         0x14
+#define WINGRAY_TRACE_R2         0x18
+#define WINGRAY_TRACE_CPSR       0x1c
+#define WINGRAY_TRACE_SCTLR      0x20
+#define WINGRAY_TRACE_CPUID      0x24
+#define WINGRAY_TRACE_MODE       0x28
+#define WINGRAY_TRACE_ATAG_RC    0x2c
+#define WINGRAY_TRACE_FDT        0x30
+#define WINGRAY_TRACE_ATAG       0x34
+#define WINGRAY_TRACE_INFLATE    0x38
+#define WINGRAY_TRACE_INFLATED   0x3c
+#define WINGRAY_TRACE_STEXT      0x40
+#define WINGRAY_TRACE_MMU        0x44
+#define WINGRAY_TRACE_C_EARLY    0x48
+#define WINGRAY_TRACE_INITCALL   0x4c
+#endif
-- 
