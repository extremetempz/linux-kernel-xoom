From 435844ceac6e6466495664a7052ad974b564a64f Mon Sep 17 00:00:00 2001
From: JUstin <justinscollo@protonmail.com>
Date: Sun, 25 Oct 2026 16:48:34 +1100
Subject: [PATCH] bcmdhd-legacy: pass skb_mac_header pointer on 4.4

Linux 4.4 stores mac_header as a u16 offset; the 2.6 driver passed it to
dhd_wl_host_event as if it were a pointer.  Use skb_mac_header() so
firmware events (scan, association and link events) are parsed safely.
---
 drivers/net/wireless/bcmdhd-legacy/dhd_linux.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/bcmdhd-legacy/dhd_linux.c b/drivers/net/wireless/bcmdhd-legacy/dhd_linux.c
index 44b1066a..8e341677 100644
--- a/drivers/net/wireless/bcmdhd-legacy/dhd_linux.c
+++ b/drivers/net/wireless/bcmdhd-legacy/dhd_linux.c
@@ -1523,12 +1523,8 @@ dhd_rx_frame(dhd_pub_t *dhdp, int ifidx, void *pktbuf, int numpkt, uint8 chan)
 
 		/* Process special event packets and then discard them */
 		if (ntoh16(skb->protocol) == ETHER_TYPE_BRCM) {
-			dhd_wl_host_event(dhd, &ifidx,
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 22)
-			skb->mac_header,
-#else
-			skb->mac.raw,
-#endif
+			/* 4.4 skb->mac_header is an offset, not a pointer. */
+			dhd_wl_host_event(dhd, &ifidx, skb_mac_header(skb),
 			&event,
 			&data);
 
-- 
