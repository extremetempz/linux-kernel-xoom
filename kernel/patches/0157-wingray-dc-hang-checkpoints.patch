diff --git a/drivers/staging/tegra/video/dc/dc.c b/drivers/staging/tegra/video/dc/dc.c
index 2522ac71..53920401 100644
--- a/drivers/staging/tegra/video/dc/dc.c
+++ b/drivers/staging/tegra/video/dc/dc.c
@@ -62,6 +62,7 @@
 #include "dc_reg.h"
 #include "dc_config.h"
 #include "dc_priv.h"
+#include "wingray_trace.h"
 #include "overlay.h"
 #include "nvsd.h"
 
@@ -1518,28 +1519,42 @@ static bool _tegra_dc_controller_enable(struct tegra_dc *dc, bool no_reset)
 
 	if (dc->out->enable)
 		dc->out->enable();
+	wingray_dc_checkpoint(dc, "panel.enable.begin", 0);
 	panel_result = tegra_dc_panel_enable_common(dc);
+	wingray_dc_checkpoint(dc, "panel.enable.end", panel_result);
 	if (panel_result < 0)
 		return false;
 	if (panel_result)
 		msleep(dc->out->lvds_to_bl_timeout);
 
+	wingray_dc_checkpoint(dc, "clock.setup.begin", 0);
 	tegra_dc_setup_clk(dc, dc->clk);
+	wingray_dc_checkpoint(dc, "clock.setup.end", 0);
+	wingray_dc_checkpoint(dc, "clock.enable.begin", 0);
 	tegra_dc_clk_enable(dc);
+	wingray_dc_checkpoint(dc, "clock.enable.end", 0);
 
 	/* Only the existing Samsung handoff path may skip reset assertion. */
 	if (!IS_ENABLED(CONFIG_MACH_SAMSUNG_VARIATION_TEGRA) || !no_reset) {
 		reset_control_assert(dc->ndev->rst);
 		usleep_range(1000, 2000);
 	}
+	wingray_dc_checkpoint(dc, "reset.deassert.begin", 0);
 	reset_control_deassert(dc->ndev->rst);
+	wingray_dc_checkpoint(dc, "reset.deassert.end", 0);
 
 	/* do not accept interrupts during initialization */
+	wingray_dc_checkpoint(dc, "enable.irq.mask.begin", 0);
 	tegra_dc_writel(dc, 0, DC_CMD_INT_MASK);
+	wingray_dc_checkpoint(dc, "enable.irq.mask.end", 0);
 
+	wingray_dc_checkpoint(dc, "enable.irq.begin", 0);
 	enable_dc_irq(dc->irq);
+	wingray_dc_checkpoint(dc, "enable.irq.end", dc->irq);
 
+	wingray_dc_checkpoint(dc, "controller.init.begin", 0);
 	failed_init = tegra_dc_init(dc);
+	wingray_dc_checkpoint(dc, "controller.init.end", failed_init);
 	if (failed_init) {
 		tegra_dc_writel(dc, 0, DC_CMD_INT_MASK);
 		disable_dc_irq(dc->irq);
@@ -1551,8 +1566,10 @@ static bool _tegra_dc_controller_enable(struct tegra_dc *dc, bool no_reset)
 		return false;
 	}
 
+	wingray_dc_checkpoint(dc, "rgb.enable.begin", 0);
 	if (dc->out_ops && dc->out_ops->enable)
 		dc->out_ops->enable(dc);
+	wingray_dc_checkpoint(dc, "rgb.enable.end", 0);
 
 	/* force a full blending update */
 	dc->blend.z[0] = -1;
@@ -1561,8 +1578,10 @@ static bool _tegra_dc_controller_enable(struct tegra_dc *dc, bool no_reset)
 
 	trace_printk("%s:enable\n", dc->ndev->name);
 
+	wingray_dc_checkpoint(dc, "controller.activate.begin", 0);
 	tegra_dc_writel(dc, GENERAL_UPDATE, DC_CMD_STATE_CONTROL);
 	tegra_dc_writel(dc, GENERAL_ACT_REQ, DC_CMD_STATE_CONTROL);
+	wingray_dc_checkpoint(dc, "controller.activate.end", 0);
 
 	if (dc->out->postpoweron)
 		dc->out->postpoweron();
@@ -1686,7 +1705,9 @@ static bool _tegra_dc_enable(struct tegra_dc *dc)
 	if (!dc->out)
 		return false;
 
+	wingray_dc_checkpoint(dc, "host.busy.begin", 0);
 	tegra_dc_io_start(dc);
+	wingray_dc_checkpoint(dc, "host.busy.end", 0);
 
 	if (!_tegra_dc_controller_enable(dc, false)) {
 		tegra_dc_io_end(dc);
@@ -1697,14 +1718,20 @@ static bool _tegra_dc_enable(struct tegra_dc *dc)
 
 void tegra_dc_enable(struct tegra_dc *dc)
 {
+	wingray_dc_checkpoint(dc, "enable.cancel.begin", 0);
 	cancel_delayed_work_sync(&dc->disable_work);
+	wingray_dc_checkpoint(dc, "enable.cancel.end", 0);
 
+	wingray_dc_checkpoint(dc, "enable.lock.begin", 0);
 	mutex_lock(&dc->lock);
+	wingray_dc_checkpoint(dc, "enable.lock.end", 0);
 
 	if (!dc->enabled)
 		dc->enabled = _tegra_dc_enable(dc);
 
+	wingray_dc_checkpoint(dc, "enable.unlock.begin", 0);
 	mutex_unlock(&dc->lock);
+	wingray_dc_checkpoint(dc, "enable.unlock.end", dc->enabled);
 	print_mode_info(dc, dc->mode);
 }
 
@@ -1715,19 +1742,31 @@ static void _tegra_dc_controller_disable(struct tegra_dc *dc)
 	if (dc->out && dc->out->prepoweroff)
 		dc->out->prepoweroff();
 
+	wingray_dc_checkpoint(dc, "rgb.disable.begin", 0);
 	if (dc->out_ops && dc->out_ops->disable)
 		dc->out_ops->disable(dc);
+	wingray_dc_checkpoint(dc, "rgb.disable.end", 0);
 
+	wingray_dc_checkpoint(dc, "disable.irq.mask.begin", 0);
 	tegra_dc_writel(dc, 0, DC_CMD_INT_MASK);
 	tegra_dc_writel(dc, 0, DC_CMD_INT_ENABLE);
+	wingray_dc_checkpoint(dc, "disable.irq.mask.end", 0);
+	wingray_dc_checkpoint(dc, "disable.irq.begin", 0);
 	disable_irq(dc->irq);
+	wingray_dc_checkpoint(dc, "disable.irq.end", dc->irq);
 
+	wingray_dc_checkpoint(dc, "bandwidth.clear.begin", 0);
 	tegra_dc_clear_bandwidth(dc);
+	wingray_dc_checkpoint(dc, "bandwidth.clear.end", 0);
+	wingray_dc_checkpoint(dc, "clock.disable.begin", 0);
 	tegra_dc_clk_disable(dc);
+	wingray_dc_checkpoint(dc, "clock.disable.end", 0);
 
 	if (dc->out && dc->out->disable)
 		dc->out->disable();
+	wingray_dc_checkpoint(dc, "panel.disable.begin", 0);
 	tegra_dc_panel_disable_common(dc);
+	wingray_dc_checkpoint(dc, "panel.disable.end", 0);
 
 	for (i = 0; i < dc->n_windows; i++) {
 		struct tegra_dc_win *w = &dc->windows[i];
@@ -1739,6 +1778,7 @@ static void _tegra_dc_controller_disable(struct tegra_dc *dc)
 		/* disable windows */
 		w->flags &= ~TEGRA_WIN_FLAG_ENABLED;
 
+		wingray_dc_checkpoint(dc, "syncpt.flush.begin", i);
 		/* flush any pending syncpt waits */
 		while (dc->syncpt[i].min < dc->syncpt[i].max) {
 			trace_printk("%s:syncpt flush id=%d\n", dc->ndev->name,
@@ -1746,6 +1786,7 @@ static void _tegra_dc_controller_disable(struct tegra_dc *dc)
 			dc->syncpt[i].min++;
 			nvhost_syncpt_cpu_incr_ext(dc->ndev, dc->syncpt[i].id);
 		}
+		wingray_dc_checkpoint(dc, "syncpt.flush.end", i);
 	}
 	trace_printk("%s:disabled\n", dc->ndev->name);
 }
@@ -1805,12 +1846,20 @@ static void _tegra_dc_disable(struct tegra_dc *dc)
 		cancel_delayed_work_sync(&dc->one_shot_work);
 	}
 
+	wingray_dc_checkpoint(dc, "disable.hold.begin", 0);
 	tegra_dc_hold_dc_out(dc);
+	wingray_dc_checkpoint(dc, "disable.hold.end", 0);
 
+	wingray_dc_checkpoint(dc, "controller.disable.begin", 0);
 	_tegra_dc_controller_disable(dc);
+	wingray_dc_checkpoint(dc, "controller.disable.end", 0);
+	wingray_dc_checkpoint(dc, "host.idle.begin", 0);
 	tegra_dc_io_end(dc);
+	wingray_dc_checkpoint(dc, "host.idle.end", 0);
 
+	wingray_dc_checkpoint(dc, "disable.release.begin", 0);
 	tegra_dc_release_dc_out(dc);
+	wingray_dc_checkpoint(dc, "disable.release.end", 0);
 
 	if (dc->out->flags & TEGRA_DC_OUT_ONE_SHOT_MODE)
 		mutex_unlock(&dc->one_shot_lock);
@@ -1821,9 +1870,13 @@ void tegra_dc_disable(struct tegra_dc *dc)
 	if (dc->overlay)
 		tegra_overlay_disable(dc->overlay);
 
+	wingray_dc_checkpoint(dc, "disable.extensions.begin", 0);
 	tegra_dc_ext_disable(dc->ext);
+	wingray_dc_checkpoint(dc, "disable.extensions.end", 0);
 
+	wingray_dc_checkpoint(dc, "disable.lock.begin", 0);
 	mutex_lock(&dc->lock);
+	wingray_dc_checkpoint(dc, "disable.lock.end", 0);
 
 	if (dc->enabled) {
 		dc->enabled = false;
@@ -1834,7 +1887,9 @@ void tegra_dc_disable(struct tegra_dc *dc)
 	switch_set_state(&dc->modeset_switch, 0);
 #endif
 
+	wingray_dc_checkpoint(dc, "disable.unlock.begin", 0);
 	mutex_unlock(&dc->lock);
+	wingray_dc_checkpoint(dc, "disable.unlock.end", 0);
 	print_mode_info(dc, dc->mode);
 }
 
diff --git a/drivers/staging/tegra/video/dc/wingray_trace.h b/drivers/staging/tegra/video/dc/wingray_trace.h
new file mode 100644
index 00000000..14d51b2e
--- /dev/null
+++ b/drivers/staging/tegra/video/dc/wingray_trace.h
@@ -0,0 +1,22 @@
+/* Opt-in process-context DC progress only. SPDX-License-Identifier: GPL-2.0 */
+#ifndef TEGRA_WINGRAY_DC_TRACE_H
+#define TEGRA_WINGRAY_DC_TRACE_H
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_TRACE_TEST
+#include <linux/of.h>
+#include <linux/sched.h>
+#include <linux/interrupt.h>
+static inline void wingray_dc_checkpoint(struct tegra_dc *dc,
+		const char *phase, int value)
+{
+	/* Never sample registers or clock providers here, particularly after
+	 * DC shutdown. No polling, spinlocks, new mappings or IRQ-path logging.
+	 * The existing console/ramoops path supplies retained ECC protection. */
+	if (in_interrupt() || !of_machine_is_compatible("motorola,wingray"))
+		return;
+	pr_info("WG_DC85 %s pid=%d enabled=%u value=%d\n", phase,
+		task_pid_nr(current), READ_ONCE(dc->enabled), value);
+}
+#else
+#define wingray_dc_checkpoint(dc, phase, value) do { } while (0)
+#endif
+#endif
diff --git a/drivers/staging/tegra/video/fb.c b/drivers/staging/tegra/video/fb.c
index 69da8a88..3a3fe643 100644
--- a/drivers/staging/tegra/video/fb.c
+++ b/drivers/staging/tegra/video/fb.c
@@ -46,6 +46,7 @@
 #include "host/dev.h"
 #include "nvmap/nvmap.h"
 #include "dc/dc_priv.h"
+#include "dc/wingray_trace.h"
 
 /* Pad pitch to 16-byte boundary. */
 #define TEGRA_LINEAR_PITCH_ALIGNMENT 32
@@ -69,12 +70,54 @@ struct tegra_fb_info {
 #ifdef CONFIG_FB_TEGRA_WINGRAY_DC_RESUME_TEST
 	bool dc_blanked;
 	u32 dc_saved_flags[DC_N_WINDOWS];
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_TRACE_TEST
+	bool dc_trace_armed;
+#endif
 #endif
 #endif
 };
 
 #include "fb_legacy.h"
 
+#ifdef CONFIG_FB_TEGRA_WINGRAY_DC_TRACE_TEST
+static ssize_t wingray_dc_test_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct fb_info *info = dev_get_drvdata(dev);
+	struct tegra_fb_info *fb = info->par;
+	return scnprintf(buf, PAGE_SIZE, "%u\n", READ_ONCE(fb->dc_trace_armed));
+}
+
+static ssize_t wingray_dc_test_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
