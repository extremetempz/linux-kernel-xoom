diff --git a/drivers/cpufreq/tegra20-cpufreq.c b/drivers/cpufreq/tegra20-cpufreq.c
index 99959f43..bd31c95f 100644
--- a/drivers/cpufreq/tegra20-cpufreq.c
+++ b/drivers/cpufreq/tegra20-cpufreq.c
@@ -103,9 +103,12 @@ static int tegra_target(struct cpufreq_policy *policy, unsigned int index)
 	int ret = 0, parent_ret;
 
 	/*
-	 * Vote on memory bus frequency based on cpu frequency
-	 * This sets the minimum frequency, display or avp may request higher
+	 * Vote on memory bus frequency based on cpu frequency.
+	 * The Wingray GPU diagnostic owns the fixed EMC votes; changing EMC
+	 * here would invalidate its clock contract. CPU/PLLX frequency remains
+	 * independent, so skip only the EMC vote in that configuration.
 	 */
+#ifndef CONFIG_TEGRA_GRHOST_WINGRAY_GPU_TEST
 	if (rate >= 816000)
 		clk_set_rate(emc_clk, 600000000); /* cpu 816 MHz, emc max */
 	else if (rate >= 608000)
@@ -114,6 +117,7 @@ static int tegra_target(struct cpufreq_policy *policy, unsigned int index)
 		clk_set_rate(emc_clk, 150000000); /* cpu 456 MHz, emc 75Mhz */
 	else
 		clk_set_rate(emc_clk, 100000000);  /* emc 50Mhz */
+#endif
 
 	/*
 	 * target freq == pll_p, don't need to take extra reference to pll_x_clk
